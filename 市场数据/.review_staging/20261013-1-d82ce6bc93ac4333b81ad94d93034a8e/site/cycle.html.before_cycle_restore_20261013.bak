idth="21.3" height="76.7" rx="1.5" fill="#4a5666"></rect><text x="599.5" y="92" font-size="8" fill="#6b7683" text-anchor="middle">52</text><rect x="629.8" y="123.3" width="21.3" height="48.7" rx="1.5" fill="#4a5666"></rect><text x="640.5" y="120" font-size="8" fill="#6b7683" text-anchor="middle">33</text><rect x="670.8" y="87.9" width="21.3" height="84.1" rx="1.5" fill="#4a5666"></rect><text x="681.5" y="85" font-size="8" fill="#6b7683" text-anchor="middle">57</text><rect x="711.8" y="95.3" width="21.3" height="76.7" rx="1.5" fill="#4a5666"></rect><text x="722.5" y="92" font-size="8" fill="#6b7683" text-anchor="middle">52</text><rect x="752.8" y="70.2" width="21.3" height="101.8" rx="1.5" fill="#4a5666"></rect><text x="763.5" y="67" font-size="8" fill="#6b7683" text-anchor="middle">69</text><rect x="793.8" y="104.1" width="21.3" height="67.9" rx="1.5" fill="#4a5666"></rect><text x="804.5" y="101" font-size="8" fill="#6b7683" text-anchor="middle">46</text><rect x="834.8" y="73.1" width="21.3" height="98.9" rx="1.5" fill="#7d5a63"></rect><text x="845.5" y="70" font-size="8" fill="#6b7683" text-anchor="middle">67</text><polyline points="66.5,118.5 107.5,140.6 148.5,142.4 189.5,136.6 230.5,93.9 271.5,128.4 312.5,172.0 353.5,119.1 394.5,138.6 435.5,84.0 476.5,39.8 517.5,154.3 558.5,101.7 599.5,101.7 640.5,145.6 681.5,119.1 722.5,119.1 763.5,101.7 804.5,92.7 845.5,127.8" fill="none" stroke="#d9a441" stroke-width="1.8"></polyline><circle cx="66.5" cy="118.5" r="3" fill="#d9a441"></circle><circle cx="107.5" cy="140.6" r="3" fill="#d9a441"></circle><circle cx="148.5" cy="142.4" r="3" fill="#d9a441"></circle><circle cx="189.5" cy="136.6" r="3" fill="#d9a441"></circle><circle cx="230.5" cy="93.9" r="3" fill="#d9a441"></circle><circle cx="271.5" cy="128.4" r="3" fill="#d9a441"></circle><circle cx="312.5" cy="172.0" r="3" fill="#d9a441"></circle><circle cx="353.5" cy="119.1" r="3" fill="#d9a441"></circle><circle cx="394.5" cy="138.6" r="3" fill="#d9a441"></circle><circle cx="435