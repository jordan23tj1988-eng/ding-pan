h="24.3" height="33.5" fill="#2e6f5e"></rect><rect x="849.6" y="225.3" width="24.3" height="7.2" fill="#7c5cbf"></rect><rect x="849.6" y="64.7" width="24.3" height="160.5" fill="#c0392b"></rect><text x="862" y="279" text-anchor="middle" font-size="9" fill="#8a8272">10/29</text><circle cx="862" cy="288" r="3" fill="#c0392b"></circle><rect x="893.8" y="225.3" width="24.3" height="40.7" fill="#2e6f5e"></rect><rect x="893.8" y="209.7" width="24.3" height="15.6" fill="#7c5cbf"></rect><rect x="893.8" y="26.4" width="24.3" height="183.3" fill="#c0392b"></rect><text x="906" y="279" text-anchor="middle" font-size="9" fill="#8a8272">10/30</text><circle cx="906" cy="288" r="3" fill="#c0392b"></circle><polyline points="66.1,111.2 110.3,110.7 154.5,123.6 198.7,23.1 242.9,100.2 287.1,122.4 331.3,115.5 375.5,132.9 419.7,114.8 463.9,18.0 508.1,142.1 552.3,106.8 596.5,132.1 640.7,145.3 684.9,50.7 729.1,87.3 773.3,133.6 817.5,89.4 861.7,60.9 905.9,53.6" fill="none" stroke="#1f2430" stroke-width="2" stroke-dasharray="4 3"></polyline><text x="932" y="270" text-anchor="end" font-size="10" fill="#1f2430">0亿</text><text x="932" y="146" text-anchor="end" font-size="10" fill="#1f2430">51亿</text><text x="932" y="22" text-anchor="end" font-size="10" fill="#1f2430">102亿</text></svg></div><div class="card"><table style="table-layout:fixed;width:100%"><colgroup><col style="width:52px"><col><col><col><col><col style="width:70px"><col style="width:46px"></colgroup><tr><th>日</th><th>机构</th><th>量化</th><th>游资(活跃+知名)</th><th>北向</th><th>总额</th><th>温度</th></tr><tr><td style="white-space:nowrap">10-30</td><td>34<span class="mut">/11.5亿</span></td><td>13<span class="mut">/9.0亿</span></td><td>153<span class="mut">/32.8亿</span></td><td>32<span class="mut">/27.3亿</span></td><td><b>87.1亿</b></td><td><b>70</b></td></tr><tr><td style="white-space:nowrap">10-29</td><td>28<span class="mut">/12.0亿</span></td><td>6<span class="mut">/2.8亿</span></td><td>134<span class="mut">/32.9亿</span></td><td>26<span class="mut">/31.5亿</span></td><td><b>84.1亿</b></td><td><b>67</b></td></tr><tr><td style="white-space:nowrap">10-28</td><td>29<span class="mut">/6.4亿</span></td><td>8<span class="mut">/5.1亿</span></td><td>170<span class="mut">/35.8亿</span></td><td>32<span class="mut">/20.5亿</span></td><td><b>72.4亿</b></td><td><b>48</b></td></tr><tr><td style="white-space:nowrap">10-27</td><td>21<span class="mut">/4.5亿</span></td><td>8<span class="mut">/4.3亿</span></td><td>148<span class="mut">/27.6亿</span></td><td>19<span class="mut">/11.9亿</span></td><td><b>54.3亿</b></td><td><b>7</b></td></tr><tr><td style="white-space:nowrap">10-26</td><td>27<span class="mut">/9.1亿</span></td><td>8<span class="mut">/3.9亿</span></td><td>145<span class="mut">/32.0亿</span></td><td>27<span class="mut">/19.9亿</span></td><td><b>73.3亿</b></td><td><b>47</b></td></tr></table></div>
<!--/FUNDTEMP--></div><div class="card"><div class="" id="claim-lhb-0d2ea1cf03f965fd"><div class="claim-head"><span class="claim-role role-verdict">结论</span><span class="claim-source">判断 · 结论</span></div><p class="mut">判断 · 结论</p><p>B 档（置信 62）：席位侧的钱回来了，但不是来进攻的——当日榜票级净买由昨日 −16.21 亿翻为 +14.70 亿、44/72 只转正、涨停∩榜由 12 只升至 16 只，可 S 档只有 1 席有效出手（000995 皇台酒业 +0.1391 亿，另 2 笔为退市/近零），A 档在 5 只涨停票上合计仅 0.7621 亿，钱主要落在白酒/医疗服务/医疗器械三类防守线（行业净买强度 176.87/85.70/47.55bp），而跌停 82 只（昨 41）翻倍、市场温度 15.2 仍冰点；故本路今日只承接 1 只 S 档在场且净买占比落 10-20% 正格的 000995 皇台酒业 5% 试探仓，601083（打折 3.25×）与 301520（结构四桶全正格但零 S/A）只观察不买。</p></div><div class="" id="claim-lhb-20a116dc17ad37ed"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">判断 · 证据</span></div><p class="mut">判断 · 证据</p><p>①【盘面底色·冰点第二日但两端背离】市场温度（涨停质量口径）15.2，昨 11.0，仍在冰点层 &lt;25；涨停 47 只（昨 39，剔 ST）、最高连板 5 板（001219 青岛食品）、二板加 9 只、一进二率 20.7%、炸板率 39.7%、炸板后回封 21 只、题材线 15 条；但跌停 82 只（昨 41，翻倍）、两市成交 16745 亿（昨 15565 亿，放量 1180 亿／+7.58%）、封板总额仅 31.5 亿。读法：涨停端在修复（39→47）、跌停端在扩散（41→82），『修复』不能整体读，必须两端分开。</p></div><div class="" id="claim-lhb-624c797f374f3bfb"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">判断 · 证据</span></div><p class="mut">判断 · 证据</p><p>②【席位侧买盘翻正·但偏移仍是买榜天然】_学习/_席位动向/20261030.csv 剔区间累计榜 + 剔投资者类别汇总行 + (代码,席位)去重后 = 307 笔 / 73 码；席位净额合计 +65.15 亿，而 lhb.csv 当日榜（禁累加多榜）72 码票级净买合计仅 +14.70 亿、44 正 28 负 ⇒ 真实率 22.6%，即席位买榜把净买放大了 4.4 倍（昨日同口径 −16.21 / +39.62 = −40.9%）。结论：翻正只能证明卖压减弱，不能证明进攻。</p></div><div class="" id="claim-lhb-091ef191af5b18b0"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">判断 · 证据</span></div><p class="mut">判断 · 证据</p><p>③【S/A 动向·本路最强档仍未回流】按 _学习/_席位分档.json（窗口 20260401~20261029、19770 笔、467 席、档分布 S16/A45/B144/C89/P173、基准执1 48.7%/+0.64%、收缩 K=10）判档：当日榜去重 307 笔中 S 3 笔、A 16 笔，S/A 合计 19 笔（其中 3 笔为可转债 118027 宏图转债 / 118058 微导转债 / 123267 珂玛转债，落在股票上的 16 笔）/ 10 席 / 16 个标的 / 净买 4.775 亿；其中 S 档 3 笔里 000995 皇台酒业 +0.1391 亿（唯一有效）、002731 萃华退 +0.0023 亿、301569 联亚药业 −0.0089 亿 ⇒ S 档连续第二日实质休眠。落在涨停票上的 S/A 仅 5 只 / 5 笔 / 0.7621 亿：002086 东方海洋（A 0.2357 亿，票级净买 −0.6232 亿）、601083 锦江航运（A 0.2028 亿）、000995（S 0.1391 亿）、603703 盛洋科技（A 日榜 0.1187 亿）、603131 上海沪工（A 0.0657 亿）。今日亮相 307 席档分布：B197/A16/C19/S3/P9/未收录 63。</p></div><div class="" id="claim-lhb-0277121a1cc73a7b"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">判断 · 证据</span></div><p class="mut">判断 · 证据</p><p>④【资金风格四分类·两种口径分开列，不可相减】净额口径（席位动向当日榜去重）：机构专用 35 席净 +4.03 亿、股通 32 席净 +10.10 亿、营业部/其他 240 席净 +51.03 亿（占 78.3%）。买入额口径（_学习/_资金温度.json#20261030，官方）：机构 34 席 11.5 亿、量化 13 席 9.0 亿、知名游资 153 席 32.8 亿、北向 32 席 27.3 亿、营业部 52 席 6.5 亿，总额 87.1 亿，温度分位 70。两口径只作同向参照。</p></div><div class="" id="claim-lhb-638d22ca4ecfae10"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">判断 · 证据</span></div><p class="mut">判断 · 证据</p><p>⑤【七道门漏斗·47 → 16 → 13 → 4 → 1】涨停 47 只 → 有当日榜行 16 只 → 票级净买 &gt;0 13 只 → 有 S/A 席 4 只（000995、601083、603703、603131；002086 有 A 席但净买为负）→ 封/成交 ≥5% ∧ 炸 ≤3（其中 000995 炸 6 超限，按昨日口径本应出局，今日按『炸≥6 在冰点层 n=43/48.8%/+1.13% 反而优于基准』破例保留并显式登记）→ 双源非强矛盾 → 占比非 5-10% 弱桶 → 终选 1 只（000995，占比 12.73% 落 10-20%）。反向路径独立复算（先占比桶后席位门）：冰点×涨停×厚封 194 只里占比 10-20 共 58 只、其中有 S/A 的只有 000995 与 601083 两只，结论同收敛。</p></div><div class="" id="claim-lhb-5ed5a87161bd03cd"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">判断 · 证据</span></div><p class="mut">判断 · 证据</p><p>⑥【机器 Top5 逐只处置】_学习/席位荐票_20261030.json（SA61 / 候选 7 / Top5）：①603278 大业股份（席位分 2.05/综合 4.01，A 席 国泰海通长宁江苏路 +0.513 亿）涨 9.17% 未涨停 → 不在 zt_pool，按纪律不得入荐票；②688308 欧科亿（1.91/3.91）−18.83%、③688122 西部超导（1.56/3.52）−17.97%，均为大跌票无涨停 → 不入荐票（且西部超导两 A 席合计仅 0.389 亿）；④002086 东方海洋（0.94/2.94）+10.12% 在 zt_pool，但**落 _学习/龙虎榜双源校验_20261030.json『强矛盾清单』：源1 净买 −0.6232 亿 vs 源2 买侧 +1.3686 亿（方向相反且 &gt;1 亿）= 卖压污染嫌疑，禁入荐票**，另解读栏『5 席全买 0 卖』与票级净买为负直接冲突；⑤000995 皇台酒业（0.83/2.83）+10.01% → 唯一可用，本日荐票。机器通过率 1/5，与昨日 1/5 持平。</p></div><div class="" id="claim-lhb-adf5ad0fea4d7e5f"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">判断 · 证据</span></div><p class="mut">判断 · 证据</p><p>⑦【双源复核处置·强矛盾 7 只全部出池】_学习/龙虎榜双源校验_20261030.json status=pass、errors=[]、源1 83 码 / 源2 73 码 / 可比 72 / 一致 36 / 分歧 15 / 强矛盾 7 / 打折 14 / 仅源2 12。强矛盾 7 只：000530 冰山冷热（−1.2072 vs +0.226）、000678 襄阳轴承（−1.345 vs +1.0466）、002086 东方海洋（−0.6232 vs +1.3686）、002555 三七互娱（−1.6733 vs +0.0024）、600592 龙溪股份（−0.3043 vs +1.2446）、600838 上海九百（−0.1101 vs +1.0805）、688137 近岸蛋白（−1.2512 vs +1.5145）→ 全部出池，其中 002086 是机器 Top5 第 4 位，已按铁律禁入。打折 14 只中影响荐票的 3 只：601083 锦江航运 3.25×（0.2231 vs 0.7255）、603131 上海沪工 11.5×（0.0319 vs 0.3663）、688045 必易微 10.2×（0.0833 vs 0.8466）→ 一律按『净买打折读』降权，601083 因此只给观察。000995 判一致（源1 +0.9011 亿 / 席位侧 +0.7557 亿 = 0.84×，非强矛盾非打折）。</p></div><div class="" id="claim-lhb-887ddd7ae120b622"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">判断 · 证据</span></div><p class="mut">判断 · 证据</p><p>⑧【昨日自我复盘·用昨日写死的阈值套今日结果，非后视镜】昨日（lhb判断_20261029.json）判 B 档偏 C、置信 56、单票 601188 龙江交通 3% 试探。结算：601188 20261030 开 3.47 / 收 3.26 ⇒ 执1 = −6.05%（与 _学习/子agent增强/战绩画像_lhb_20261030.json『荐票日 20261029 执行胜率 0/1、均收 −6.05』一致），打脸；另两只观察：301079 邵阳液压 开 37.55 / 收 36.79 ⇒ −2.02%（且当日双源转『分歧』：−0.7843 vs +0.4031），002938 鹏鼎控股因 _bars_cache 停更至 2026-07-15 不可核。四条可证伪条件逐条判：①『601188 执1 ≤ −3% ⇒ 五席全买 0 卖 = 锁筹 + A 席进攻 判负』→ 实际 −6.05%，**触发判负**，故今日对 n&lt;25 小样本席权重一律 ×0.5、『全买 0 卖』不再加分（000995 与 601083 的 S/A 席正好都是 n=12 小样本，均按 0.5 计）；②『开盘涨幅 ≥+6% 或 ≤−3% 不买』→ 实际开盘 3.47 vs 昨收 3.50 = −0.86%，在 gate 内，应买；③『002938 收盘 ≥+5% ⇒ 跌停日 A 席大额买入 从禁入改可观察』→ 002938 今日不在龙虎榜且本地无当日 K 线，**不可核、不结算**（已入盲区声明）；④『S/A 在涨停池覆盖 ≥3 只且净买合计 ≥2.0 亿 ⇒ 结构判断被证伪、档位上调 A』→ 实际覆盖 5 只 / 0.7621 亿：覆盖数首次达标但净买额只有阈值的 38%，且这句是『且』，**未达证伪阈值**；相对昨日 2 只 / 0.328 亿，覆盖 +150%、净买 +132%，属结构性改善而非翻转，故档位维持 B。</p></div><div class="" id="claim-lhb-0df9d4a9808b374b"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">判断 · 证据</span></div><p class="mut">判断 · 证据</p><p>⑨【历史分层底座·本席本地复算，执1=T+1 开→收，零后视镜】窗口 20260706~20261030（61 个交易日）、当日榜样本 3287 条、其中有 T+1 开收可结算 2287 条、全样本 45.1% 胜率 / +0.43%（注：此 45.1% 是『龙虎榜当日榜全体』基准，与本路荐票战绩 41.7%（画像 45/108）不同源，不可混用）。分层：冰点&lt;25 层 n=778/47.2%/+0.32%；冰点×涨停 n=303/45.5%/+0.28%；冰点×涨停×厚封≥5 n=194/45.9%/+0.49%；冰点×涨停×薄封&lt;5 n=109/45.0%/−0.10%；冰点×涨停×首板 n=230/46.1%/+0.29%；冰点×连板≥2 n=73/43.8%/+0.23%；冰点×20cm n=72/50.0%/+1.51%；冰点×炸≥6 n=43/48.8%/+1.13%（优于基准，与直觉相反）；冰点×换手≥30 n=23/69.6%/+2.70%；冰点×流通&lt;30 亿 n=44/52.3%/+1.67%；冰点×首封午后 n=63/60.3%/+1.62%；冰点×首封09:30-10:00 n=153/41.8%/−0.24%；冰点×炸0 n=109/49.5%/+0.59%；冰点×炸1-2 n=115/40.9%/−0.40%；冰点×换手5-15 n=125/50.4%/+0.31%；冰点×换手15-30 n=98/36.7%/−0.15%；冰点×流通30-100亿 n=185/43.8%/+0.04%（与昨日本席引用的 128/43.0% 有出入，已按今日重跑口径更正为 153/41.8%）。</p></div><div class="" id="claim-lhb-6fca173fec7dea19"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">判断 · 证据</span></div><p class="mut">判断 · 证据</p><p>⑩【战绩画像环境档拆解·画像缺此维度，本席自算】_学习/子agent增强/战绩画像_lhb_20261030.json 只有『按日胜率/均收』与合计（45/108 = 41.7%、均收 +0.12%、53 个交易日），无环境档拆解与特征拆解字段；本席用 _市场温度表 把 53 个荐票日映射到温度档（可映射 32 日、13 日温度为 null 未计）：极冰点&lt;15 5 日 17 票 52.9%/−1.00%；**冰点15-25 6 日 13 票 38.5%/+3.18%**；冷25-40 11 日 39 票 38.5%/−0.21%；中40-65 9 日 34 票 38.2%/−0.99%；热≥65 1 日 5 票 60.0%/+0.83%。今日落在冰点15-25 档：胜率 38.5% 明显低于全样本 41.7%，均收被个别大赚票拉高（+3.18%）⇒ 该档特征是『低胜率、右偏』，只能小仓试探，不可重仓。</p></div><div class="" id="claim-lhb-450568a4b95bfac3"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">判断 · 证据</span></div><p class="mut">判断 · 证据</p><p>⑪【行业级资金强度·MA-20261029-01④ 今日落地】新建 资金流行业.py 并跑出 _学习/_资金流行业_20261030.json（覆盖 34/73 = 46.6%、21 个行业，合计 +17.15 亿、47.20bp）：医疗服务 3 涨停 4 上榜 +2.917 亿 / 164.9 亿流通 = 176.87bp；小家电 121.21bp；医疗器械 2 涨停 +2.279 亿 = 85.70bp；航运港口 82.51bp；白酒Ⅱ 2 上榜 +5.511 亿但流通 1159 亿 = 47.55bp；自动化设备（无涨停，埃斯顿 +4.335 亿）= 189.00bp；塑料（海洋王 +0.865 亿）= 207.39bp。读法：今日资金强度集中在医药与设备，白酒是『绝对额最大但摊在 1159 亿流通上最薄』的防守线——000995 所在线属后者。</p></div><div class="" id="claim-lhb-404166564a1de3ee"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">判断 · 档位</span></div><p class="mut">判断 · 档位</p><p>B</p></div><div class="" id="claim-lhb-88fa9d5ba4bbb43f"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">判断 · 档位说明</span></div><p class="mut">判断 · 档位说明</p><p>B 非 A（三条）：①环境——市场温度 15.2 落冰点层，本路战绩在冰点15-25 档 6 日 13 票 38.5%，低于全样本 41.7%；②反向因子——资金温度 70 分位落『过热桶 ≥67』，认知库载倒 U 型：过热日跟买 45.7%/+0.19%（vs 温和 34-66 档 61.6%），且本路历史两次过热日打脸（0709 98 分位 0/5 −4.58%、0713 0/5 −3.86%），今日须整体降权；③核心信号缺席——S 档 3 笔里 2 笔为退市/近零，唯一有效笔 n=12 小样本，且昨日『五席全买 0 卖』已判负，S/A 小样本权重被强制 ×0.5，本日三个 S/A 候选全中此条。B 非 C（三条）：①席位净买由 −16.21 亿翻为 +14.70 亿、44/72 转正、涨停∩榜 12→16；②双源 status=pass、强矛盾率 9.7%（7/72），低于昨日 16.1%（9/56）；③涨停 47（昨 39）、最高 5 板、二板加 9、一进二 20.7%，赚钱效应端确实在修复。</p></div><div class="" id="claim-lhb-19181244a48177f0"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">判断 · 置信度</span></div><p class="mut">判断 · 置信度</p><p><a href="#component-FUNDTEMP">回看本段权威组件中的原条目</a></p></div><div class="" id="claim-lhb-3769e882f7b1dde3"><div class="claim-head"><span class="claim-role role-condition">条件</span><span class="claim-source">判断 · 可证伪条件</span></div><p class="mut">判断 · 可证伪条件</p><p>20261031 若 000995 皇台酒业执1（开→收）≤ −4%，则『S 档在场 + 占比 10-20% + 炸 6 次换手充分』组合判负：冰点层『炸≥6』桶（n=43/48.8%/+1.13%）降为不引用，S 档小样本席权重系数由 0.5 再降为 0（即本路弃用 n&lt;25 的 S/A 信号）。</p></div><div class="" id="claim-lhb-a189195751a33721"><div class="claim-head"><span class="claim-role role-condition">条件</span><span class="claim-source">判断 · 可证伪条件</span></div><p class="mut">判断 · 可证伪条件</p><p>20261031 若 000995 开盘涨幅 ≥ +6%（buy_gate 未成交），本笔不计入荐票战绩；≤ −3% 亦不买，按空仓结算，禁盘中追价。</p></div><div class="" id="claim-lhb-fdc2313a47e0ac01"><div class="claim-head"><span class="claim-role role-condition">条件</span><span class="claim-source">判断 · 可证伪条件</span></div><p class="mut">判断 · 可证伪条件</p><p>20261031 若 S/A 席在涨停池覆盖 ≥3 只且净买合计 ≥2.0 亿（第 3 日沿用同一阈值），则『S/A 体量不足以抬轿』判错，档位须由 B 上调至 A 并重算仓位上限（由 5% 提到 8%）。</p></div><div class="" id="claim-lhb-2e33fb15dad08939"><div class="claim-head"><span class="claim-role role-condition">条件</span><span class="claim-source">判断 · 可证伪条件</span></div><p class="mut">判断 · 可证伪条件</p><p>20261031 若 301520 万邦医药执1 &gt; +5% 而 000995 执1 ≤ 0，则『本路核心信号（S/A 在场）优先于结构四桶全正格』判负，须把『零 S/A 但结构全正格』从观察升为可荐票（权重上限 3%）。</p></div><div class="" id="claim-lhb-2bdd46c1c03bf11a"><div class="claim-head"><span class="claim-role role-condition">条件</span><span class="claim-source">判断 · 可证伪条件</span></div><p class="mut">判断 · 可证伪条件</p><p>20261031 若行业净买强度最高的两个行业（塑料 207.39bp、自动化设备 189.00bp）次日行业涨幅均不高于强度最低行业，则『行业资金强度』无区分度，撤销 MA-20261029-01④ 的落地资格并回退为只报数不判读。</p></div><div class="" id="claim-lhb-34817d072d335be6"><div class="claim-head"><span class="claim-role role-limitation">限制</span><span class="claim-source">判断 · 独立盲区声明</span></div><p class="mut">判断 · 独立盲区声明</p><p>①席位明细只有买五 + 其卖出额，无卖五：席位净额与票级净买可符号相反（今日 601083 席位 +0.7255 亿 vs 票级 +0.2231 亿 = 3.25× 打折；全局席位侧 +65.15 亿 vs 票级 +14.70 亿，真实率仅 22.6%，昨日为 −40.9%）。凡涉净买的数量结论一律以 lhb.csv 当日榜为准，席位净额只作『谁在场』的方向证据。</p></div><div class="" id="claim-lhb-8d4f26fc6934cbff"><div class="claim-head"><span class="claim-role role-limitation">限制</span><span class="claim-source">判断 · 独立盲区声明</span></div><p class="mut">判断 · 独立盲区声明</p><p>②主动查证 0 次：任务指定的 ifind查.py 在本机全盘检索无命中（D:\股票数据 下不存在该文件，仅有 iwencai盘后_*.json 历史落盘），故本轮零外部查证，全部读数来自本地复算脚本（D:/hermes/profiles/a/cache/scratch/lhb_bt_1030.py、lhb_deep_1030.py、lhb_funnel_1030.py）。</p></div><div class="" id="claim-lhb-3a63de76355d945f"><div class="claim-head"><span class="claim-role role-limitation">限制</span><span class="claim-source">判断 · 独立盲区声明</span></div><p class="mut">判断 · 独立盲区声明</p><p>③_bars_cache/002938.csv 止于 2026-07-15（3.5 个月未更新）、北交所 920xxx 有缺口：昨日可证伪条件③（002938 收盘 ≥+5%）今日不可核、不可结算；涉及位置与次日涨跌的表述只用可核数据。</p></div><div class="" id="claim-lhb-7a902c39d9b69913"><div class="claim-head"><span class="claim-role role-limitation">限制</span><span class="claim-source">判断 · 独立盲区声明</span></div><p class="mut">判断 · 独立盲区声明</p><p>④机器双源校验今日 status=pass 是『_席位动向 18:07 已落盘之后才运行』的时序侥幸，不是代码保证。我已按 MA-20261029-01③ 给 龙虎榜双源校验.py 打补丁（_settle_source2：源2 未落盘或 mtime 距今 &lt;5s 时按预算等待重试，最长 180s，新增 --wait-source2 开关与『等待源2秒数』字段），实测缺源2 路径 6s 预算内返回空并写 errors、有源2 路径 0s 返回 73 码，重跑 20261030 结果与旧版逐项一致（可比 72/一致 36/分歧 15/强矛盾 7/打折 14）；但补丁未在真实生产时序（竞态现场）下验证。</p></div><div class="" id="claim-lhb-6f7ffe53c70361d1"><div class="claim-head"><span class="claim-role role-limitation">限制</span><span class="claim-source">判断 · 独立盲区声明</span></div><p class="mut">判断 · 独立盲区声明</p><p>⑤作战包_lhb_20261030.json 与 昨日复盘_lhb_20261030.json 均不存在，战场全貌（温度/涨跌停/连板/成交额/席位）由本席自建；战绩画像只有按日值，环境档与特征拆解由本席自算，且 53 个荐票日中 13 个温度缺失未计入（覆盖 32 日）。</p></div><div class="" id="claim-lhb-43faedd9bb166a61"><div class="claim-head"><span class="claim-role role-limitation">限制</span><span class="claim-source">判断 · 独立盲区声明</span></div><p class="mut">判断 · 独立盲区声明</p><p>⑥_席位分档.json 窗口 20260401~20261029、467 席、基准执1 48.7%/+0.64%：今日 10 个 S/A 席中 9 个 n&lt;25，唯一非小样本的 华泰证券深圳彩田路 n=25 恰卡在门槛线上，故全部 S/A 判断建立在小样本收缩值上（华鑫上海分公司 75.0% 收缩到 63.0%、国泰海通长宁江苏路 66.7% 收缩到 58.5%）。</p></div><div class="" id="claim-lhb-347204e9a7681adf"><div class="claim-head"><span class="claim-role role-limitation">限制</span><span class="claim-source">判断 · 独立盲区声明</span></div><p class="mut">判断 · 独立盲区声明</p><p>⑦行业级资金流（MA-01④）覆盖仅 46.6%（34/73）：行业标签只存在于 zt_pool/zb_pool/strong_pool 三活跃池，39 只在榜但未涨停、未炸板、未新高的票无行业标签，故该表只读『活跃池内资金去向』，不等于全市场行业资金流，且未分位化（需 ≥60 交易日累积，本版只出当日绝对值）。</p></div><div class="" id="claim-lhb-5ee55bc09e1a8c13"><div class="claim-head"><span class="claim-role role-limitation">限制</span><span class="claim-source">判断 · 独立盲区声明</span></div><p class="mut">判断 · 独立盲区声明</p><p>⑧荐票只覆盖『涨停 ∩ 龙虎榜』交集（47 ∩ 72 = 16 只），未覆盖未涨停但 S/A 大额买入的票（今日 603278 大业股份 A 席 +0.513 亿 涨 9.17%、688308 欧科亿 A 席 +0.477 亿 跌 18.83%），这是本路既定边界：只做次日可执行的涨停/榜单交集，不做左侧埋伏。</p></div><div class="" id="claim-lhb-3345376faccfe9e4"><div class="claim-head"><span class="claim-role role-limitation">限制</span><span class="claim-source">判断 · 独立盲区声明</span></div><p class="mut">判断 · 独立盲区声明</p><p>⑨未读其他四路判断文件：000995 同落白酒线（今日 4 只涨停：000995/000568/000596/603198），是否被他路判为主线不可知，本路只按席位 + 结构判；跨路重叠导致的仓位叠加风险未评估。</p></div><div class="" id="claim-lhb-7fbcf6f5a2e80b84"><div class="claim-head"><span class="claim-role role-limitation">限制</span><span class="claim-source">判断 · 独立盲区声明</span></div><p class="mut">判断 · 独立盲区声明</p><p>⑩账本执行断链：_学习/_模拟盘/lhb/状态.json 日期 20261029、持仓为空、已平仓 15 笔、nav 0.999197，昨日 601188 的 3% 计划仓未出现在持仓也未出现在平仓序列 ⇒ 该笔真实收益（−6.05%）只存在于计划口径，未落账本，本路的实际净值不含这一亏。</p></div><div class="" id="claim-lhb-6ab568337ab98f2f"><div class="claim-head"><span class="claim-role role-limitation">限制</span><span class="claim-source">判断 · 独立盲区声明</span></div><p class="mut">判断 · 独立盲区声明</p><p>⑪HTML body 只做结构断言、未在盯盘台实机渲染：为避免与并行路争抢 盯盘台.html 与注入标记，本路未运行 生成盯盘台.py，仅断言 6 个 h2 标题逐字一致、div 配平（开 23 闭 23 且深度归零）、class 全在白名单（obs/obslist/obswrap/obs-head/obs-nm/obs-pos/obs-watch/obs-lab/obs-lab2/obs-rec/card/mut/trow）、obs 卡数 = 标的数 3、无裸 null/None。视觉层（卡片换行、表格横向溢出）未经浏览器验证。</p></div><span id="claim-lhb-63f2a02a28896df2"></span></div><div class="" id="claim-lhb-a617dfff2f1fce75"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">旧版原文补充</span></div><div class="card">
<p><b>背离是今天最重要的读数：资金温度 70 分位（热）与市场温度 15.2（冰点）方向相反。</b>按认知库的倒 U 型，热量在中段（34-66）最有效、过热（≥67）反而变差——资金热而涨停质量冰点，说明钱在「防守性买入」而不是「进攻性抢筹」，这直接决定了今日只给 5% 而不是 8-10%。</p>
</div></div><div class="" id="claim-lhb-b74569aac6cb76c9"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">旧版原文补充</span></div><div id="table-ac618d0a334b7607"><table class="trow">
<tr><th>资金温度（买入额口径，官方 _资金温度.json）</th><th>席位数</th><th>买入额</th></tr>
