l="#2f9e6e"></rect><rect x="219.8" y="88.0" width="21.3" height="10.8" rx="1.5" fill="#2f9e6e"></rect><rect x="260.8" y="88.0" width="21.3" height="42.6" rx="1.5" fill="#2f9e6e"></rect><rect x="301.8" y="88.0" width="21.3" height="8.4" rx="1.5" fill="#2f9e6e"></rect><text x="353.5" y="84" font-size="8" fill="#4a5666" text-anchor="middle">∅</text><rect x="383.8" y="85.4" width="21.3" height="2.6" rx="1.5" fill="#d64541"></rect><rect x="424.8" y="88.0" width="21.3" height="25.1" rx="1.5" fill="#2f9e6e"></rect><rect x="465.8" y="88.0" width="21.3" height="7.7" rx="1.5" fill="#2f9e6e"></rect><text x="517.5" y="84" font-size="8" fill="#4a5666" text-anchor="middle">∅</text><rect x="547.8" y="88.0" width="21.3" height="33.8" rx="1.5" fill="#2f9e6e"></rect><rect x="588.8" y="76.0" width="21.3" height="12.0" rx="1.5" fill="#d64541"></rect><rect x="629.8" y="88.0" width="21.3" height="3.6" rx="1.5" fill="#2f9e6e"></rect><rect x="670.8" y="78.0" width="21.3" height="10.0" rx="1.5" fill="#d64541"></rect><rect x="711.8" y="88.0" width="21.3" height="14.1" rx="1.5" fill="#2f9e6e"></rect><rect x="752.8" y="30.0" width="21.3" height="58.0" rx="1.5" fill="#d64541"></rect><text x="763.5" y="26.0" font-size="8.5" fill="#98a0ab" text-anchor="middle">+3.5</text><text x="804.5" y="84" font-size="8" fill="#4a5666" text-anchor="middle">∅</text><text x="845.5" y="84" font-size="8" fill="#4a5666" text-anchor="middle">∅</text><circle cx="271.5" cy="155" r="2.6" fill="#d9a441"></circle><circle cx="312.5" cy="155" r="2.6" fill="#d9a441"></circle><text x="107.5" y="168" font-size="8.5" fill="#6b7683" text-anchor="middle">09-04</text><text x="189.5" y="168" font-size="8.5" fill="#6b7683" text-anchor="middle">09-08</text><text x="271.5" y="168" font-size="8.5" fill="#6b7683" text-anchor="middle">09-10</text><text x="353.5" y="168" font-size="8.5" fill="#6b7683" text-anchor="middle">09-21</text><text x="435.5" y="168" font-size="8.5" fill="#6b7683" text-anchor="middle">09-23</text><text x="517.5" y="168" font-size="8.5" fill="#6b7683" text-anchor="middle">09-25</text><text x="599.5" y="168" font-size="8.5" fill="#6b7683" text-anchor="middle">09-29</text><text x="681.5" y="168" font-size="8.5" fill="#6b7683" text-anchor="middle">10-09</text><text x="763.5" y="168" font-size="8.5" fill="#6b7683" text-anchor="middle">10-13</text><text x="845.5" y="168" font-size="8.5" fill="#6b7683" text-anchor="middle">10-15</text><text x="46" y="12" font-size="9" fill="#98a0ab">昨停溢价=昨日涨停池今日开盘买→收盘均收(执行口径,%);红正绿负;金点=连负≥3日(洗出反弹窗条件)</text></svg><div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap"><div style="flex:1;min-width:190px;border:1px solid #33383f;border-radius:8px;padding:8px 10px"><div style="font-weight:700;font-size:13px;color:#5b636d">❄ 冰点进攻窗 · —</div><div style="font-size:11px;color:#5b636d">温度&lt;25</div></div><div style="flex:1;min-width:190px;border:1px solid #33383f;border-radius:8px;padding:8px 10px"><div style="font-weight:700;font-size:13px;color:#5b636d">☢ 过热禁追窗 · —</div><div style="font-size:11px;color:#5b636d">温度≥85</div></div><div style="flex:1;min-width:190px;border:1px solid #33383f;border-radius:8px;padding:8px 10px"><div style="font-weight:700;font-size:13px;color:#5b636d">♨ 洗出反弹窗 · —</div><div style="font-size:11px;color:#5b636d">溢价连负3日</div></div></div><div style="font-size:11px;color:#6b7683;margin-top:8px">读法:柱线剪刀口张开(涨停创高而金线趴地)=数量繁荣×接力冰点;三窗战绩=2025-07~2026-07单牛市周期回测,小样本,给环境判断不给指令。已证伪:复合&quot;冰点+≥2转机分量&quot;硬条件。</div></div><!--/LEADIND--></div><div class="card"><span id="claim-cycle-63a602325888ed80"></span></div><div class="" id="claim-cycle-054943e023337646"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">旧版原文补充</span></div><p>一进二率源值0.03（前一交易日0.303，-27.3pp，跌破规则表「&lt;10%=接力冰点线」，为近250日分位约2.4%的极低值）、二进三率0.1（前一交易日0.0，+10pp）、高度晋级率0.2（前一交易日0.2，持平）、核按钮率0.042（昨日涨停48只、今日跌停回杀2只，前值0.0）；昨日涨停溢价=—（源未产出，不补造）。三窗触发器为空数组。</p></div><div class="" id="claim-cycle-2174e158e5296a08"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">旧版原文补充</span></div><p>[极值专门判读 · 一进二率250日分位约2.4%] 一进二率0.03处近250日约2.4%分位（历史级极低），与前一日的0.303（95.2%分位）形成一日反转。判读：前一日「一进二高、二进三零」的存量抱团结构本日直接崩塌——二板加15→6、最高板虽回5但4板断层、涨停数持平而跌停翻倍，说明首板向二板接力的资金当日撤退，接力端进入冰点而非重建。可证伪点：若次日一进二率回升≥0.15且二进三率≥0.2并伴随2板家数≥5，则「接力崩塌」被削弱。口径边界：源=local（温度表梯队口径），与前一日同源可比。</p></div><div class="" id="claim-cycle-a4ea1446b93d02c9"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">旧版原文补充</span></div><li>三窗触发器=[]：冰点进攻窗（温度&lt;25）/过热禁追窗（温度≥85）/洗出反弹窗（溢价连负3日）当日按现行实现均未触发。★口径异常已登记（连续第2日）：温度22.8&lt;25已落入「冰点进攻窗」规则条件，而触发器仍为空数组（先例20260928温度18.1时非空），本判不代判、列为次日核验点。</li></div><div class="" id="claim-cycle-45ecbb156bb06636"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">旧版原文补充</span></div><li>昨日涨停溢价=—：源未产出，故本日无法用溢价验证持筹收益，亦无法判定「溢价连负3日=洗出反弹窗」；按零编造纪律登记为缺口。</li></div><div class="" id="claim-cycle-64707f870c1d7335"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">旧版原文补充</span></div><li>题材归位来源档A=0/B=36/C=0，36只全为同花顺涨停原因（THS编辑聚合），无公告级证据（公告催化补充_20261015.json不存在），主线判定建立在聚合正确性假设上。</li></div><div class="" id="claim-cycle-0251f262245c47d5"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">旧版原文补充</span></div><li>竞价维度（竞价额/一字真伪）未接入本路；风险事件源本日继续在位（风险事件_20261015.json）。</li></div><div class="" id="claim-cycle-cc5ca1defc3872c0"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">旧版原文补充</span></div><li>连板口径差异登记：温度表梯队{首板30、2板2、3板2、5板2}与先行指标晋级明细（首板30、二连板1、三连板1，合计32≠涨停36）存在口径差；连板分布以温度表梯队为准，先行指标晋级率只作方向参考、不用于定量。</li></div></section><section id="stages"><h2>三 情绪五阶段 · 五路周期投票</h2><div id="component-MACHVOTE"><!--MACHVOTE--><!--VOTEBOARD--><div style="margin:10px 0;padding:12px 14px;background:#14171e;border:1px solid #2a2f3a;border-radius:10px">
<div style="font-size:11px;letter-spacing:2px;color:#d9a441;font-family:monospace">五路周期投票 · 主判=冰点·降</div>
<div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:8px">
<div style="flex:1;min-width:100px;padding:8px;border:1px solid #2a2f3a;border-radius:8px;color:#5c6674;font-size:11.5px">①竞价<br>弃权</div>
<div style="flex:1;min-width:100px;padding:8px;border:1px solid #2a2f3a;border-radius:8px;color:#5c6674;font-size:11.5px">②席位<br>弃权</div>
<div style="flex:1;min-width:100px;padding:8px;border:1px solid #2a2f3a;border-radius:8px;color:#5c6674;font-size:11.5px">③题材<br>弃权</div>
<div style="flex:1;min-width:100px;padding:8px;border:1px solid #2a2f3a;border-radius:8px;color:#5c6674;font-size:11.5px">④产逻<br>弃权</div>
<div style="flex:1;min-width:100px;padding:8px;border:1px solid #2a2f3a;border-radius:8px;color:#5c6674;font-size:11.5px">⑤质量<br>弃权</div>
</div>
<div style="margin-top:8px;color:#5c6674;font-size:11px">分歧未达阈值(当日≥3/5或加权≥0.60复议;连续3日≥2路同向重做) · 次日A档三指标Δ客观结算,准确率定话语权 · ★一致率长期&gt;0.8=回声室警示(evidence须私有数据)</div>
</div><!--/VOTEBOARD--><!--/MACHVOTE--></div><div class="card"><span id="claim-cycle-3ae3855c0f22aee1"></span></div><div class="" id="claim-cycle-5b9e44f849a73318"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">旧版原文补充</span></div><p>市场情绪：温度22.8、冰点档（前一交易日17.9，Δ+4.9，连续第2日冰点）；涨停36（36→36，持平）、炸板7（24→7，-17）、跌停26（11→26，+15/+136%，越规则表「跌停≥两位数=退潮/恐慌」线并在深水区放大）、炸板率16.3%（40.0%→16.3%，-23.7pp）、封板率83.72%（=36/(36+7)；60.0%→83.72%，+23.72pp，越过规则表「80%次日大概率分化」线）、回封24（21→24）、二板加6（15→6）、最高板5（4→5）、封板总额23.1亿（33.0→23.1，-30.0%）。质量端（炸板率/封板率）显著改善，风险端（跌停/跌停封单）与中位接力端（二板加/一进二率）显著恶化，是典型「分化撕裂」而非单边修复或单边退潮。</p></div><div class="" id="claim-cycle-48cccc34ac718437"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">旧版原文补充</span></div><p>五路周期票：周期投票台账20261015条目未结算（n_voted=0），本页不采五路周期一致率、不表述「五路共识」。旁证（五路判断_20261015.json·档位机械映射）：auction C68、lhb C70、theme C73、logic B65、limitup C72＝四C一B，档位自报总档＝C；同日总审_20261015.json总裁决＝C防守（维持）、置信度73、仓位建议总仓上限≤8%（低于昨日12%）。分歧内容：唯一B档=logic（业绩/逻辑腿相对占优）；四C依据「一进二率0.03历史级极低、二板加6环比-60%、跌停26环比+136%、方向类指标全面走弱」，仅质量端（炸板率0.163、封板率83.72%）改善不足以升档。</p></div><div class="" id="claim-cycle-0a13c2e5369c027b"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">旧版原文补充</span></div><p>独立裁决：主判「冰点 / 降」，置信度74。判「冰点」依据：温度22.8&lt;25、温度表温度档字段当日为「冰点」，连续第2日处于冰点档。判「降」（而非升/平）依据：①风险端深入——跌停11→26（+136%）、跌停封单出现东百集团11.78亿/仁东控股1.78亿级，越规则表两位数退潮线且方向恶化；②接力端崩塌——一进二率30.3%→3.0%（破10%接力冰点线）、二板加15→6（-60%）；③高标断板——昨日3板醋化股份(603968)本日跌停断板、昨日4板新经典(603096)断板，中位层4板断层；④封板率83.72%≥80%按规则表＝次日大概率分化。反方证据如实登记：成交额+15.5%、炸板率40.0%→16.3%、封板率60.0%→83.72%、最高板4→5、5板及以上2只、二进三率0.0→0.1。攻防=冰点防守档、总仓位上限≤8%、单笔≤5%、不追高、不杠杆。不上调为「修复/平」的理由：量能仍&lt;3万亿（弱修）、跌停进两位数深水、接力端破冰点线，质量端改善属分化结果而非广度修复；且封板率过80%本身指向次日分化。</p></div><div class="" id="claim-cycle-60c9449a5b1010a1"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">旧版原文补充</span></div><p>题材与主线：题材归位覆盖36/36，来源档A/B/C=0/36/0；行业口径全场无题材过六有（元件5、物流4、出版3均判「分支」），聚类口径最高=PCB算力硬件3/6（元件5/含一字1、弹性20cm，得分3，判「分支」），食品饮料/出版传媒/医药/物流供应链/染料印染均为分支。高度集群为5板2只（002696百洋股份-水产饲料、002343慈文传媒-微短剧）＋3板2只（000530冰山冷热-液冷温控、001318阳光乳业-乳制品），4板断层；2板2只（605189富春染织、601811新华文轩）。前一日「宽度陷阱」双线（PCB 11只→1只、冰雪经济8只→1只）本日进一步归零为0只续板。题材四维警报为空（如实登记为缺口）。</p></div></section><section id="ladder"><h2>四 连板梯队</h2><div id="component-LADDER"><!--LADDER-->
<div class="card"><h3 style="margin:0 0 8px">连板梯队 <span class="hint">机器核对 · 涨停池连板数分布(涨停池 36 只(zt_pool全口径,含ST))</span></h3><div class="cols"><div class="col hotc"><i style="height:6%"></i><b>2</b><span>5板</span></div>
<div class="col"><i style="height:6%"></i><b>2</b><span>3板</span></div>
<div class="col"><i style="height:6%"></i><b>2</b><span>2板</span></div>
<div class="col"><i style="height:100%"></i><b>30</b><span>1板</span></div>
</div><div class="colsub"><span>最高5板=百洋股份 饲料(5/5,093000首封)</span><span>腰部: 2板2只 / 3板2只 / 4板+2只</span><span>首板30占83% · 涨停池 36 只(zt_pool全口径,含ST)</span></div>
<p style="margin:6px 0 0" class="mut">温度表涨停36只 · 炸板率16.3%</p></div>

<!--/LADDER--></div><div class="card"><span id="claim-cycle-c2fbcb8ca4648adc"></span></div><div class="" id="claim-cycle-cf289258368789f2"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">旧版原文补充</span></div><p>涨停池36只，连板分布（温度表梯队）5板2只、3板2只、2板2只、首板30只；最高板5（前一交易日4），4板及以上2只，4板为0（5→3断层），首板占比83.3%（前一交易日58.3%）。宽度与前一交易日持平（36只），高度端由4板升至5板但中位4板断层——「窄底＋孤高标」是本日梯队形态，与量能理论高度（8-10板）背离约3-5板。</p></div><div class="" id="claim-cycle-0becd261c48da7af"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">旧版原文补充</span></div><p>5板2只：002696百洋股份（水产饲料/鱼粉涨价）、002343慈文传媒（微短剧/影视IP）；3板2只：000530冰山冷热（数据中心液冷/储能温控）、001318阳光乳业（乳制品）；2板2只：605189富春染织（染料印染）、601811新华文轩（出版传媒）。5板两只分属农业饲料与传媒短剧两条线、无同线共振，4板断层使5→6板路径无承接（二进三率0.1、一进二率0.03），故高度不可视为梯队重建，属冰点档孤高标。断板与回封：昨日3板醋化股份(603968)本日跌停断板、昨日4板新经典(603096)断板；澳弘电子(605058，19天11板)昨日炸板本日回封、按连板计数计首板；华北制药(600812，6天4板)、华阳新材(600281)等断板回封票同样计首板。</p></div></section><section id="position"><h2>五 攻防 · 仓位总开关</h2><div class="card"><span id="claim-cycle-46156ec4cd5d7d41"></span></div><div class="" id="claim-cycle-176d9f9ba79b9d4c"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">旧版原文补充</span></div><p>本日开关：冰点防守档，总仓位上限≤8%（0-8%），单笔≤5%，不追高、不上杠杆、不加仓；禁以「封板率83.72%过80%」单独作为进攻依据（规则表该口径为「次日大概率分化」）。</p></div><div class="" id="claim-cycle-1475c040819ac9e8"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">旧版原文补充</span></div><li>升档前置条件（须同时满足）：温度回升≥25 且 涨停回升≥46 且 出现5板及以上≥1只且二进三率≥0.2 且 一进二率回升≥0.20 → 升级为「修复/平」，仓位上限可提至2-3成。</li></div><div class="" id="claim-cycle-9cddce832463f986"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">旧版原文补充</span></div><li>降档触发条件：温度继续跌破15 / 涨停数回落≤25 / 跌停连续第3日≥两位数（本日已连续第2日）→ 退为「退潮/降」，仓位上限压至0-5%（规则表退潮档0-2成）。</li></div><div class="" id="claim-cycle-d9a3d59b2bd5a7c5"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">旧版原文补充</span></div><li>维持条件：上述两组条件均不成立时维持冰点防守（上限≤8%），不做方向加码；若当日无票落入买入闸门，空仓为合法结果。</li></div></section><section id="research"><h2>六 自主深挖 · 指标与阈值孵化</h2><div class="card"><span id="claim-cycle-442ae3ee59c3b003"></span></div><div class="" id="claim-cycle-7740dd8ab0417476"><div class="claim-head"><span class="claim-role role-research">研究</span><span class="claim-source">旧版原文补充</span></div><li>本日自主拓展应答（cycle路）1项：并入「cycle-先行指标极值判读卡」专题——一进二率0.03处近250日分位2.40%（全序列n=290），与温度22.8同处极端低温，属「极端低温×极端低晋级」共振；专题交付核查：20261015全量周期类页面（先行指标卡/灯、市场温度卡）对「一进二率」与「分位」均0命中＝连续第2日未交付（专题计0/5），滚动至窗口末日。</li></div><div class="" id="claim-cycle-4a195546ad2dbf4d"><div class="claim-head"><span class="claim-role role-research">研究</span><span class="claim-source">旧版原文补充</span></div><li>孵化指标候选「冰点分化式质量改善」＝温度&lt;25 且 封板率≥80% 且 跌停≥两位数 且 一进二率&lt;10%；今日四项全部满足（22.8 / 83.72% / 26 / 3.0%），首日样本，只登记不结论，次日看是否兑现为「分化后退潮加深」。</li></div><div class="" id="claim-cycle-b85ecc0cbf05f52d"><div class="claim-head"><span class="claim-role role-research">研究</span><span class="claim-source">旧版原文补充</span></div><li>数据缺口登记：昨日涨停溢价=—（源未产出）；三窗触发器=[]（温度&lt;25应含冰点进攻窗，口径异常连续第2日）；题材四维警报为空；连板口径源间差异（温度表梯队 vs 先行指标晋级明细）。</li></div><div class="" id="claim-cycle-62c4c66eb80be55b"><div class="claim-head"><span class="claim-role role-research">研究</span><span class="claim-source">旧版原文补充</span></div><li>能力进化快照_20261015.json：自主拓展 total=21、capabilities=2、eligible=2、hits=2、reused=9；今日无新增能力化。当日自主拓展应答13项（并入7/不深挖5/立项1，唯一立项=limitup「降权触发器抖动去抖」）。</li></div></section><section id="cognition"><h2>七 我的认知迭代 · 最新</h2><div class="tl"><div class="card"><span id="claim-cycle-8ae2912227d45647"></span></div><div class="" id="claim-cycle-c776908d42f65412"><div class="claim-head"><span class="claim-role role-cognition">认知</span><span class="claim-source">旧版原文补充</span></div><div class="tli"><b>10-15</b> 冰点档的「质量改善」与「接力崩塌」可以并存且必须分开记：本日封板率60.0%→83.72%、炸板率40.0%→16.3%属质量端改善，但一进二率30.3%→3.0%、二板加15→6、跌停11→26属接力与风险端恶化；封板率越高（≥80%）在冰点档反而是「次日大概率分化」信号而非进攻信号，单一质量读数不足以升档。</div></div><details class="chain tlfold"><summary><b>其余认知与原文证据</b><span class="chip">2条</span></summary><div class="inner"><div class="" id="claim-cycle-9b0f1d25f6b6c5fc"><div class="claim-head"><span class="claim-role role-cognition">认知</span><span class="claim-source">旧版原文补充</span></div><div class="tli"><b>10-15</b> 「一进二率极值」是双向的、一日可反转：0.303（95.2%分位）→0.03（2.4%分位）仅用一天，证明该读数由存量资金的情绪脉冲驱动、极不稳定；引用该率必须同时标注分位与方向，不得跨日外推。</div></div><div class="" id="claim-cycle-e2f3210c6d8bfbcd"><div class="claim-head"><span class="claim-role role-cognition">认知</span><span class="claim-source">旧版原文补充</span></div><div class="tli"><b>10-15</b> 高位「N天M板」回封票在连板计数上计入首板，会虚胀「首板占比」口径：澳弘电子（19天11板，昨炸板今回封）、新华文轩（14天10板）等使本日首板30只中含回封高标，冰点档内回封高标与真首板混计，宽度读数须扣除回封再判。</div></div></div></details></div></section><details class="chain"><summary>编辑说明与来源审计</summary><div class="inner"><div class="claim-anchor-bank" aria-hidden="true"><pre class="claim-anchor-text">Cycle · 周期与情绪 · 截至 2026-10-15 收盘
五路 ·
档位四C一B（auction68/lhb70/theme73/logic65/limitup72）· 总审C防守维持
