# ============ 机器区: 七段生命周期状态机卡 ============
def r_mach_lifecycle(d):
    """LIFECYCLE 卡: 主线题材七段生命周期状态机(阶段+陷阱+明日预判+仓位)
    数据源=题材生命周期_{d}.json(题材生命周期.py 产出, 零后视镜, 概率=历史转移频率样本N<3标?)
    七段: 萌发→启动→发酵→高潮→退坡→退潮→消亡; 陷阱(宽度陷阱/反抽)=标记不占段。"""
    lc = load_json('题材生命周期_%s.json', d)
    if lc is None:
        return ''
    table = lc.get('阶段表') or []
    if not table:
        return ''
    rows = ''
    for r in table:
        nm = _esc(r['线'])
        st = r['阶段']
        trap = r['陷阱']
        trap_txt = ('<span class="chip" style="background:rgba(255,95,86,.15);color:#ff5f56">⚠%s</span>' % _esc(trap)) if trap else ''
        d0 = r.get('当日') or {}
        preds = sorted(r.get('预判') or [], key=lambda p: -(p.get('概率') if p.get('概率') is not None else -1))
        pred_html = ''
        for p in preds[:2]:
            prob = ('%.0f%%' % (p['概率'] * 100)) if p.get('概率') is not None else '?'
            cond = '且'.join('%s%s%s' % (c['字段'], c['op'], c['值']) for c in p['确认条件'])
            pred_html += ('<div class="tds"><b>→%s</b> <span class="mut">%s·%s</span> '
                          '<span class="mut">确认:%s</span></div>' % (_esc(p['转移']), _esc(p['仓位']), prob, _esc(cond)))
        if not pred_html:
            pred_html = '<div class="tds"><span class="mut">—</span></div>'
        rows += ('<div class="trow"><div class="tr1"><span class="tnm">%s</span>'
                 '<span class="chip">%s</span>%s'
                 '<span class="mut">宽%d·高%d板</span></div>%s</div>\n'
                 % (nm, st, trap_txt, d0.get('w') or 0, d0.get('h') or 0, pred_html))
    head = ('<div class="card"><h3 style="margin:0 0 8px">七段生命周期状态机 '
            '<span class="hint">萌发→启动→发酵→高潮→退坡→退潮→消亡 · 陷阱=标记不占段 · 概率=历史转移频率(N&lt;3标?) · 次日可机械化结算</span></h3>'
            '<div class="tl">%s</div>'
            '<p style="margin:6px 0 0" class="mut">机械底座(题材生命周期.py); 强度(一字/封单/炸板)四维不含, 由题材命门判断层补; 预判=方向+可结算条件, 非买卖指令。</p></div>\n'
            % rows)
    return '<!--LIFECYCLE-->\n%s<!--/LIFECYCLE-->\n' % head

