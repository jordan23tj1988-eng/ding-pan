# ============ 机器区: 四维走势卡 ============
def r_mach_fourdim(d):
    """FOURDIM 卡: 四维日序列近3日表 + 缩圈/放宽警报
    坑: 主题命名漂移/断档 → 环比/晋级率 null(如实显示 —, 不推断)"""
    t = load_json('_题材四维.json')
    if not t or d not in t:
        return ''
    days = sorted(x for x in t if re.fullmatch(r'\d{8}', str(x)) and x <= d)
    if not days:
        return ''
    cur = t[d]
    prev_days = days[-4:-1]  # 近3日(含当日)
    # 当日线按宽度降序
    lines = sorted(((k, v) for k, v in cur.items() if k != '_警报'),
                   key=lambda kv: -(kv[1].get('宽度') or 0))
    cols = ''
    for dd in prev_days:
        cols += '<th>%s</th>' % dd[4:6] + '-' + dd[6:8]
    cols += '<th>环比</th><th>晋级率</th>'
    rows = ''
    for nm, e in lines:
        cells = ''
        for dd in prev_days:
            e2 = t[dd].get(nm)
            if e2 is None:
                cells += '<td class="mut">—</td>'
            else:
                chg = e2.get('宽度环比')
                mark = ''
                if chg is not None:
                    mark = ('<span style="color:#b8860b">▼</span>' if chg < 0 else '<span style="color:#e8c86a">▲</span>')
                cells += '<td>%d板%s</td>' % (e2.get('高度') or 0, mark)
        chg = e.get('宽度环比')
        chg_txt = ('<span class="%s">%s</span>' % ('warn' if (chg or 0) < 0 else 'ok', _pct(chg))) if chg is not None else '<span class="mut">—</span>'
        jl = e.get('题材晋级率')
        jl_txt = _pct(jl, 1) if jl is not None else '<span class="mut">—(断档/漂移)</span>'
        rows += ('<tr><td class="l">%s</td><td>%d</td>%s%s%s</tr>\n'
                 % (_esc(nm), e.get('宽度') or 0, cells, chg_txt, jl_txt))
    al = cur.get('_警报') or []
    al_txt = ('<p style="margin:6px 0 0" class="warn"><b>警报:</b> %s</p>' % '；'.join(al)) if al else ''
    head = ('<div class="card"><h3 style="margin:0 0 8px">四维走势 <span class="hint">宽度/高度日序列 · 环比=今日/昨日-1 · 晋级率=今二连板/昨首板 · 8/10断档→null如实</span></h3>'
            '<table class="p2"><tr><th class="l">题材线</th><th>今日宽度</th>%s</tr>%s</table>%s</div>\n'
            % (cols, rows, al_txt))
    return '<!--FOURDIM-->\n%s<!--/FOURDIM-->\n' % head

# ============ 机器区: 七段生命周期状态机卡 ============
def r_mach_lifecycle(d):
    """LIFECYCLE 卡: 主线题材七段生命周期状态机(阶段+陷阱+明日预判+仓位)
    数据源=题材生命周期_{d}.json(题材生命周期.py 产出, 零后视镜, 概率=历史转移频率样本N<3标?)
    七段: 萌发→启动→发酵→高潮→退坡→退潮→消亡; 陷阱(宽度陷阱/反抽)=标记不占段。"""
    lc = load_json('题材生命周期_%s.json', d)
    if lc is None:
        return ''
    table = lc.get('阶段表') or []
    if not table:
        return ''
    rows = ''
    for r in table:
        nm = _esc(r['线'])
        st = r['阶段']
        trap = r['陷阱']
        trap_txt = ('<span class="chip" style="background:rgba(255,95,86,.15);color:#ff5f56">⚠%s</span>' % _esc(trap)) if trap else ''
        d0 = r.get('当日') or {}
        preds = sorted(r.get('预判') or [], key=lambda p: -(p.get('概率') if p.get('概率') is not None else -1))
        pred_html = ''
        for p in preds[:2]:
            prob = ('%.0f%%' % (p['概率'] * 100)) if p.get('概率') is not None else '?'
            cond = '且'.join('%s%s%s' % (c['字段'], c['op'], c['值']) for c in p['确认条件'])
            pred_html += ('<div class="tds"><b>→%s</b> <span class="mut">%s·%s</span> '
                          '<span class="mut">确认:%s</span></div>' % (_esc(p['转移']), _esc(p['仓位']), prob, _esc(cond)))
        if not pred_html:
            pred_html = '<div class="tds"><span class="mut">—</span></div>'
        rows += ('<div class="trow"><div class="tr1"><span class="tnm">%s</span>'
                 '<span class="chip">%s</span>%s'
                 '<span class="mut">宽%d·高%d板</span></div>%s</div>\n'
                 % (nm, st, trap_txt, d0.get('w') or 0, d0.get('h') or 0, pred_html))
    head = ('<div class="card"><h3 style="margin:0 0 8px">七段生命周期状态机 '
            '<span class="hint">萌发→启动→发酵→高潮→退坡→退潮→消亡 · 陷阱=标记不占段 · 概率=历史转移频率(N&lt;3标?) · 次日可机械化结算</span></h3>'
            '<div class="tl">%s</div>'
            '<p style="margin:6px 0 0" class="mut">机械底座(题材生命周期.py); 强度(一字/封单/炸板)四维不含, 由题材命门判断层补; 预判=方向+可结算条件, 非买卖指令。</p></div>\n'
            % rows)
    return '<!--LIFECYCLE-->\n%s<!--/LIFECYCLE-->\n' % head

# ============ 板块一~六 ============
def _strip_obs(seg):
    """逐卡剔除 <div class="obs">...</div>(配平嵌套div)"""
    while True:
        s = seg.find('<div class="obs">')
        if s < 0:
            break
        e = _match_div(seg, s)
        seg = seg[:s] + seg[e:]
    return seg

def _strip_card(seg, kw):
    """剔除含 kw 的 card(洞察卡搬移防重复用)"""
    out = seg
    while True:
        i = out.find(kw)
        if i < 0:
            break
        cs = out.rfind('<div class="card', 0, i)
        if cs < 0:
            break
        ce = _match_div(out, cs)
        out = out[:cs] + out[ce:]
    return out

def r_reco_table(d):
    """板块一荐票表(统一表格样式, 2026-08-13用户拍板): 数据源=题材荐票_{d}.json发出版
    荐票+观察全入表(类型列区分); 理由/历史对照=发出版原文; 缺失=如实断档卡"""
    reco = load_json('题材荐票_%s.json', d)
    if not reco:
        return ('<div class="card" style="border-color:rgba(255,95,86,.35)"><b>⚠ 荐票发出版缺失</b>'
                '<p style="margin:6px 0 0">题材荐票_%s.json 不存在——当晚题材路发出版未落盘, 荐票表如实空缺(零编造, 不补造)。</p></div>' % d)
    recs = reco.get('荐票') or []
    obss = reco.get('观察') or []

    def _row(i, x, is_rec):
        nm = _esc(str(x.get('名称', '')))
        code = _esc(str(x.get('代码', '')))
        typ = x.get('类型') or ('荐票' if is_rec else '观察')
        typ_cell = '<b>%s</b>' % _esc(str(typ)) if is_rec else '<span class="mut">%s</span>' % _esc(str(typ))
        reason = _esc(str(x.get('理由', '')))
        hist = _esc(str(x.get('历史对照', '')))
        return ('<tr><td>%d</td>'
                '<td style="white-space:nowrap"><b>%s</b><br><span class="mut">%s</span></td>'
                '<td style="white-space:nowrap">%s</td>'
                '<td style="word-break:break-word">%s</td>'
                '<td style="word-break:break-word"><span class="mut" style="font-size:11px">%s</span></td></tr>'
                % (i, nm, code, typ_cell, reason, hist))

    rows = ''.join(_row(i, x, True) for i, x in enumerate(recs, 1))
    n = len(recs)
    rows += ''.join(_row(i, x, False) for i, x in enumerate(obss, n + 1))
    body = ('<div class="card"><table style="table-layout:fixed;width:100%%"><colgroup>'
            '<col style="width:24px"><col style="width:104px"><col style="width:52px"><col><col style="width:170px"></colgroup>'
            '<tr><th>#</th><th>标的</th><th>类型</th><th>荐票理由(身位·逻辑·执行口径)</th><th>历史对照</th></tr>%s</table></div>' % rows)
    hint = ('<div class="hint">发出版不可覆盖(题材荐票_%s.json); 荐票=龙头候选可结算化≠确认; '
            '结算=执行口径; 历史对照n=本路同类身位样本; 桶均值非个股预言</div>' % d)
    return body + chr(10) + hint

def r_insight(body):
    """提取"洞察(agent)"卡原文(bodies 任意位置→搬至荐票卡下方)"""
    for kw in ('洞察(agent)',):
        i = body.find(kw)
        if i < 0:
            return ''
        cs = body.rfind('<div class="card', 0, i)
        if cs < 0:
            return ''
        ce = _match_div(body, cs)
        return body[cs:ce] + (chr(10) if body[ce:ce + 1] == chr(10) else '')

def r_judge(body, d):
    """板块一 荐票卡: h2一 + 荐票表(发出版) + 洞察(agent) + 剩余卡(诚实标注/昨日对账, obs卡已表化剔除)"""
    i = body.find('<h2>一')
    if i < 0:
        return ''
    e = body.find('</h2>', i)
    if e < 0:
        return body[i:]
    h = body[i:e + 5]
    j = body.find('<h2>二', i)
    seg = body[e + 5:j if j > 0 else len(body)]
    seg = _strip_obs(seg)  # obs卡已被荐票表替代
    seg = _strip_card(seg, '洞察(agent)')  # 洞察卡移到荐票表后(防重复)
    return h + chr(10) + r_reco_table(d) + r_insight(body) + seg

def r_rank(body):
    """板块二 三级判定: h2二 → h2三"""
    return _h2_seg(body, '<h2>二', '<h2>三')

def r_life(body):
    """板块三 主流生命周期: h2三 → h2四"""
    return _h2_seg(body, '<h2>三', '<h2>四')

def r_leader(body):
    """板块四 龙头识别: h2四 → h2五"""
    return _h2_seg(body, '<h2>四', '<h2>五')

def r_scan(body):
    """板块五 自主深挖: h2五 → h2六"""
    return _h2_seg(body, '<h2>五', '<h2>六')

def r_cog(body, d=None):
    """板块六 认知迭代: h2六 → 尾; 模拟 _fold_tl(最新1条外露+其余折叠)
    ★2026-08-16: d 给定时丢弃 body 手写历史 tli(日期<d), 历史统一由 r_cog_lib 从认知库提供"""
    h6 = body.find('<h2>六')
    if h6 < 0: return ''
    head = body[h6:body.find('</h2>', h6) + 5] if body.find('</h2>', h6) > 0 else body[h6:]
    ts = body.find('<div class="tl">', h6)
    if ts < 0: return head
    te = _match_div(body, ts)
    seg = body[ts:te]
    items = []
    for m in re.finditer(r'<div class="tli(?:\s[^>]*)?">', seg):
        en = _match_div(seg, m.start())
        if en >= len(seg): break
        items.append(seg[m.start():en])
    if not items: return head
    newest = items[0]
    rest = items[1:]
    if d:
        today = '%s-%s' % (d[4:6], d[6:8])
        rest = [t for t in rest if _tli_date(t) >= today]
    out = head + '\n<div class="tl">%s</div>' % newest
    if rest:
        out += ('<details class="chain tlfold"><summary><b>当日更多认知</b> '
                '<span class="chip">%d条</span> <span class="mut">%s ~ %s</span></summary>'
                '<div class="inner"><div class="tl">%s</div></div></details>\n'
                % (len(rest), _tli_date(rest[-1]), _tli_date(rest[0]), ''.join(rest)))
    return out

# ============ 拼装器 ============
def build_page(d):
    """六板块 LLM 原文(黄金版保真; 板块一=荐票表+洞察+剩余卡)"""
    body = load_body(d)
    return ''.join([r_judge(body, d), r_rank(body), r_life(body),
                    r_leader(body), r_scan(body), r_cog(body, d) + r_cog_lib('theme', d)])

def build_page_full(d, paper_block=''):
    """完整页 body(头部区 + 机器数据折叠区 + 模拟盘看板 + 六板块) → S2 接线用
    头部区(bodies 开头 hero/kpi/stance)LLM 手写逐字节保真;
    机器区三卡收进 details.chain 折叠(默认收起) — ★2026-08-12 用户否"乱套":
      黄金版首屏=头部→荐票卡叙事流, 机器表卡不能抢占叙事位置(此前三卡+看板占首屏42KB,
      六板块被挤到页面底部仅18%) → 折叠后首屏恢复叙事, 机器数字作核对层展开可见
    模拟盘看板(paper_block)折叠外、h2一 前直接可见(内容非核对层, 对齐 lhb 验收基准)
    锚点(THEMEBATTLE/6YOU/FOURDIM/PAPERTRADE)成对保留供哨兵核对"""
    body = load_body(d)
    head = ''
    i2 = body.find('<h2>一')
    if i2 > 0:
        head = body[:i2] + '\n'
    head = _strip_card(head, '洞察(agent)')  # 洞察卡已移至板块一荐票表下方(防重复)
    mach = ''.join([r_mach_battle(d), r_mach_6you(d), r_mach_fourdim(d), r_mach_lifecycle(d)])
    if mach.strip():
        chips = '<span class="chip">%d卡</span>' % mach.count('class="card"')
        mach = ('<details class="chain"><summary><b>机器数据源</b> %s '
                '<span class="mut">归位/6有/四维数字核对层 · 展开查看 · 判断以六板块为准</span></summary>'
                '<div class="inner">\n%s</div></details>\n' % (chips, mach))
    # 模拟盘看板: 折叠外、h2一 前、直接可见 — ★2026-08-12 用户否"模拟实盘板块都丢了":
    # 看板是内容非核对层, 不能收进机器折叠(对齐 lhb 验收基准: hero→机器卡→看板展开→h2一)
    paper = ''
    if paper_block:
        paper = '<!--PAPERTRADE-->\n' + paper_block + '<!--/PAPERTRADE-->\n'
    return head + mach + paper + build_page(d)

