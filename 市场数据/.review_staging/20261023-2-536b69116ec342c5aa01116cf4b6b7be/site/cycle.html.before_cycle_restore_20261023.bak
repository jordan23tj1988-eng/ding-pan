e">09-30</text><text x="435.5" y="185" font-size="8.5" fill="#6b7683" text-anchor="middle">10-09</text><text x="517.5" y="185" font-size="8.5" fill="#6b7683" text-anchor="middle">10-13</text><text x="599.5" y="185" font-size="8.5" fill="#6b7683" text-anchor="middle">10-15</text><text x="681.5" y="185" font-size="8.5" fill="#6b7683" text-anchor="middle">10-19</text><text x="763.5" y="185" font-size="8.5" fill="#6b7683" text-anchor="middle">10-21</text><text x="845.5" y="185" font-size="8.5" fill="#6b7683" text-anchor="middle">10-23</text><text x="46" y="12" font-size="9" fill="#98a0ab">灰柱=净涨停数(剔ST,峰101) · 金线=1进2率(右满刻度47%)</text></svg><svg viewBox="0 0 880 182" style="width:100%;height:auto;display:block"><line x1="46" y1="88" x2="866" y2="88" stroke="#3a3f46"></line><text x="66.5" y="84" font-size="8" fill="#4a5666" text-anchor="middle">∅</text><rect x="96.8" y="85.4" width="21.3" height="2.6" rx="1.5" fill="#d64541"></rect><rect x="137.8" y="88.0" width="21.3" height="25.1" rx="1.5" fill="#2f9e6e"></rect><rect x="178.8" y="88.0" width="21.3" height="7.7" rx="1.5" fill="#2f9e6e"></rect><text x="230.5" y="84" font-size="8" fill="#4a5666" text-anchor="middle">∅</text><rect x="260.8" y="88.0" width="21.3" height="33.8" rx="1.5" fill="#2f9e6e"></rect><rect x="301.8" y="76.0" width="21.3" height="12.0" rx="1.5" fill="#d64541"></rect><rect x="342.8" y="88.0" width="21.3" height="3.6" rx="1.5" fill="#2f9e6e"></rect><rect x="383.8" y="88.0" width="21.3" height="21.5" rx="1.5" fill="#2f9e6e"></rect><rect x="424.8" y="78.0" width="21.3" height="10.0" rx="1.5" fill="#d64541"></rect><rect x="465.8" y="88.0" width="21.3" height="14.1" rx="1.5" fill="#2f9e6e"></rect><rect x="506.8" y="30.0" width="21.3" height="58.0" rx="1.5" fill="#d64541"></rect><text x="517.5" y="26.0" font-size="8.5" fill="#98a0ab" text-anchor="middle">+3.5</text><rect x="547.8" y="88.0" width="21.3" height="32.5" rx="1.5" fill="#2f9e6e"></rect><rect x="588.8" y="88.0" width="21.3" height="18.9" rx="1.5" fill="#2f9e6e"></rect><rect x="629.8" y="88.0" width="21.3" height="48.3" rx="1.5" fill="#2f9e6e"></rect><rect x="670.8" y="88.0" width="21.3" height="19.7" rx="1.5" fill="#2f9e6e"></rect><rect x="711.8" y="73.5" width="21.3" height="14.5" rx="1.5" fill="#d64541"></rect><rect x="752.8" y="84.5" width="21.3" height="3.5" rx="1.5" fill="#d64541"></rect><text x="804.5" y="84" font-size="8" fill="#4a5666" text-anchor="middle">∅</text><rect x="834.8" y="34.4" width="21.3" height="53.6" rx="1.5" fill="#d64541"></rect><text x="845.5" y="30.4" font-size="8.5" fill="#98a0ab" text-anchor="middle">+3.3</text><circle cx="640.5" cy="155" r="2.6" fill="#d9a441"></circle><circle cx="681.5" cy="155" r="2.6" fill="#d9a441"></circle><text x="107.5" y="168" font-size="8.5" fill="#6b7683" text-anchor="middle">09-22</text><text x="189.5" y="168" font-size="8.5" fill="#6b7683" text-anchor="middle">09-24</text><text x="271.5" y="168" font-size="8.5" fill="#6b7683" text-anchor="middle">09-28</text><text x="353.5" y="168" font-size="8.5" fill="#6b7683" text-anchor="middle">09-30</text><text x="435.5" y="168" font-size="8.5" fill="#6b7683" text-anchor="middle">10-09</text><text x="517.5" y="168" font-size="8.5" fill="#6b7683" text-anchor="middle">10-13</text><text x="599.5" y="168" font-size="8.5" fill="#6b7683" text-anchor="middle">10-15</text><text x="681.5" y="168" font-size="8.5" fill="#6b7683" text-anchor="middle">10-19</text><text x="763.5" y="168" font-size="8.5" fill="#6b7683" text-anchor="middle">10-21</text><text x="845.5" y="168" font-size="8.5" fill="#6b7683" text-anchor="middle">10-23</text><text x="46" y="12" font-size="9" fill="#98a0ab">昨停溢价=昨日涨停池今日开盘买→收盘均收(执行口径,%);红正绿负;金点=连负≥3日(洗出反弹窗条件)</text></svg><div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap"><div style="flex:1;min-width:190px;border:1px solid #33383f;border-radius:8px;padding:8px 10px"><div style="font-weight:700;font-size:13px;color:#5b636d">❄ 冰点进攻窗 · 灭</div><div style="font-size:11px;color:#5b636d;margin-top:2px">温度&lt;25 · A档:y1+0.30%/胜率60%(n=15/12段)</div></div><div style="flex:1;min-width:190px;border:1px solid #33383f;border-radius:8px;padding:8px 10px"><div style="font-weight:700;font-size:13px;color:#5b636d">☢ 过热禁追窗 · 灭</div><div style="font-size:11px;color:#5b636d;margin-top:2px">温度≥85 · A档:0/6全负·-1.86%</div></div><div style="flex:1;min-width:190px;border:1px solid #33383f;border-radius:8px;padding:8px 10px"><div style="font-weight:700;font-size:13px;color:#5b636d">♨ 洗出反弹窗 · —</div><div style="font-size:11px;color:#5b636d">溢价连负3日</div></div></div><div style="font-size:11px;color:#6b7683;margin-top:8px">读法:柱线剪刀口张开(涨停创高而金线趴地)=数量繁荣×接力冰点;三窗战绩=2025-07~2026-07单牛市周期回测,小样本,给环境判断不给指令。已证伪:复合&quot;冰点+≥2转机分量&quot;硬条件。</div></div><!--/LEADIND--></div><div class="card"><span id="claim-cycle-e020ed5d73967e19"></span></div><div class="" id="claim-cycle-eba83aaeb5addc5d"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">旧版原文补充</span></div><div class="card">
<div id="table-4302e2a86c4ebef5"><table><tr><th>指标</th><th>本日</th><th>昨日</th><th>Δ / 判读</th></tr><tr><td>一进二</td><td><b>9/24＝37.5%</b></td><td>14.7%（5/34）</td><td><b class="up">+22.8pp</b>，为昨日读数的2.5倍，是今日最强的一条腿</td></tr><tr><td>二进三</td><td><b>1/5＝20.0%</b></td><td>16.7%（2/12）</td><td class="up">+3.3pp，仍在低位（昨基数12只、今只剩5只）</td></tr><tr><td>三进四</td><td><b>0/2＝0%</b></td><td>0/1＝0%</td><td><b class="down">连续第2日归零</b>，昨3板2只（002076星光股份／600293三峡新材）全断</td></tr><tr><td>五进六</td><td><b>2/2＝100%</b></td><td>四进五 66.7%（2/3）</td><td class="up">双5板（002724／603278）双双续封，最高标续命率100%</td></tr><tr><td>昨涨停溢价</td><td><b class="up">+3.26%</b>（执行均收）</td><td>-1.69%（中位-3.30%、胜率34%、n=50）</td><td>由「深水」直接翻到「有肉」，是恐慌解除的最硬读数</td></tr><tr><td>核按钮</td><td><b class="up">1/33＝3.0%</b></td><td>12.0%（6/50）</td><td>回杀端从「1/6被核」收敛到「1/33」，抛压腿解除</td></tr><tr><td>昨涨停存活</td><td><b>12/33＝36.4%</b></td><td>9/50＝18.0%</td><td class="up">+18.4pp，隔日存活率翻倍</td></tr></table></div>
<p><b>三窗触发器：三窗全空</b>。①冰点进攻窗（温度&lt;25）＝<b>不触发</b>（53.2，昨日11.2触发过）；②过热禁追窗（温度≥85）＝不触发；③洗出反弹窗（昨停溢价连负3日）＝<b>不触发</b>（今日+3.26%转正，连负序列中断）。窗口空档本身是一条信息：<b>本日没有任何一条历史择时窗在喊方向，方向只能由结构腿自己给</b>——这正是本路把主判压在「修复」而不肯喊「发酵」的原因之一。</p>
<p><b>★冰点进攻窗首次样本结算（本路自凿的账，必须自己结）</b>：昨日温度11.2触发该窗，本路昨日写「首次样本，需记入窗触发准确率账本，不预设它有效」。今日结算读数＝昨涨停执行均收 <b>+3.26%</b>，回测基准为「冰点次日接力 y1 均+0.30%／胜率60%」，全样本基准 -0.21%／45% ⇒ <b>窗样本 #1 命中（n=1 池，累计窗样本16日）</b>。但记账只记方向，<b>不据此上调攻防</b>：窗测的是「次日接力收益」，攻防测的是「在什么环境里能下多大注」，两把尺子（此规则自20261022沿用，见七段迭代4）。</p>
<p><b>晋级端结构＝漏斗，不是正三角</b>：一进二37.5%说明「首板有承接」，二进三20%、三进四0%说明「承接不递进」，五进六100%说明「顶端在抱团」。三条同时成立的形态是<b>宽度型修复＋顶端抱团</b>：底部70只首板供给旺盛，中段（3→4→5板）真空，顶端2只6板靠存量资金续命。</p>
<div class="sup"><b>口径</b>：晋级四档全部由 20261023/zt_pool.csv（82行）× 20261022/zt_pool.csv（33行）逐码交集自算。今日 _情绪先行指标.json 的一进二0.375／二进三0.20 与逐码完全一致（滞后已自愈），但其「高度晋级率0.333」与逐码「五进六2/2＝100%」不同源（脚本口径含3板档整体），故页面四档一律用逐码值，脚本值只作旁证。</div></div></div></section><section id="stages"><h2>三 情绪五阶段 · 五路周期投票</h2><div class="card"><span id="claim-cycle-a927612c07ef7cd4"></span></div><div class="" id="claim-cycle-6346681609afcae6"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">旧版原文补充</span></div><div class="card">
<p><b>stage＝修复（第1日）</b>。三条判据同向：①<b>恐慌腿解除</b>——跌停6（前49）、核按钮3.0%（前12%）、炸板率12.8%（前41.1%，250日3.20%分位），§2.5「跌停≥两位数＝退潮／情绪恐慌」硬判据不再成立，昨日立下的「跌停面一票否决」本日未触发；②<b>温度回到中轴</b>——53.2 落40–65中档（250日58.40%分位），单日Δ+42.0 是「均值回归型」而非「加速型」；③<b>结构换形态</b>——昨日哑铃（1板24/2板5/3板2/5板2）今日变漏斗（1板70/2板9/3板1/6板2），底部大幅变宽、中段更窄、顶端由2只6板独占。</p>
<p><b>为什么不是「发酵」</b>（这是本日最需要回答的一问）：发酵（§3.1第2阶段·主升前）要求三件事同时成立——<b>梯队能递进＋质量能扛＋量能上台阶</b>。今日三条全缺：①递进断在3板之后（二进三20%、三进四0/2、4–5板0只）；②质量零跃迁（封单/流通中位0.937% vs 昨0.851%，+0.086pp；封单总额62.8亿只在250日41.60%分位；首封≥13:01占63.4%，钱是在午后补票不是在早盘抢筹）；③量能按当期口径只占3万亿退潮线65.2%。一进二翻倍只证明「首板有人接」，没证明「接力能递进」——<b>宽度是修复的证据，纵深才是发酵的证据</b>。</p>
<p><b>为什么不是「高潮」</b>：封板率87.2%确实踩到「极高」，但高封板率有两个来源——「钱在抢」与「没人砸」。今日封单总额62.8亿只到250日41.60%分位、炸0只43/82、首封午后63.4%，配合4–5板真空 ⇒ <b>这是「抛压消失型高封板率」，不是「承接挤压型」</b>。高潮的质量特征是「一字多＋早封多＋封单厚」，今日三样全反。线级的机器人（37只、二板8、线内晋级58.3%）另按主题路口径记「高潮段」，那是<b>一条线内部的阶段</b>，不升格为环境周期。</p>
<div id="table-9a4ed329616ba42f"><table><tr><th>路</th><th>档位/置信</th><th>该路口径下隐含的周期倾向</th><th>核心理由（各路独立写票）</th></tr><tr><td>①竞价 auction</td><td>B / 54</td><td><b>修复</b></td><td>池覆盖7/82＝8.5%（近8池日最低）、13:30后首封46.3%＝尾盘补涨型扩散；V型修复日执行全档37.1%/-0.28%，正期望只在gap&lt;5的可成交带</td></tr><tr><td>②席位 lhb</td><td>B / 60</td><td><b>修复</b></td><td>席位买五净额66.29亿（+90.7%）、股票级净额-0.90→+16.06亿，但S/A买额占全榜9.40%→5.59%、资金温度分位3→67落过热桶（45.7%）⇒「钱变多，但不是S/A的钱」＝扩散而非锁仓</td></tr><tr><td>③题材 theme</td><td>A / 78</td><td><b>高潮</b>（线级）</td><td>机器人37只/45.1%、6有6/6、二板8只、线内晋级7/12＝58.3%＞全场36.4%；但封单率中位0.89%与昨日同值、13:00后封板75.7%、开板占比0.43 ⇒ 主流成立＋阶段高潮，仓位含义是兑现</td></tr><tr><td>④产业逻辑 logic</td><td>B / 63</td><td><b>发酵</b>（宽度）</td><td>宽度5日9→18→4→13→37为序列新高；但真卡位（纯度≥50%）仅6/37＝16.22%（环比-6.86pp）、三季报∩模板∩涨停三交叉＝0 ⇒ 宽度真扩散、纯度反向稀释</td></tr><tr><td>⑤涨停质量 limitup</td><td>C / 76</td><td><b>修复（次日分化）</b></td><td>全池82只预测执1胜率max 46.2%、均43.25%、均涨-0.285%＝负期望；封板率87.2%≥米开80%分化线；窗口内同类冰点次日修复日2/2温度回落</td></tr></table></div>
<p><b>★「theme A 高潮」与「limitup C 负期望」同一天，我是怎么合的</b>——不合档、合对象。两条把守的是<b>两个不同的变量</b>：theme 的A裁「线」（机器人这条线在§3.1里走到第几阶段），limitup 的C裁「全池次日期望」（质量库基准 n=19342／43.0%／-0.33% 的结构性常数，用它定环境档会把每一天都判C）。同日为真不矛盾，因为它们是同一枚硬币的两面：<b>线在走高潮的宽度扩散，而全池的次日期望仍为负</b>。合成只做一件事——取两者的交集落点：宽度在（theme/logic 都认）、质量不在（theme封单0.89%、logic真卡位16.2%）、恐慌已解除（limitup 自己认核按钮3.0%、昨停溢价+3.26%）、量能未上台阶（19563亿＝3万亿线65.2%）。<b>四个条件放在一起，唯一能落的名是「修复」</b>：不因线级A升为「发酵」，也不因全池C降为「退潮」。计票：修复3（auction/lhb/limitup）／高潮1（theme，线级）／发酵1（logic，宽度单腿）＝3/5。三票同向可计一次交叉验证，但本路只给到置信63不给更高，因为精确同型样本仍不足。</p>
<div class="sup"><b>口径</b>：本段五票取自五路各自 <code>{auction,lhb,theme,logic,limitup}判断_20261023.json</code> 的 <code>判断.档位/置信度/结论</code> 原文，不由宿主转录；<b>投票截至 10-22</b>（_周期投票台账.jsonl 最新一行为 20261022，今日行待五路齐备后补录，故本页票面与台账存在一日时差，账户结算以台账为准）。<b>可证伪（合并式）</b>：若20261026 机器人线 二板≥12 ∧ 线内封单/流通中位≥1.5% ∧ 量能≥20000 三条同真 ⇒ theme 的「高潮」应升格为环境级「发酵」，本路主判记0.5错；反之若宽度环比≤-0.2 或 二板≤4 ⇒ 高潮段结束，limitup 的C口径胜出，本路仍判修复但须补一句「修复已过期」。</div></div></div></section><section id="ladder"><h2>四 连板梯队</h2><div class="card"><span id="claim-cycle-fbb16ad95c93bcc3"></span></div><div class="" id="claim-cycle-c3c568da36b7eefd"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">旧版原文补充</span></div><div class="card">
<div id="table-426d4738bf28a026"><table><tr><th>高度档</th><th>昨日</th><th>今日</th><th>逐码晋级</th></tr><tr><td>1板</td><td>24</td><td><b>70</b></td><td>一进二 <b class="up">9/24＝37.5%</b>（昨14.7%）</td></tr><tr><td>2板</td><td>5</td><td><b>9</b></td><td>二进三 <b>1/5＝20.0%</b>（昨16.7%）</td></tr><tr><td>3板</td><td>2</td><td><b>1</b></td><td>三进四 <b class="down">0/2＝0%</b>（昨0/1）</td></tr><tr><td>4板</td><td>0</td><td><b>0</b></td><td>四进五 无样本（昨3→5档发生于此）</td></tr><tr><td>5板</td><td>2</td><td><b>0</b></td><td>五进六 <b class="up">2/2＝100%</b></td></tr><tr><td>6板</td><td>0</td><td><b>2</b></td><td>—</td></tr></table></div>
<p><b>高度＝2只6板，但龙头未明牌</b>：002724 海洋王（炸5次／封单0.03亿＝成交0.20%／换手28.1%／首封09:53末封14:54）＝靠反复开板维持的烂板孤高；603278 大业股份（炸0／封单0.95亿＝流通1.738%／换手33.4%／首封13:09深水反包）＝硬封但换手崩。两只质量截然相反，正落 §3.1 第1阶段判据「龙头看不出→都铺」——<b>有高度、无龙头</b>，这是修复期而非主升期的身份证明。</p>
<p><b>宽度＝82只／18条方向，单极且散点化</b>：机器人37只（45.1%、28首板＋8二板＋1六板）、消费9只（9个环节＝拼盘、二板0）、数据要素4只（全炸板）、半导体4只（全首板）、金融科技4只；其余13条方向各≤3只。单极集中度45.1%说明方向明确，但<b>除机器人外没有任何一条线具备梯队（≥2板）</b>——次主线为0，与段一「容量只用1/2」互为印证。</p>
<p><b>梯队形状＝漏斗／哑铃叠加</b>：底部70只（85.4%）＋中段1只（3板）＋顶端2只（6板），4–5板全空。机器人线内部同样是「有底有顶无中段」：28首板／8二板／0三至五板／1六板。<b>这种形状在手册里的定位是「修复」而非「发酵」</b>：发酵的正三角是「1板多→2板有量→3板递进→高度自然长出」，而漏斗是「首板供给爆炸、中段被抽空、顶端靠存量维持」。今日中段只剩600838 上海九百一只（一般零售，一字092500／封单1.09亿／炸0／换手5.33%），它同时也是本日的<b>有效高度</b>——去掉2只6板孤峰后，市场真实身高只有3板。</p>
<p><b>换手与市值结构</b>：涨停池流通市值中位60.1亿（中小盘为主）；封单/成交中位9.33%、封单/流通中位0.937%——两个分母差10倍，任何「封单厚不厚」的结论都必须写明用的是哪个分母。</p></div></div></section><section id="position"><h2>五 攻防 · 仓位总开关</h2><div class="card"><span id="claim-cycle-7576972e4c64ca4d"></span></div><div class="" id="claim-cycle-dc18b9aaf649fc21"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">旧版原文补充</span></div><div class="card">
<p><b>本日开关：B中性 · 环境层净新增 0</b>。与总审 <b>B中性／58</b> 同档同向（本路置信63）。三个来源同向：①§3.3 三态落在「启动／混沌」与「退潮」之间的<b>中性档</b>——量能不在[3,3.3]万亿区间、然恐慌腿已解除，取最近档的上限但不上抬；②§3.2 周期级别＝小周期（有效高度3板、名义最高6板）→ 0–3成量级；③§2.3.1 台阶容量「1主线+1次主线」只用了1/2，次主线未立不能折成额度。三者取更低者＝<b>中性、不抬档</b>。</p>
<div id="table-1c6cba1693b83bb9"><table><tr><th>检查项（机械）</th><th>门槛</th><th>本日值</th><th>是否</th></tr><tr><td>温度</td><td>≥45</td><td>53.2</td><td>✓</td></tr><tr><td>涨停</td><td>≥70</td><td>82</td><td>✓</td></tr><tr><td>封板率</td><td>≥0.75</td><td>0.8723</td><td>✓</td></tr><tr><td>最高连板且≥2只</td><td>≥5</td><td>6（2只）</td><td>✓</td></tr><tr><td>二板加（2板及以上家数）</td><td>≥14</td><td><b>12</b></td><td><b class="down">✗ 差2只</b></td></tr><tr><td>量能</td><td>≥20000亿</td><td><b>19563亿</b></td><td><b class="down">✗ 差437亿</b></td></tr><tr><td colspan="3"><b>合计</b></td><td><b>4/6，抬档条件不成立</b></td></tr></table></div>
<p><b>★自认一处规则矛盾（不藏）</b>：我昨日写的「升档前置」第六条是「量能≥1.7万亿」，今日19563亿字面通过；按昨日原文今日应满足 5/6 而升档。本路不升，理由必须给：<b>门要随 stage 换代</b>——昨日那条门是「退潮期逃命门」（怕的是无量假修复），今日已进修复期，怕的东西变了，变成「有宽度没纵深」。所以修复期的否决腿换成 <b>二板加≥14</b>（纵深腿），并且它在修复期是<b>一票否决腿</b>：修复的核心命题就是「接力能不能接」，二板加12（昨9）虽然抬了3只，但 4–5板0只、三进四0/2，纵深切断，此项不过则不升档。此修订登记为 <b>MA-20261023-C1</b>，可证伪见下。</p>
<p><b>抬档前置（修复期·六条须同时，缺一即维持中性）</b>：温度≥45 且 涨停≥70 且 封板率≥0.75 且 最高连板≥5且≥2只 且 <b>二板加≥14</b> 且 <b>量能≥20000亿</b>（第六条的20000与总审次日验证点①完全对齐，便于同账结算）。本日满足4条。<b>降档／转防守触发（任一）</b>：涨停≤50 或 封板率≤0.65 或 跌停≥20 或 双6板全断且二板加&lt;6。</p>
<p><b>禁项（环境级，不涉个股、不是操作指令）</b>：①<b>不把「高封板率」读成「承接强」</b>——87.2%的封板率配的是62.8亿封单（250日41.60%分位），是抛压消失不是钱在抢；②<b>不补4–5板空档</b>——中段真空是结构事实，不是「欠涨」；③<b>不把6板当环境高度</b>——两只6板质量相反（一只炸5次薄封、一只炸0换手33%），有效高度只有3板；④<b>不把「放量涨」当攻击量</b>——量在9.48%分位；⑤<b>不做「修复次日必延续」外推</b>——封板率≥0.85 的18个历史样本里，次日封板率回落18/18、涨停减少15/18；⑥<b>不把线级A当环境A</b>——题材主流档(A)与环境进攻档(A)是两个变量，只有环境档参与额度乘法。</p>
<div class="sup"><b>与总审的一致性/分歧点登记</b>：一致＝同档（B中性）、同向（修复延续×高潮段分化）、同门（量能≥20000）。唯一差别是置信（本路63／总审58）与证据链侧重。可裁的分歧只剩一处且是单向的：<b>若明日四条同真（涨停≥70∧封板率≥0.80∧二板加≥14∧量能≥20000）而本路仍记中性 ⇒ 本路记「偏防守1档」；若明日涨停≤50 或 封板率≤0.65 而本路仍记中性 ⇒ 本路记「偏进攻1档」</b>。两条都来自总审次日验证点①，不额外自造口径。</div></div></div></section><section id="research"><h2>六 自主深挖 · 指标与阈值孵化</h2><div class="card"><span id="claim-cycle-89a0831c6c56d5e3"></span></div><div class="" id="claim-cycle-7094006288e782a7"><div class="claim-head"><span class="claim-role role-research">研究</span><span class="claim-source">旧版原文补充</span></div><div class="card">
<p><b>深挖1｜手册台阶表的「1.8–2.0万亿空档」（本日立项，复活搁置项）</b>：§2.3.1 五档为 &lt;1.3／1.3–1.5／1.5–1.7／1.7–1.8／2万亿+，<b>1.8–2.0万亿之间没有档位</b>，而今日19563亿正落此区间（距2万亿437亿）。这不是文字瑕疵：档位决定「能容几条主线」，空档等于这一段量能无法读数。<b>判据（可机械结算）</b>：20261026~20261106 若出现≥2次 1.8–2.0万亿日且其成型主线≥3条 ⇒ 补档「1.8–2.0万亿：1主线+2次」并提交拍板；若成型主线≤2条 ⇒ 空档并入1.7–1.8档，表不改、只加注边界。当前 n=1（本日）。对应孵化区原项 <b>cycle-量能台阶口径漂移监测</b>（20260812超截止自动搁置）以本条为复活入口。</p>
<p><b>深挖2｜「封板率≥0.85」次日桶（A档口径，宿主自算 303 日序列）</b>：n=<b>18</b>（20250707~20260929），次日<b>封板率回落 18/18＝100%</b>（中位Δ-12.80pp、均-16.0pp）、次日涨停减少 <b>15/18＝83.3%</b>（中位Δ-24.5只）、次日温度回落 <b>13/16＝81.2%</b>（剔除2个温度缺失日，中位Δ-17.95、均-17.51）。三个例外方向一致：20260430→0506（温度68.9→83.7、涨停100只）＝高潮加速段，20250911→0912（温度68.7→72.2）、20260929→0930（43.0→45.7）＝高位横。今日封板率0.8723 正落此桶 ⇒ <b>「明日封板率回落」是本路最有把握的一条机械预测（18/18），「温度回落」是81.2%的概率判断而非定论</b>。这就是本路 direction＝降(分化) 的全部依据，不含盘感。</p>
<p><b>深挖3｜「温度&lt;25 冰点」次日桶（与深挖2 反号，必须并报）</b>：n=<b>34</b>（全窗），次日温度<b>上修 31/34＝91.2%</b>（中位Δ+20.65）。与冰点进攻窗（回测 y1 均+0.30%／60%）同向但不同对象：桶测温度、窗测接力收益。<b>今日已出冰点区（53.2），明日不适用此桶</b>——把这条写进页面是为了防止明日误用：冰点桶的方向是「升」，封板率桶的方向是「降」，两者不冲突是因为样本日不同（今天既不是冰点日、也不是普通日，是「冰点次日」，属第三个桶）。</p>
<p><b>深挖4｜「温度-量能弹性」（孵化中指标）</b>：定义＝温度Δ ÷ 量能Δ%。今日 量能+27.97% → 温度+42.0 ⇒ 弹性 <b>+1.50点/%</b>；昨日 量能+6.95% → 温度-19.8 ⇒ 弹性 <b>-2.85点/%</b>。同一窗口两日符号相反，说明<b>温度不是量能的单调函数，而是「承接/抛压」的函数</b>。判据：建弹性序列，若冰点段（温度&lt;25）弹性均值显著高于中段（≥+1.0 vs &lt;0.5点/%）⇒ 定名「冰点非线性弹性」并入温度模型；若两段无显著差 ⇒ 该指标作废。</p>
<p><b>深挖5｜「封板率 vs 封单总额分位」背离指标（本日新孵化）</b>：今日封板率 <b>87.23%</b>（近8日最高）而封单总额62.8亿只到 <b>250日41.60%分位</b> —— 两者并列在0–100刻度上相差约 <b>45.6点</b>（<b>口径声明：前者是比率、后者是历史分位，不同量纲，本指标只是并列读数而非同量纲之差</b>，故只作定性分类用，不参与加权）。命名「<b>抛压消失型高封板率</b>」，它要回答的是「高封板率到底是钱抢来的还是没人砸」——这是本路今天判「不是高潮」的唯一量化支点。判据：明日若封板率回落≥12.8pp（该桶历史中位）且涨停≤60 ⇒ 该背离指标有效1次；若封板率不回落且封单总额分位抬到≥70 ⇒ 今日属「钱抢来的高封板率」，本路「不是高潮」的判断记0.5错。</p>
<p><b>深挖6｜「最高标续命率」孵化项结算（昨日立项）</b>：定义＝昨日≥4板者今日仍晋级占比。昨日2/3＝66.7%，今日 <b>2/2＝100%</b>。昨日设的组合判据「续命率≥50% 且 一进二&lt;20% 连续3日 ⇒ 定名『退潮期高标抱团』」——今日一进二37.5% 不满足，<b>组合本日不成立（0/3）</b>，孵化项保持「探索」不晋级。</p>
<div class="sup"><b>明日可机械结算的阈值（写进推演，供次日对账）</b>：修复→发酵确认＝<b>量能≥20000 ∧ 二板加≥14 ∧ 封单/流通中位≥1.5%</b>（三条同真）；修复→回落＝<b>涨停≤50 或 封板率≤0.65 或 跌停≥20</b>（任一）；中性维持＝其余。<b>附带自动读数</b>：封板率≥0.85桶预测明日封板率≤0.7443（今日0.8723-12.8pp）、温度中位53.2-17.95≈35.2——这两个数是本路明日的先验，不是承诺。</div></div></div></section><section id="cognition"><h2>七 我的认知迭代 · 最新</h2><div class="tl"><div class="card"><span id="claim-cycle-1412478a4909eb37"></span></div><div class="" id="claim-cycle-ff6f8c55c6b7e7ca"><div class="claim-head"><span class="claim-role role-cognition">认知</span><span class="claim-source">旧版原文补充</span></div><div class="tli"><div class="card">
<div class="mut">20261023 · 本日认知迭代 5 条 + 明日记账</div>
<p><b>迭代1｜昨日的方向票对了，但「阶段迁移图」缺一条边</b>：昨日 direction＝升(弱)、攻防D档≤2成。今日结算：温度Δ<b>+42.0</b>（死区±2之外）＝方向命中；昨日写的「修复确认＝跌停≤25 且 涨停≥45」今日 6／82 双重命中；但昨日写的「迁移确认：明日跌停≤25 且 温度仍&lt;25 → 改判冰点」<b>没有走通</b>——跌停是收敛到6了，温度却直接跳到53.2，<b>退潮没经过冰点稳态，一步跳到修复</b>。复盘根因：我的迁移图假设「退潮→冰点→启动」是顺序路径，而今日证明<b>放量型崩塌可以有直跳边</b>（昨日放量+994亿＝§2.3.3「放量跌＝筹码交换」，一日换手完成出清）。→ <b>机制修正（MA-20261023-C2）：新增迁移边「退潮→修复(一日)」，触发条件＝崩塌首日为放量下跌 ∧ 次日跌停收敛率≥80% ∧ 量能回补≥20%</b>（今日实测 49→6＝87.8%、15287→19563＝+27.97%，两条同真）。可证伪：下一次同型样本次日收敛率&lt;80% 或回补&lt;20% 而仍判修复 ⇒ 该边撤销。</p>
<p><b>迭代2｜门必须随 stage 换代，否则会被自己的旧门逼着加仓</b>：昨日「升档前置」写的是量能≥1.7万亿，按字面今日5/6通过，而我判中性——这不是自相矛盾，是<b>门的适用期过了</b>。退潮期的门防「无量假修复」，修复期的门要防「有宽度没纵深」，两者是不同的病。规则（MA-20261023-C1）：<b>攻防门槛随 stage 换代，且换代时须显式写出「本期的否决腿是哪一条」</b>；本期否决腿＝二板加≥14（纵深），一票否决。这条写进页面，是为了让明天的自己不能再拿旧门糊弄过去。</p>
<p><b>迭代3｜口径纪律第三次复发风险，今日全部双列</b>：「二板」与「二板加」（今日2板9只／二板加12只，差3只，混用会直接影响过不过门）、「封单/成交」与「封单/流通」（9.33% vs 0.937%，差10倍，只引一个会把薄封读成厚封）、「线内37只」与「全池82只」（theme的0.89%与全池0.937%是两个口径，都对）——三组今日在页面内全部并列标注分母。<b>规则：凡占比/中位/合计，必须带分母；跨路比较只允许同口径比。</b></p>
<p><b>迭代4｜方向票与攻防票继续分开记账，不为连续命中而上调攻防</b>：昨日升(弱)兑现+42.0，是方向票连续第2次命中。但今日 昨日涨停执1 只有+3.26%，且全池预测执1均涨仍为-0.285%（limitup）——<b>「温度升」与「钱没跟上」可以同时成立</b>，说明 direction 命中不等于「可下手」。规则沿用：direction 记方向账、攻防记环境账，两本账不互借；连续命中不构成上调攻防的理由（防止用胜率去偷仓位）。</p>
<p><b>迭代5｜本路历史命中率必须挂在墙上</b>：cycle主判 历史 n=40／命中19＝<b>47.5%</b>（_周期投票准确率.json）。这个数在六项里名义最高（auction 12/33＝36.4%、lhb 6/33＝18.2%、theme 12/33＝36.4%、logic 15/35＝42.9%、limitup 14/35＝40.0%），但<b>47.5% 只比抛硬币高2.5pp，且 n=40 里含多次方向与阶段混判</b>——它不是「本路可信」的证据，反而是「本路没有资格自信」的证据。所以本日置信只给63、不给70+：<b>读数清楚不等于判读准，历史命中率是唯一能约束自信的锚</b>。同时这条也校正一个易犯的谬误：不能因为本路命中率名义最高，就在合并五路时给 cycle 更高权重——六项里没有一项超过50%，权重只应由样本量与口径稳定性决定。</p>
<div class="sup"><b>明日记账</b>：今日 stage＝修复、direction＝降(分化)、攻防＝B中性。结算规则＝20261026 收盘后比①温度Δ（±2死区）②封板率是否≤0.7443 ③涨停是否减少≥24只 ④四条抬档门是否同真。证伪条件：量能≥20000∧二板加≥14∧封单中位≥1.5%（应改判发酵，本路记0.5错）；涨停≤50 或 封板率≤0.65 或 跌停≥20（应改判退潮，本路记全错）。</div></div></div></div></div></section><details class="chain"><summary>编辑说明与来源审计</summary><div class="inner"><div class="claim-anchor-bank" aria-hidden="true"><pre class="claim-anchor-text">Cycle · 周期与情绪 · 截至 2026-10-23 收盘
修复 · 第1日
一 量能台阶我站在哪一阶
二 情绪先行指标 · 三窗触发器
