def _strip_obs(seg):
    """逐卡剔除 <div class="obs">...</div>(配平嵌套div)"""
    while True:
        s = seg.find('<div class="obs">')
        if s < 0:
            break
        e = _match_div(seg, s)
        seg = seg[:s] + seg[e:]
    return seg

def _strip_card(seg, kw):
    """剔除含 kw 的 card(洞察卡搬移防重复用)"""
    out = seg
    while True:
        i = out.find(kw)
        if i < 0:
            break
        cs = out.rfind('<div class="card', 0, i)
        if cs < 0:
            break
        ce = _match_div(out, cs)
        out = out[:cs] + out[ce:]
    return out

def r_reco_table(d):
    """板块一荐票表(统一表格样式, 2026-08-13用户拍板): 数据源=题材荐票_{d}.json发出版
    荐票+观察全入表(类型列区分); 理由/历史对照=发出版原文; 缺失=如实断档卡"""
    reco = load_json('题材荐票_%s.json', d)
    if not reco:
        return ('<div class="card" style="border-color:rgba(255,95,86,.35)"><b>⚠ 荐票发出版缺失</b>'
                '<p style="margin:6px 0 0">题材荐票_%s.json 不存在——当晚题材路发出版未落盘, 荐票表如实空缺(零编造, 不补造)。</p></div>' % d)
    recs = reco.get('荐票') or []
    obss = reco.get('观察') or []

    def _row(i, x, is_rec):
        nm = _esc(str(x.get('名称', '')))
        code = _esc(str(x.get('代码', '')))
        typ = x.get('类型') or ('荐票' if is_rec else '观察')
        typ_cell = '<b>%s</b>' % _esc(str(typ)) if is_rec else '<span class="mut">%s</span>' % _esc(str(typ))
        reason = _esc(str(x.get('理由', '')))
        hist = _esc(str(x.get('历史对照', '')))
        return ('<tr><td>%d</td>'
                '<td style="white-space:nowrap"><b>%s</b><br><span class="mut">%s</span></td>'
                '<td style="white-space:nowrap">%s</td>'
                '<td style="word-break:break-word">%s</td>'
                '<td style="word-break:break-word"><span class="mut" style="font-size:11px">%s</span></td></tr>'
                % (i, nm, code, typ_cell, reason, hist))

    rows = ''.join(_row(i, x, True) for i, x in enumerate(recs, 1))
    n = len(recs)
    rows += ''.join(_row(i, x, False) for i, x in enumerate(obss, n + 1))
    body = ('<div class="card"><table style="table-layout:fixed;width:100%%"><colgroup>'
            '<col style="width:24px"><col style="width:104px"><col style="width:52px"><col><col style="width:170px"></colgroup>'
            '<tr><th>#</th><th>标的</th><th>类型</th><th>荐票理由(身位·逻辑·执行口径)</th><th>历史对照</th></tr>%s</table></div>' % rows)
    hint = ('<div class="hint">发出版不可覆盖(题材荐票_%s.json); 荐票=龙头候选可结算化≠确认; '
            '结算=执行口径; 历史对照n=本路同类身位样本; 桶均值非个股预言</div>' % d)
    return body + chr(10) + hint

