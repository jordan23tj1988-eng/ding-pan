S-20260907-003", "指派给": "lhb", "深挖任务": "敦煌种业S档样本扩大验证：读_席位动向/20260908.csv，若现非小样本S档(n≥25)坐镇敦煌种业且股票级净买≥1000万同向率≥50%→升B轻仓；否则维持C。", "理由": "资金升温已兑现但S档样本质量未过，敦煌种业是资金路唯一候选。", "截止": "20260908", "状态": "待承接"}, "status": "unverifiable", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "AS-20260907-004", "d": "20260907", "due_d": "20260908", "source": "总审_20260907.json#指派清单/3", "original": {"指派ID": "AS-20260907-004", "指派给": "limitup", "深挖任务": "负期望第16日终结验证：读涨停质量荐票_20260908.json，若全池执1max≥48.2%且命中≥3且池均≥0→负期望终结升B/A；否则维持C。", "理由": "强力反弹后封板质量能否跟上，是负期望链条能否终结的判据。", "截止": "20260908", "状态": "待承接"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "AS-20260907-005", "d": "20260907", "due_d": "20260908", "source": "总审_20260907.json#指派清单/4", "original": {"指派ID": "AS-20260907-005", "指派给": "auction", "深挖任务": "竞价池封板率验证：读竞价池结算_20260907.json，若执行均收>0且封板率≥50%→反转日买新不买旧终结升B/A；否则维持C。", "理由": "0904池均收+4.41%转正但封板率28.6%未过，明日封板率是否补上决定反转日铁律能否终结。", "截止": "20260908", "状态": "待承接"}, "status": "unverifiable", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "master-20260911-theme-01", "d": "20260911", "due_d": "20260914", "source": "总审_20260911.json#指派清单/0", "original": {"判定条件": "涨停>=5且>=3板且有公告", "状态": "待承接", "理由": "9只聚集但无梯队", "指派给": "theme", "指派ID": "master-20260911-theme-01", "深挖任务": "核验元件主线", "截止": "20260914"}, "status": "unverifiable", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "master-20260921-01", "d": "20260921", "due_d": "20260922", "source": "总审_20260921.json#指派清单/0", "original": {"指派ID": "master-20260921-01", "指派给": "master", "深挖任务": "补齐缺失源后重新跑事实层与相应命门路", "理由": "当日9:25竞价动态轨迹/竞价撤单差分/中报预增雷达缺失,事实层与竞价、质量路口径受影响", "判定条件": "缺失源补齐后重跑事实层与相应命门路:核对器逐个通过且关键数字(涨停103/温度63.2/最高5板)不变", "截止": "20260922", "状态": "待承接"}, "status": "unverifiable", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "master-20260921-02", "d": "20260921", "due_d": "20260922", "source": "总审_20260921.json#指派清单/1", "original": {"指派ID": "master-20260921-02", "指派给": "master", "深挖任务": "下一交易日结算本次可证伪条件", "理由": "当日推演的可证伪预判需次日按判定条件结算,否则预测闭环断链", "判定条件": "按推演_20260921.json逐条判定条件结算得 true/false 并写入结算记录", "截止": "20260922", "状态": "待承接"}, "status": "unverifiable", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "master-20260921-03", "d": "20260921", "due_d": "20260922", "source": "总审_20260921.json#指派清单/2", "original": {"指派ID": "master-20260921-03", "指派给": "master", "深挖任务": "确认正式发布版本与哨兵结果后再对外宣称完成", "理由": "发布门禁与哨兵必须真实通过,不得以进程退出码或阶段性成功代替验收", "判定条件": "build manifest status=pass 且发布后哨兵0 FAIL,现站页面更新到当日", "截止": "20260922", "状态": "待承接"}, "status": "unverifiable", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "M-20260922-01", "d": "20260922", "due_d": "20260923", "source": "总审_20260922.json#指派清单/0", "original": {"指派ID": "M-20260922-01", "指派给": "auction", "深挖任务": "复核明日冻结竞价池与实际开盘闸门：区分一字/高开强度、可成交性、分时承接和炸板扩散，输出闸门通过或不通过。", "理由": "本日17只冻结池中16只高开≥5%的集中现象与历史高开负收益并存，存在强度被误读为收益的盲区。依据：D:/股票数据/市场数据/_学习/auction判断_20260922.json；D:/股票数据/市场数据/_学习/auction_body_20260922.html。", "截止": "20260923", "状态": "待承接"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "M-20260922-02", "d": "20260922", "due_d": "20260923", "source": "总审_20260922.json#指派清单/1", "original": {"指派ID": "M-20260922-02", "指派给": "lhb", "深挖任务": "跟踪000756新华制药及华仁药业的股票级净买、有效S/A席位方向与收盘结果，复核双源一致是否能跨越高位和小样本门。", "理由": "双源可比52中有8强矛盾、14分歧、10打折，源2又天然偏买；B档局部增量必须接受净买和位置的次日结算。依据：D:/股票数据/市场数据/_学习/龙虎榜双源校验_20260922.json。", "截止": "20260923", "状态": "待承接"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "M-20260922-03", "d": "20260922", "due_d": "20260923", "source": "总审_20260922.json#指派清单/2", "original": {"指派ID": "M-20260922-03", "指派给": "theme", "深挖任务": "用宽度环比、开板占比、题材晋级率三口径重算家居用品与出版，明确机械发酵、强分支、主线三者边界；缺失字段必须写null。", "理由": "家居用品宽度环比为正但开板占比0.40且晋级率未给，出版晋级率1.0但宽度仅4；当前‘发酵’存在定义放宽风险。依据：D:/股票数据/市场数据/_学习/theme判断_20260922.json；D:/股票数据/市场数据/_学习/题材归位_20260922.json。", "截止": "20260923", "状态": "待承接"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "M-20260922-04", "d": "20260922", "due_d": "20260923", "source": "总审_20260922.json#指派清单/3", "original": {"指派ID": "M-20260922-04", "指派给": "logic", "深挖任务": "复核宏英智能与日海智能的业绩记录是否补齐双源字段，并检查风险日历未接入维度；只有同链跨环节扩散或A档证据出现才允许升级。", "理由": "当前两票均为1板B档观察，预增/扭亏并非双源确认；风险日历未覆盖财报披露、股东大会、业绩预告。依据：D:/股票数据/市场数据/_学习/logic判断_20260922.json；D:/股票数据/市场数据/_学习/风险日历_20260922.json。", "截止": "20260923", "状态": "待承接"}, "status": "unverifiable", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "M-20260922-05", "d": "20260922", "due_d": "20260923", "source": "总审_20260922.json#指派清单/4", "original": {"指派ID": "M-20260922-05", "指派给": "limitup", "深挖任务": "结算全池T+1执行均收、炸板率、板级梯队及孤立6板风险，重点检查全池转正、3板中性桶和4板以上扩宽是否同时出现。", "理由": "今日最高板抬升但全池执1均收-0.31%、炸板率22.2%、4板以上仅3只，需防止把高度单点修复当成质量修复。依据：D:/股票数据/市场数据/_学习/limitup判断_20260922.json；D:/股票数据/市场数据/20260922/summary.json。", "截止": "20260923", "状态": "待承接"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20260923-01", "d": "20260923", "due_d": "20260924", "source": "总审_20260923.json#指派清单/0", "original": {"指派ID": "MA-20260923-01", "指派给": "auction", "深挖任务": "对20260924竞价池逐票执行开盘至收盘结算，分拆一字、高开≥5%、温和高开和低开四桶，报告全池执行均收、炸板率和闸门是否通过；不得把池内结果外推全市场。", "理由": "今日竞价强度与可执行收益分离，且撤单差分和分时承接缺失，需要补齐可结算闸门。", "截止": "20260924", "状态": "待承接"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20260923-02", "d": "20260923", "due_d": "20260924", "source": "总审_20260923.json#指派清单/1", "original": {"指派ID": "MA-20260923-02", "指派给": "lhb", "深挖任务": "补做20260923龙虎榜双源校验，复核301150、600371、600503及冲突票的股票级净买、有效S/A席位和20260924收盘结果，明确哪些仍为观察。", "理由": "指定双源文件缺失；当前人工替代复核不能升级为完整双源结论。", "截止": "20260924", "状态": "待承接"}, "status