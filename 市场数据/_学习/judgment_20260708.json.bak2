.5%</td><td>3.35%</td></tr><tr><td>超强≥4%</td><td>38</td><td>68.4%</td><td class=\"ret\">5.02%</td><td>61.8%</td><td>7.03%</td></tr></table><h3 style=\"font-size:13.5px;margin-top:10px\">首封时间(最强单因子)</h3><table><tr><th>档</th><th>n</th><th>T1胜率</th><th>T1均涨</th><th>T2胜率</th><th>T2均涨</th></tr><tr><td>一字≤9:25</td><td>95</td><td>76.8%</td><td class=\"ret\">5.21%</td><td>65.2%</td><td>6.41%</td></tr><tr><td>早盘≤10:00</td><td>556</td><td>54.0%</td><td class=\"ret\">1.21%</td><td>50.3%</td><td>0.89%</td></tr><tr><td>盘中&gt;10:00</td><td>840</td><td>54.8%</td><td class=\"ret\">1.28%</td><td>53.4%</td><td>1.31%</td></tr><tr><td>秒板≤9:31</td><td>104</td><td>51.9%</td><td class=\"ret\">1.5%</td><td>56.4%</td><td>1.96%</td></tr></table><h3 style=\"font-size:13.5px;margin-top:10px\">连板层</h3><table><tr><th>档</th><th>n</th><th>T1胜率</th><th>T1均涨</th><th>T2胜率</th><th>T2均涨</th></tr><tr><td>2板</td><td>189</td><td>58.2%</td><td class=\"ret\">1.81%</td><td>56.8%</td><td>1.86%</td></tr><tr><td>3板+</td><td>62</td><td>64.5%</td><td class=\"ret\">3.35%</td><td>70.0%</td><td>5.63%</td></tr><tr><td>首板</td><td>1344</td><td>54.8%</td><td class=\"ret\">1.37%</td><td>51.9%</td><td>1.26%</td></tr></table><h3 style=\"font-size:13.5px;margin-top:10px\">★交叉:首封×封单(天花板=一字×封单≥2%)</h3><table><tr><th>档</th><th>n</th><th>T1胜率</th><th>T1均涨</th><th>T2胜率</th><th>T2均涨</th></tr><tr><td>一字≤9:25 × 封单&lt;2%</td><td>55</td><td>67.3%</td><td class=\"ret\">2.73%</td><td>59.6%</td><td>3.32%</td></tr><tr><td>一字≤9:25 × 封单≥2%</td><td>40</td><td>90.0%</td><td class=\"ret\">8.62%</td><td>73.0%</td><td>10.77%</td></tr><tr><td>早盘≤10:00 × 封单&lt;2%</td><td>509</td><td>53.2%</td><td class=\"ret\">1.13%</td><td>49.8%</td><td>0.86%</td></tr><tr><td>早盘≤10:00 × 封单≥2%</td><td>47</td><td>61.7%</td><td class=\"ret\">2.15%</td><td>55.6%</td><td>1.31%</td></tr><tr><td>盘中&gt;10:00 × 封单&lt;2%</td><td>806</td><td>54.8%</td><td class=\"ret\">1.29%</td><td>53.1%</td><td>1.32%</td></tr><tr><td>盘中&gt;10:00 × 封单≥2%</td><td>34</td><td>52.9%</td><td class=\"ret\">0.91%</td><td>59.4%</td><td>0.95%</td></tr><tr><td>秒板≤9:31 × 封单&lt;2%</td><td>98</td><td>51.0%</td><td class=\"ret\">1.33%</td><td>55.2%</td><td>1.69%</td></tr></table><p class=\"mut\" style=\"font-size:12px;margin-top:8px\">每日18:00随新涨停的T+1/T+2兑现滚动重训;当日涨停无前向不入库=零后视镜。可执行性打折:封死票T收买不进,真实T+1开盘介入。</p></div></details>"
