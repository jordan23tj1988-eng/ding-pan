def _core_stocks(d):
    """核心标的: 题材归位(大方向映射) + zt_pool(名称/连板/封单/炸板) 逐题材取前3
    口径: 连板数降序 → 封板资金降序 → 炸板次数升序, 取前3(不足则全列)。
    返回 {题材线: [(名称, 连板数), ...]}, 数据缺=空dict(零编造, 渲染侧显示 —)。"""
    import csv
    rg = load_json('题材归位_%s.json', d)
    if not rg:
        return {}
    mp = rg.get('映射') or {}
    zp = os.path.join(BASE, d, 'zt_pool.csv')
    if not os.path.isfile(zp):
        return {}
    zt = {}
    try:
        with open(zp, encoding='utf-8-sig') as f:
            for row in csv.DictReader(f):
                code = row.get('代码') or ''
                try:
                    lb = int(row.get('连板数') or 0)
                except (ValueError, TypeError):
                    lb = 0
                try:
                    fb = float(row.get('封板资金') or 0)
                except (ValueError, TypeError):
                    fb = 0.0
                try:
                    zb = int(row.get('炸板次数') or 0)
                except (ValueError, TypeError):
                    zb = 0
                zt[code] = (row.get('名称') or code, lb, fb, zb)
    except Exception:
        return {}
    from collections import defaultdict
    lines = defaultdict(list)
    for code, v in mp.items():
        ln = v.get('大方向') if isinstance(v, dict) else ''
        if ln and code in zt:
            lines[ln].append(zt[code])
    core = {}
    for ln, stocks in lines.items():
        stocks.sort(key=lambda x: (-x[1], -x[2], x[3]))
        core[ln] = [(nm, lb) for nm, lb, fb, zb in stocks[:3]]
    return core


