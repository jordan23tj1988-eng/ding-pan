8.0" width="21.3" height="39.0" rx="1.5" fill="#2f9e6e"></rect><rect x="178.8" y="88.0" width="21.3" height="21.5" rx="1.5" fill="#2f9e6e"></rect><rect x="219.8" y="88.0" width="21.3" height="47.7" rx="1.5" fill="#2f9e6e"></rect><rect x="260.8" y="72.8" width="21.3" height="15.2" rx="1.5" fill="#d64541"></rect><rect x="301.8" y="88.0" width="21.3" height="5.2" rx="1.5" fill="#2f9e6e"></rect><rect x="342.8" y="88.0" width="21.3" height="14.8" rx="1.5" fill="#2f9e6e"></rect><rect x="383.8" y="88.0" width="21.3" height="58.0" rx="1.5" fill="#2f9e6e"></rect><text x="394.5" y="156.0" font-size="8.5" fill="#98a0ab" text-anchor="middle">-2.6</text><rect x="424.8" y="88.0" width="21.3" height="11.4" rx="1.5" fill="#2f9e6e"></rect><text x="476.5" y="84" font-size="8" fill="#4a5666" text-anchor="middle">∅</text><rect x="506.8" y="84.4" width="21.3" height="3.6" rx="1.5" fill="#d64541"></rect><rect x="547.8" y="88.0" width="21.3" height="34.3" rx="1.5" fill="#2f9e6e"></rect><rect x="588.8" y="88.0" width="21.3" height="10.5" rx="1.5" fill="#2f9e6e"></rect><text x="640.5" y="84" font-size="8" fill="#4a5666" text-anchor="middle">∅</text><rect x="670.8" y="88.0" width="21.3" height="46.1" rx="1.5" fill="#2f9e6e"></rect><rect x="711.8" y="71.7" width="21.3" height="16.3" rx="1.5" fill="#d64541"></rect><rect x="752.8" y="88.0" width="21.3" height="4.9" rx="1.5" fill="#2f9e6e"></rect><rect x="793.8" y="74.3" width="21.3" height="13.7" rx="1.5" fill="#d64541"></rect><text x="845.5" y="84" font-size="8" fill="#4a5666" text-anchor="middle">∅</text><circle cx="189.5" cy="155" r="2.6" fill="#d9a441"></circle><circle cx="230.5" cy="155" r="2.6" fill="#d9a441"></circle><circle cx="394.5" cy="155" r="2.6" fill="#d9a441"></circle><circle cx="435.5" cy="155" r="2.6" fill="#d9a441"></circle><text x="107.5" y="168" font-size="8.5" fill="#6b7683" text-anchor="middle">09-01</text><text x="189.5" y="168" font-size="8.5" fill="#6b7683" text-anchor="middle">09-03</text><text x="271.5" y="168" font-size="8.5" fill="#6b7683" text-anchor="middle">09-07</text><text x="353.5" y="168" font-size="8.5" fill="#6b7683" text-anchor="middle">09-09</text><text x="435.5" y="168" font-size="8.5" fill="#6b7683" text-anchor="middle">09-11</text><text x="517.5" y="168" font-size="8.5" fill="#6b7683" text-anchor="middle">09-22</text><text x="599.5" y="168" font-size="8.5" fill="#6b7683" text-anchor="middle">09-24</text><text x="681.5" y="168" font-size="8.5" fill="#6b7683" text-anchor="middle">09-28</text><text x="763.5" y="168" font-size="8.5" fill="#6b7683" text-anchor="middle">09-30</text><text x="845.5" y="168" font-size="8.5" fill="#6b7683" text-anchor="middle">10-12</text><text x="46" y="12" font-size="9" fill="#98a0ab">昨停溢价=昨日涨停池今日开盘买→收盘均收(执行口径,%);红正绿负;金点=连负≥3日(洗出反弹窗条件)</text></svg><div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap"><div style="flex:1;min-width:190px;border:1px solid #33383f;border-radius:8px;padding:8px 10px"><div style="font-weight:700;font-size:13px;color:#5b636d">❄ 冰点进攻窗 · —</div><div style="font-size:11px;color:#5b636d">温度&lt;25</div></div><div style="flex:1;min-width:190px;border:1px solid #33383f;border-radius:8px;padding:8px 10px"><div style="font-weight:700;font-size:13px;color:#5b636d">☢ 过热禁追窗 · —</div><div style="font-size:11px;color:#5b636d">温度≥85</div></div><div style="flex:1;min-width:190px;border:1px solid #33383f;border-radius:8px;padding:8px 10px"><div style="font-weight:700;font-size:13px;color:#5b636d">♨ 洗出反弹窗 · —</div><div style="font-size:11px;color:#5b636d">溢价连负3日</div></div></div><div style="font-size:11px;color:#6b7683;margin-top:8px">读法:柱线剪刀口张开(涨停创高而金线趴地)=数量繁荣×接力冰点;三窗战绩=2025-07~2026-07单牛市周期回测,小样本,给环境判断不给指令。已证伪:复合&quot;冰点+≥2转机分量&quot;硬条件。</div></div><!--/LEADIND--></div><div class="card"><div class="" id="claim-cycle-dd34fb56ba245303"><div class="claim-head"><span class="claim-role role-verdict">结论</span><span class="claim-source">判断 · 结论</span></div><p class="mut">判断 · 结论</p><p>退潮/降，置信度68。量能15378亿（约1.54万亿）跌破规则表3万亿退潮线且环比缩量19.1%，温度32.4偏冷（前值49.6），跌停19达两位数退潮线，封板率64.79%仅高于『≤64%=退潮』线0.79pp，梯队4/5/7/8/9板断层，题材来源档A=0无确认主线；五路5票一致退潮/降。攻防总开关=C档退潮防守，总仓位上限2成（0-2成），禁套利。</p></div><div class="" id="claim-cycle-ff1110a8e9d1da68"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">判断 · 证据</span></div><p class="mut">判断 · 证据</p><p>两市成交额15378.0亿元，约1.5378万亿元，落规则表『1.5-1.7万亿:1主线+1次』台阶档；远低于2026.6起中枢3万亿+口径的要看多3.3万亿+/主升3.5万亿+门槛，且已跌破『跌破3万亿=退潮线』。环比前一交易日20261009的19005.0亿元为-19.1%（缩量）。按规则表量能→高度（1.3万亿:7-9板、1.7万亿:9-11板）线性插值，15378亿对应理论上限约8-10板，当日最高10板已贴该上限。</p></div><div class="" id="claim-cycle-1fcc26f0f688f2cf"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">判断 · 证据</span></div><p class="mut">判断 · 证据</p><p>温度32.4（前值49.6，-17.2点）落偏冷档；涨停46（69→46，-33.3%）、炸板25（14→25）、跌停19（8→19，达规则表『跌停≥两位数=退潮/恐慌』）、炸板率35.2%（16.9%→35.2%）、封板率64.79%（46/(46+25)，仅高于规则表『≤64%=退潮』线0.79pp）、回封26、二板加18、最高板10（前值9）、封板总额47.1亿（61.6→47.1，-23.5%）。炸板率35.2%未越过规则表『&gt;50%接力生态弱』线。</p></div><div class="" id="claim-cycle-004d7e607fe54d1e"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">判断 · 证据</span></div><p class="mut">判断 · 证据</p><p>一进二率源值0.273、二进三率0.1、高度晋级率0.267（前值0.4）、核按钮率0.042（昨日涨停48只、今日跌停回杀2只）；昨日涨停溢价=null、触发器=[]，三窗触发器（冰点进攻窗/过热禁追窗/洗出反弹窗）当日不可判。源表晋级明细为首板28+二连板9+三连板1=38只，与涨停46只不自洽（温度表2板为14只），一进二率源值0.273与『今日二连板14/昨首板57≈24.6%』不符，按口径存疑只作方向参考、不用于定量。</p></div><div class="" id="claim-cycle-35541fa53f50b519"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">判断 · 证据</span></div><p class="mut">判断 · 证据</p><p>涨停池46只（zt_pool逐行统计，与温度表梯队一致）：10板1、6板2、3板1、2板14、首板28；4板、5板、7板、8板、9板全部缺档＝中位断层。最高10板新华传媒（出版·传媒重组，09:25:02一字首封、炸板0次、封板资金10.165亿元，占全场封板总额47.1亿的21.6%），6板为九阳股份（小家电/机器人，炸板5次）与时代万恒（电池），3板为华北制药（化学制药，炸板2次）＝高标孤峰+中位无承接。</p></div><div class="" id="claim-cycle-c8e9fa0cdfda8b8b"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">判断 · 证据</span></div><p class="mut">判断 · 证据</p><p>题材归位覆盖46/46，来源档A/B/C=0/46/0（全部为当日同花顺涨停原因，THS编辑聚合，无公告级证据）；无可确认主线：行业口径最高出版6只（得分4、大分支）、聚类口径最高医药4/6（大分支）与传媒重组3/6（分支，高度10），均未过六有阈值（宽度15/容量200亿）。题材四维显示缩圈：固态电池宽度环比-0.667（触发『缩圈』警报）、网络安全-0.75、锂电池-0.5、AI短剧-0.25、AI漫剧-0.2；仅传媒重组+2.0、AI应用+0.333。</p></div><div class="" id="claim-cycle-53e0bd53e8c697ab"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">判断 · 证据</span></div><p class="mut">判断 · 证据</p><p>五路全部投票、零弃权，且方向完全一致：auction=退潮/降62，lhb=退潮/降58，theme=退潮/降72，logic=退潮/降72，limitup=退潮/降78。阶段票退潮5，方向票降5；方向票中无平、无升。一致率100%触发回声室警示，故cycle不将一致性本身当作验证，另用本路私有底座复核：量能跌破3万亿退潮线、跌停19达两位数、封板率64.79%紧贴64%退潮线、梯队4/5/7/8/9板断层、核按钮率4.2%。</p></div><div class="" id="claim-cycle-00123b8844312193"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">判断 · 证据</span></div><p class="mut">判断 · 证据</p><p>主判退潮/降，置信度68（=五路加权均值68.4取整；因一致率100%触发回声室警示故不上浮，也不因单点10板孤峰下修）。依据：量能15378亿跌破3万亿退潮线且缩量19.1%、温度32.4偏冷、跌停19达两位数、封板率64.79%贴退潮线、梯队4/5/7/8/9板断层、题材A档=0无确认主线；同时如实记录未触发项——炸板率35.2%未过50%接力弱线、一进二率源值未跌破10%接力冰点线、温度未跌破25冰点进攻窗。环境开关=C档退潮防守，总仓位上限2成（0-2成），禁套利；cycle只做环境判定，不荐个股、不写交易计划。</p></div><div class="" id="claim-cycle-00af9ab120ce9310"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">判断 · 档位</span></div><p class="mut">判断 · 档位</p><p>C</p></div><div class="" id="claim-cycle-873be5c8982c74c8"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">判断 · 置信度</span></div><p class="mut">判断 · 置信度</p><p>68</p></div><div class="" id="claim-cycle-7f3d0184e0f897d9"><div class="claim-head"><span class="claim-role role-condition">条件</span><span class="claim-source">判断 · 可证伪条件</span></div><p class="mut">判断 · 可证伪条件</p><p>若次日出现：温度回抬至中性档（≥40）且跌停回落至个位数、封板率站上80%、成交额重回3万亿元门槛之上，同时4-5板断层由真实梯队补齐、题材出现同一聚类宽度≥5家并伴随可追溯公告催化，则『退潮/降』被证伪，stage应上修（最多至发酵/降）。反向若温度续跌跌破25进入规则表冰点进攻窗（温度&lt;25，历史y1+0.30%/胜率60%、n=15），则退潮延续但攻防口径应切换为冰点反弹窗参考，仓位开关与本结论的&#x27;防守&#x27;定位需分别结算。</p></div><div class="" id="claim-cycle-5adc59395aeff294"><div class="claim-head"><span class="claim-role role-limitation">限制</span><span class="claim-source">判断 · 独立盲区声明</span></div><p class="mut">判断 · 独立盲区声明</p><p>本判断as_of=20261012收盘，只引用20261012及更早已留档输入，未引用目标日之后任何内容；未读取其他四路（limitup/theme/logic/lhb/auction）判断文件的结论字段以外内容，五路投票直接读其周期投票JSON的stage/direction/confidence。当日昨日涨停溢价=null、触发器=[]，三窗触发器不可判；一进二率源值口径与源表晋级明细不自洽（见data_gaps），不作定量使用；题材来源档A=0，全部为THS涨停原因B档，『无确认主线』建立在聚类可信假设上。缺项保留未知，不据缺失推断无风险。</p></div><span id="claim-cycle-b2fb77246858ece2"></span></div><div class="" id="claim-cycle-adf6ee1639f6e6a5"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">旧版原文补充</span></div><p>一进二率源值27.3%、二进三率10.0%、高度晋级率26.7%（前一交易日40.0%）、核按钮率4.2%（昨日涨停48只、今日跌停回杀2只）；昨日涨停溢价为null，触发器为空数组。首进二源值尚在10%接力冰点线之上，但二进三率与高度晋级率同步走弱；溢价与三窗触发器不可判，不能补造冰点进攻窗、过热禁追窗或洗出反弹窗已触发。</p></div><div class="" id="claim-cycle-dcb13dd36c646a0d"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">旧版原文补充</span></div><li>昨日涨停溢价为null，三窗触发器为空数组，冰点进攻窗（温度&lt;25）/过热禁追窗（温度≥85）/洗出反弹窗（溢价连负3日）当日均不可判。</li></div><div class="" id="claim-cycle-4d9634e6ad7745d1"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">旧版原文补充</span></div><li>一进二率源值27.3%与源表晋级明细不自洽：源表首板28+二连板9+三连板1=38只≠涨停46只（温度表2板为14只），按『今日二连板14/昨首板57≈24.6%』亦不符；口径存疑，只作方向参考、不用于定量。</li></div><div class="" id="claim-cycle-678cb7977be44153"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">旧版原文补充</span></div><li>题材归位来源档A=0/B=46/C=0，全部为同花顺涨停原因（THS编辑聚合），无公告级证据。</li></div><div class="" id="claim-cycle-be59838f00a85274"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">旧版原文补充</span></div><li>竞价维度（竞价额/一字真伪）未接入；一字判定用09:25首封+炸板0次代理。</li></div></section><section id="stages"><h2>三 情绪五阶段 · 五路周期投票</h2><div id="component-MACHVOTE"><!--MACHVOTE-->