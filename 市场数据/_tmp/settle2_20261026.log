atus": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261009-02", "d": "20261009", "due_d": "20261012", "source": "总审_20261009.json#指派清单/1", "original": {"指派ID": "MA-20261009-02", "指派给": "lhb", "深挖任务": "按目标日现存_席位动向/20261009.csv及龙虎榜双源校验_20261009.json逐代码重审；列出强矛盾、分歧、打折及可执行候选的源1/源2、有效S/A席位和位置证据；更正文件缺失陈述，并对能力应用回执影响字段给可定位证据，不修改旧判断文件。", "理由": "判断将两个实际存在文件称为缺失，未据58只可比票中4强矛盾、22分歧等实况裁决；回执applied与复用审计也未闭环。", "截止": "20261012", "状态": "待承接"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261012-01", "d": "20261012", "due_d": "20261013", "source": "总审_20261012.json#指派清单/0", "original": {"指派ID": "MA-20261012-01", "指派给": "lhb", "深挖任务": "出具『发出版席位荐票Top5』与『lhb判断0荐票』的口径冲突逐票裁决账：对5只候选（002264/002242/300829/605058/301052）逐一给源1/源2、净买占比桶、S/A席位小样本判定与位置证据，并明确源2(EM买侧)口径的可引用边界；同时补标所引 _学习/_席位动向/20261009.csv 与 _学习/龙虎榜双源校验_20261009.json 的落盘时点与回填窗口（当前未标）。", "理由": "两文件被引用于MA-20261009-02承接但未标窗口，属『回填窗口未标』；发出版与判断路的口径差若不带边界引用，下游易把源2买侧信号当席位共识。", "截止": "20261013", "状态": "open"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261012-02", "d": "20261012", "due_d": "20261013", "source": "总审_20261012.json#指派清单/1", "original": {"指派ID": "MA-20261012-02", "指派给": "limitup", "深挖任务": "把『高开幅度分档硬闸门』（高开≥8%禁止入荐票）从深挖结论写成可机械结算的规则条文（含分档定义、触发数据来源、豁免条件），并在分档样本各档n≥5时给出验证；同时对『真实竞价一字10/16 vs 首封时间口径8/16』的池口径偏斜用竞价快照重扫本日一字/秒板分带结论。", "理由": "20261009荐票T+1结算1/5、-4.25%、增益-3.39pp已归因于跳空结构，但闸门仍停留在结论文本；池口径偏斜由auction单路发现，本路未校正。", "截止": "20261013", "状态": "open"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261012-03", "d": "20261012", "due_d": "20261013", "source": "总审_20261012.json#指派清单/2", "original": {"指派ID": "MA-20261012-03", "指派给": "logic", "深挖任务": "补齐 _学习/风险事件_20261012.json（或把该源缺失升级登记为系统级能力缺口并给出补源方案与责任人），使解禁/减持踩窗可机械核对；同时把中报预增雷达『双源交叉』字段连续两日缺失（20261009/20261012）升级为能力补齐项，给出iwencai存档与东财预增的交叉落地口径。", "理由": "风险事件源缺失已被本路正确升级为荐票门禁，但已连续两日使全系统无法做窗口过滤；雷达双源字段缺失连续两日，业绩腿证据长期为零。", "截止": "20261013", "状态": "open"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261012-04", "d": "20261012", "due_d": "20261013", "source": "总审_20261012.json#指派清单/3", "original": {"指派ID": "MA-20261012-04", "指派给": "theme", "深挖任务": "为『媒体AI内容系18只／占全场涨停39.1%／封板资金23.86亿占50.7%』这一本路人工聚合附可复算脚本、族成员白名单与宽窄边界，并明确其不得替代聚类口径或折算为6有分数；同时对603096新经典补做换手率口径交叉（<3%桶 n=2321/33.9%/-0.91% vs 本路身位口径），给出是否维持荐票的结论修正。", "理由": "族级聚合是本日唯一『结构与资金高地』读数，但无量产脚本无法被下游复核；603096的荐票依据与limitup量化口径对撞（本审已降权），须由本路自证或自撤。", "截止": "20261013", "状态": "open"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261012-05", "d": "20261012", "due_d": "20261013", "source": "总审_20261012.json#指派清单/4", "original": {"指派ID": "MA-20261012-05", "指派给": "auction", "深挖任务": "把『明晨9:25高开≥5%一律放弃』闸门从结论级提升为公式级可结算规则（含分档阈值、闸门内判据、已封板剔除逻辑、单笔上限），并对4只无实时轨迹票（300006/600831/600693/600851）给出9:25结构的替代口径或显式登记不可核；同时说明快照09:30:56红线对『竞价额排名』字段可用性的量化影响。", "理由": "本路是当日唯一A档留档完备且唯一提供闸门因果证据的路，但闸门仍为文字表述；池内4/16票无轨迹使逐票结构不可核，须给替代口径或明确登记。", "截止": "20261013", "状态": "open"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261013-01", "d": "20261013", "due_d": "20261014", "source": "总审_20261013.json#指派清单/0", "original": {"指派ID": "MA-20261013-01", "指派给": "lhb", "深挖任务": "出具『江苏路A档席位（国泰海通上海长宁区江苏路，n=181/非小样本）身份与上修可靠性』核查报告：给出该席位近3个交易日重复出手度、个股持有周期（次日卖出/隔日再买）、下单结构（是否呈典型量化分散特征）、通道营业部与其历史标的的风格一致性；并对本路『冰点门禁第二条件成立→由C上修B』做一次**反向复核**（列出该上修若不成立的可能路径），同时归因昨日002242被T+1执行+11.69%证伪的成因（源2口径差 vs 真实出货）。", "理由": "本日lhb由C上修B的**唯一支点**即该席位，而lhb自标其真实身份属C档缺证；且该上修与其自身『温度分位18冷档』直接对冲、前日同方向判断已被T+1打脸一次；不核清则lhb档位不可被下游采信。", "截止": "20261014", "状态": "open"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261013-02", "d": "20261013", "due_d": "20261014", "source": "总审_20261013.json#指派清单/1", "original": {"指派ID": "MA-20261013-02", "指派给": "limitup", "深挖任务": "①交付**全池T+1执行口径实测**：20261012冻结池46只 与 20261013冻结池67只，按 T+1开盘买→T+1收盘（执1）算执1胜率与执1均涨，明确是否『双门（胜率>50%且均涨>0）』同时通过——结清昨日总审次日验证点④（现为未结项）；②复核**换手率桶归属与引述数字**：按 _学习/_涨停质量库.json#因子.换手率 的桶序 {<3%,3-10%,10-20%,≥20%} 重新标注本日观察票与回执引述（含002343=3.37%应为3-10%桶、≥20%桶执1胜率应为45.0%），并回溯修正20261012对600825『换手3.4%落<3%桶』的同型误标。", "理由": "昨日总审验证点④缺独立落盘，limitup以『隔夜溢价口径+3.53%/89.6%』自报双门成立，但与执行口径方向背离、不能相互替代；且本日回执存在两处引述数字与库现值不符（桶归属、胜率），须以库为准修正并留档。", "截止": "20261014", "状态": "open"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261013-03", "d": "20261013", "due_d": "20261014", "source": "总审_20261013.json#指派清单/2", "original": {"指派ID": "MA-20261013-03", "指派给": "logic", "深挖任务": "把连续缺失的两个源**落到可执行方案**：①风险事件源（_学习/风险事件_<d>.json）——给出具体数据源、字段清单、落盘脚本路径与责任人，或将缺口正式登记为系统级能力缺口并附影响面清单；②中报预增雷达『双源交叉』字段（iwencai存档∩东财预增）——给出可复核的落地口径与字段名。两项均须给出**下一个交易日的可验证交付物**。", "理由": "风险事件源最新=20260930（跨十余个交易日缺失）、雷达双源字段连续第三日缺失，两者已被升级为荐票门禁（缺料不得读作无风险）；MA-20261012-03 仅部分完成（给了方案但源未恢复），缺口未消解。", "截止": "20261014", "状态": "open"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261013-04", "d": "20261013", "due_d": "20261014", "source": "总审_20261013.json#指派清单/3", "original": {"指派ID": "MA-20261013-04", "指派给": "theme", "深挖任务": "为三条新线给出**可复算的族成员白名单与『首板→2板』转化观察条件**：①PCB 11只（000823/605058/605258/603328/603386/603956/301041/002579/688655/600237/002623）、②冰雪经济8只（601188/000715/301010/600593/600853/603099/002878/000558）、③AI漫剧3只（002343/603096/605577）；并对AI漫剧做**公告级交叉**（三只是否存在可定位A档催化原件，用以判定『未定龙』归类是否成立）。", "理由": "本日全部新线均为『宽度无高度』（PCB11/冰雪8全首板=宽度陷阱），若不能定义转化条件则该读数不可用于次日；theme唯一荐票002343依赖未定龙的AI漫剧归类，且该票与limitup换手率能力口径冲突（分歧裁决D3），须以白名单+公告交叉解耦。", "截止": "20261014", "状态": "open"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261013-05", "d": "20261013", "due_d": "20261014", "source": "总审_20261013.json#指派清单/4", "original": {"指派ID": "MA-20261013-05", "指派给": "auction", "深挖任务": "①把『zt_pool首封时间字段低估一字』的校正做成**每日可跑的机械对账**（快照真实一字数 vs 首封≤09:25计数，逐票差异清单落盘）；②累计『9:25高开≥5%一律放弃』闸门的**有效池样本至≥30个**，并对各分档（低开≤0/0~5/≥5）给出n≥5的T+1执行均收与胜率检验，据此判定该闸门应维持、上修还是撤销。", "理由": "池口径偏斜（昨日分歧④）本日虽由limitup独立复现而收敛，但其**系统偏差仍在**、需制度化；闸门累计样本（M-20261012-AU-02/M-20261012-AU-03）尚未达统计门槛（≥30个有效池），无法支撑阈值定案。", "截止": "20261014", "状态": "open"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261014-01", "d": "20261014", "due_d": "20261015", "source": "总审_20261014.json#指派清单/0", "original": {"指派ID": "MA-20261014-01", "指派给": "logic", "深挖任务": "把『覆铜板/电子铜箔同环节双票景气共证』从**公司自述文本**升级为**可复核的独立产业数据交叉**：给出至少一个独立来源（覆铜板/CCL报价指数或PCB排产/订单数据）与可机械读取的字段名，并对 000823超声电子 vs 002552宝鼎科技 给出同环节因果链的**可证伪判定条件**（如覆铜板报价是否连续上行、两家变动原因文本是否来自同一新闻源）。同时为三季报业绩池（东财 RPT_PUBLIC_OP_NEWPREDICT 单源）给出**第二源交叉口径**或正式登记为单源边界。", "理由": "logic是今日唯一上B路，其B档的『产业级共振』支点=两家公司自述变动原因文本（同构可能源于同一新闻源），非独立产业数据；三季报池亦为单源（logic自认盲区③）。不交叉则该B档只能停留『局部证据分级』、无法升级为环境级证据。", "截止": "20261015", "状态": "待承接"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261014-02", "d": "20261014", "due_d": "20261015", "source": "总审_20261014.json#指派清单/1", "original": {"指派ID": "MA-20261014-02", "指派给": "logic", "深挖任务": "消解『风险事件源维度不全』这一系统性缺口：为 _学习/风险事件_<d>.json **新增第3维度**（减持计划 或 业绩预告披露日历，二者择一落地），给出底源接口、字段清单、落盘脚本路径；若无法接入则该维度**正式登记为边界**并附『影响哪些候选票门禁』的影响面清单。", "理由": "风险事件源本日虽恢复（status=pass/25条），但**仅覆盖解禁+分红除权两维**，减持/财报披露日历/股东大会/业绩预告四维未接入；该源被列为荐票门禁（缺维≠无风险），是最能被指派的系统性缺口。", "截止": "20261015", "状态": "待承接"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261014-03", "d": "20261014", "due_d": "20261015", "source": "总审_20261014.json#指派清单/2", "original": {"指派ID": "MA-20261014-03", "指派给": "theme", "深挖任务": "把『公告催化补充』源**落地或给出替代口径**：给出可每日生成的公告级催化交叉口径（源、字段、脚本路径），并据此复核本日AI短剧线3只（002343/603533/603598）与出版线是否存在**A档公告原件**；同时补出『题材四维警报』为空的成因与修复。", "理由": "_学习/公告催化补充_20261014.json **不存在**，导致全场A档催化=0、题材四维警报为空；theme的『无确认主线/AI短剧旗帜』判定与该源缺失直接绑定（五路共享前提）。", "截止": "20261015", "状态": "待承接"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261014-04", "d": "20261014", "due_d": "20261015", "source": "总审_20261014.json#指派清单/3", "original": {"指派ID": "MA-20261014-04", "指派给": "lhb", "深挖任务": "出具 **000823超声电子跨路口径冲突裁决说明**：逐一列示 lhb.csv 同日两行（当日榜-144万 / 连续3日累计+8165万）的原始字段与取用依据，明确『当日榜净买为负』与『累计榜净买为正』两事实的适用边界，并给出**业绩腿（logic）与资金腿（lhb）对同票的口径分离规则**（何种情形下资金腿可否决业绩腿荐票）。", "理由": "000823=logic唯一正式荐票，同时被lhb判强矛盾/污染嫌疑禁荐，形成『业绩腿荐 vs 资金腿禁』的跨路对撞（分歧D2）；现行规则只有『强矛盾禁荐』一条，无跨路仲裁口径。", "截止": "20261015", "状态": "待承接"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261014-05", "d": "20261014", "due_d": "20261015", "source": "总审_20261014.json#指派清单/4", "original": {"指派ID": "MA-20261014-05", "指派给": "lhb", "深挖任务": "把**源1净买口径前置到发出版**：改造席位荐票发出版，使其候选池先经『源1当日榜正净买』过滤后再打分（从源头消除发出版Top1=000823 被判断路全否决的对撞），并给出改造前后Top5差异对照表；同时把『席位分档×净买占比桶』结构的历史打脸项（20261013发出版0/4·-4.52%）并入本路自查清单。", "理由": "发出版与判断路口径对撞**连续多日复发**（总审_20261012综合深挖④→总审_20261013 D4→本日D4），分层治理未生效；发出版不得生成执行清单已是既定裁决，但源头口径未统一。", "截止": "20261015", "状态": "待承接"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261014-06", "d": "20261014", "due_d": "20261015", "source": "总审_20261014.json#指派清单/5", "original": {"指派ID": "MA-20261014-06", "指派给": "auction", "深挖任务": "消解『竞价换手率不可算』这一本路已知边界：给出**竞价换手率（09:25竞价成交量/流通股）**的可实时计算口径与数据源，或**正式登记为不可算**并附『米开第一式』因该字段缺失而不可用的影响面清单。", "理由": "auction本日自报『竞价换手仍不可算=null』，属米开第一式（主动性）执行缺口；该字段若可算将直接进入闸门判据，是auction路内最可机械交付的系统性缺口。", "截止": "20261015", "状态": "待承接"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261014-07", "d": "20261014", "due_d": "20261015", "source": "总审_20261014.json#指派清单/6", "original": {"指派ID": "MA-20261014-07", "指派给": "limitup", "深挖任务": "给出**『冰点档（温度<25）质量观察位』的可结算规则**：基于 _涨停质量库.json 换手率/开板次数/首封时间桶，判定冰点档观察位是否应设专用闸门（含 n≥5 分档检验）；并量化『一字/秒板 → 次日追不进率』，检验其是否应进入池均期望计算（现池均执1 -0.3681% 未扣该率）。", "理由": "limitup本日C·0荐票、仅3只质量观察；其自报库内冰点档30天日均执1 -0.13%（微弱负），但冰点档观察位是否有识别力**尚无 n≥5 分档检验**；且『追不进率未进入期望』是全池口径的系统性偏差。", "截止": "20261015", "状态": "待承接"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261015-01", "d": "20261015", "due_d": "20261016", "source": "总审_20261015.json#指派清单/0", "original": {"指派ID": "MA-20261015-01", "指派给": "limitup", "深挖任务": "把『换手率<3%否决』从本路桶规则升级为可仲裁的跨路门禁：给出①冰点档换手<3%桶的机械判据与适用边界(是否覆盖一字/秒板等不可成交结构)；②被否决第三方票(002815)的次日结算口径(T+1执1 vs 3-10%桶对照、样本归属)；③能力因子『换手率』在温度子档下的单调性检验(给出n与是否单调)。", "理由": "本日跨路硬分歧D1的全部裁判依据在本路；能力因子已在冰点子集出现非单调(本路由升权筛选改为否决器)，若不给出机械边界，次日分歧无法复现裁决。", "截止": "20261016", "状态": "未完成"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261015-02", "d": "20261015", "due_d": "20261016", "source": "总审_20261015.json#指派清单/1", "original": {"指派ID": "MA-20261015-02", "指派给": "logic", "深挖任务": "两项交付：①把『一字/秒板→次日追不进率』并入本路期望与买点口径，给出『公告级业绩票是否应排除一字结构』的机械规则(以002815首封=末封09:25:00、换手1.78%为样本)，并说明为何该票仍列正式荐票；②锁定『链条纵深』的计量单位(当日涨停票 vs 公告级原件不论当日是否涨停)，给出跨日可比口径与历史回溯重算。", "理由": "本日跨路硬分歧(D1)与昨日线索M-20261014-LG-01的口径漂移均出自本路；同一事实(上游000823/002552未涨停)在两个口径下可读成正反两面，不锁定单位则链条类命题不可结算。", "截止": "20261016", "状态": "未完成"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261015-03", "d": "20261015", "due_d": "20261016", "source": "总审_20261015.json#指派清单/2", "original": {"指派ID": "MA-20261015-03", "指派给": "lhb", "深挖任务": "两项交付：①双主项(净买占比最优桶×封板质量)vs 全因子模型分的取舍规则：今日600668模型分12.46排第9、300111 19.83排第1、603230 17.68排第2，两者相反，须给出保留双主项或并入模型分的机械判据与次日结算；②把『源1当日榜净买为负』的负面过滤从本路候选域扩展为跨路共票告警(今日auction正式荐票000530源1净买-0.1394亿、双源=分歧，本路未出告警)。", "理由": "双主项为昨日新修订的主项、尚未经任何验证；发出版改造(M-20261014-05)仍未落码，跨路共票无告警机制，负面过滤存在结构性漏口。", "截止": "20261016", "状态": "未完成"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261015-04", "d": "20261015", "due_d": "20261016", "source": "总审_20261015.json#指派清单/3", "original": {"指派ID": "MA-20261015-04", "指派给": "theme", "深挖任务": "两项交付：①『公告催化源无条件落盘』补丁的宿主可执行说明(现落于need_fallback条件分支)+A档质量分层规则(剔除非经常性损益驱动，如000626远大控股扣非仍亏825~1587万元)+『A档不得单独解锁主线』的机械判定条件；②『染料印染』线与PCB线的跨日线名归一映射表，修复四维环比整列失效(线名漂移+『纺织服装』伪匹配)。", "理由": "A≥3与题材归位A=0的口径差与四维警报为空是本日两处结构性缺陷，均出在本路且已定位成因；不落地则次日归位仍会A=0、警报仍为空。", "截止": "20261016", "状态": "未完成"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261015-05", "d": "20261015", "due_d": "20261016", "source": "总审_20261015.json#指派清单/4", "original": {"指派ID": "MA-20261015-05", "指派给": "auction", "深挖任务": "两项交付：①将『竞价换手率』(本日已结清可算、n=469)正式登记进能力预加载申请路径：给出判据清单、单位口径复核与『缺失即自检不通过』的处理铁律；②『烂板结构』(炸板≥10次/换手极端/尾盘回封，如今日荐票000530炸12次、换手41.05%、末封14:27:51)是否应升为闸门独立扣分项——给出n≥5的分档检验与闸门对账(本日闸门内-2.13% vs 全池-1.36%、48池日首次转负)。", "理由": "本路荐票落入闸门口径未覆盖的结构；闸门正增益记录本日中断、三档首次全反转，需以分档证据决定闸门参数是否修正。", "截止": "20261016", "状态": "未完成"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261015-06", "d": "20261015", "due_d": "20261016", "source": "总审_20261015.json#指派清单/5", "original": {"指派ID": "MA-20261015-06", "指派给": "logic", "深挖任务": "推动风险事件第3维度(股东/高管减持)落码验收：给出①落码生效的机械判据(风险事件_{d}.json metrics.覆盖维度含『股东减持』『高管减持』且 事件[] 类型='减持' 与直连filter逐条一致)；②『减持踩窗』对五路候选票的影响面清单模板(含触发即降级/不荐的档位规则)；③减持计划(预案)维度已判为不可接入的边界复述与替代方案。", "理由": "本日已直连实测交付口径(RPT_SHARE_HOLDER_INCREASE近30日499条/去重210只/∩涨停=003029吉大正元→强制降级)，但生产文件风险事件_20261015.json仍只有[限售解禁,分红除权]两维=落码未生效；缺维不等于无风险，属跨路门禁共同缺口。", "截止": "20261016", "状态": "未完成"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261016-01", "d": "20261016", "due_d": "20261019", "source": "总审_20261016.json#指派清单/0", "original": {"指派ID": "MA-20261016-01", "指派给": "limitup", "深挖任务": "三元交互桶的可验证化：①披露本次『首板×开1次×10-20% n=67』所在的扫描格总数、各格样本量与该格的 Bonferroni/BH 校正后显著性（或明确写 null+原因，不得省略）；②把『n<60 仅登记、不作荐票主依据』写成判断模板的机械字段（今日000530 以 n=48 格入选荐票，违反本路自设门槛）；③给出该桶在 ≥65 温度档为何不适用（rho=-0.2）的边界条款。", "理由": "今日 limitup 是唯一获净新增额度的路，但其荐票入口径是当日新开、无样本外验证、且与自家评分卡符号相反；不补齐则次日无法复现裁决，也无法判断『桶』是真edge还是扫描噪声。", "截止": "20261019", "状态": "未完成", "可机械验收": "limitup判断_20261019.json#/判断/证据 含『格总数』与『校正后p/显著性』字段（或显式 null+原因）；同文件出现『n<60 不作荐票主依据』字样及其对应票的筛除记录；000530/300045/301586 三票执1结算行。"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261016-02", "d": "20261016", "due_d": "20261019", "source": "总审_20261016.json#指派清单/1", "original": {"指派ID": "MA-20261016-02", "指派给": "auction", "深挖任务": "两项：①荐票披露模板补『资金腿』字段：每只荐票须写 双源判定（一致/分歧/强矛盾/打折/无源1/未上榜）或 null+理由——今日600668=无源1、600418=未上榜，均未披露；②竞价末段位移（撤单差分代理）的预测力机械检验：以 n≥30 样本检验『末段松动<-5pp』组次日执1 vs 池均收，给出是否可作判据的结论（today 600668 末段-7.51pp 而次日+7.85%，单例反向）。", "理由": "同线单票与资金腿披露是本日两处跨路冲突（600668 W2、600418 未上榜）的直接成因；末段位移若被当作方向判据会系统性误杀强势票。", "截止": "20261019", "状态": "未完成", "可机械验收": "auction判断_20261019.json#/荐票 每只含『双源判定』键（值∈{一致,分歧,强矛盾,打折,无源1,未上榜,null}）；同文件 深挖 含『末段位移』分档 n 与执1均收对照表（n≥30）。"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261016-03", "d": "20261016", "due_d": "20261019", "source": "总审_20261016.json#指派清单/2", "original": {"指派ID": "MA-20261016-03", "指派给": "lhb", "深挖任务": "把跨路共票告警从『上一交易日推荐』改为『当日推荐』口径：产物 跨路共票告警_{d}.json 的 推荐日 必须=d，并对当日五路全部荐票/观察出 W/S 级告警（今日7只：600668=W2、600418=未上榜、其余5只=一致/小量级需分级）；同时给出『正式荐票≠席位发出版Top5』的结算补丁（600668 漏项根因）。", "理由": "今日告警产物推荐日=20261015，对当日7只零覆盖，属机制空转1日；且发出版/正式荐票分离导致昨日执行清单1/3无结算。", "截止": "20261019", "状态": "未完成", "可机械验收": "跨路共票告警_20261019.json#/推荐日 == \"20261019\"，且 A_跨路共票告警 覆盖 lhb判断_20261019.json 的全部荐票代码（集合差为空）；席位荐票结算_20261019.json 含『正式荐票』独立行。"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261016-04", "d": "20261016", "due_d": "20261019", "source": "总审_20261016.json#指派清单/3", "original": {"指派ID": "MA-20261016-04", "指派给": "theme", "深挖任务": "公告催化源落盘第2日仍未生效（公告催化补充_20261016.json 不存在、归位A=0）：把已交付的三段规则（A1/A2/A3 质量分层、A档不得单独解锁主线的四条件、need_fallback 取消方案）转成可评审的落盘补丁（脚本 diff 或引擎侧缺陷单编号），并给出『补丁未生效期间归位A=0 时不得声称有催化』的自检条款。", "理由": "A档缺口已连续2日回退为0，A≥3 vs 归位A=0 的口径差使『主线判定』与『催化证据』长期脱钩；规则交付两次仍不生效，属执行链缺陷而非认知缺陷。", "截止": "20261019", "状态": "未完成", "可机械验收": "存在 公告催化补充_20261019.json 且 metrics.条数≥1；或 theme判断_20261019.json 内含 补丁编号/PR链接（正则 `MA-20261016-04[:：]\\s*\\S+`）；且 题材归位_20261019.json#档计数.A ≥1。"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261016-05", "d": "20261016", "due_d": "20261019", "source": "总审_20261016.json#指派清单/4", "original": {"指派ID": "MA-20261016-05", "指派给": "logic", "深挖任务": "减持维度第3日未落码（风险事件_20261016.json 覆盖维度仍=[限售解禁,分红除权]）：本指派升级为阻断项——须给出 风险事件 生成脚本中减持维度的实际写入位置与字段映射（源 RPT_SHARE_HOLDER_INCREASE / RPT_EXECUTIVE_HOLD_DETAILS），并交付一次『落码后重跑当日文件』的证据（覆盖维度含『股东减持』『高管减持』且 类型='减持' 条数>0）。若判定技术上不可接入，须显式降级并在五路门禁中声明该维度永久缺失。", "理由": "同一维度已连续3日以『直连实测交付』替代生产落码，跨路门禁共同缺口；『缺维≠无风险』，且今日7只荐票无一只可通过减持维度复核。", "截止": "20261019", "状态": "未完成", "可机械验收": "风险事件_20261019.json#metrics.覆盖维度 含『股东减持』与『高管减持』，且 事件[] 中 类型='减持' 的条数>0；或 该文件含 `永久缺失:['减持']` 显式声明且五路判断_20261019 均引用。"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261016-06", "d": "20261016", "due_d": "20261019", "source": "总审_20261016.json#指派清单/5", "original": {"指派ID": "MA-20261016-06", "指派给": "cycle", "深挖任务": "stage 字段加限定词：周期主判 的 stage 不得裸写『启动』——取值改为『启动(弱)』或在同层新增 stage_qualifier 字段（如『质量腿未确认·退潮铁律成立』），并同步 周期投票_*_20261016 的下游读取说明；同时把『命名/仓位分离』写成机械条款（命名升级不带动仓位档，仓位档只看量能台阶+封板率）。", "理由": "下游页面/推演/结算按 stage 字段机械读取，裸『启动』会被当作进攻档；当日封板率0.5545≤64%、量能1.5554万亿<3万亿两条铁律均成立，字段与铁律不自洽属硬伤（D1）。", "截止": "20261019", "状态": "未完成", "可机械验收": "周期主判_20261019.json#stage 值 ∉ {\"启动\"}（须含限定符）或存在非空 stage_qualifier 字段；且同文件含『命名不带动仓位』条款文本。"}, "status": "unverifiable", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261019-01", "d": "20261019", "due_d": "20261020", "source": "总审_20261019.json#指派清单/0", "original": {"指派ID": "MA-20261019-01", "指派给": "auction", "深挖任务": "①纠正『末段位移不可检验』的事实错误：数据实际位于 盘中/{d}/auction_traj.jsonl（现成八日：20260930/20261009/20261012/20261013/20261014/20261015/20261016/20261019）与 _学习/竞价撤单差分_{d}.json（今日 status=pass、59码）；本审已用今日轨迹在 09:20~09:25:59（18帧/59码）复算出池内松动Δ<0 9只执1均-2.25% vs 持稳Δ≥0 3只-1.65%，请以八日全样本重跑 Δgap 三档（<-5pp / -5~0 / ≥0）与执1对照，逐档给 n/胜率/均收/正日数。②若仍判样本不足（n<30），须逐条说明哪几日轨迹不可用及原因，禁止再用『全库0份』。③附带：000576 今日 gap+7.18% 落自家闸门外档，请给『荐票与闸门结构性冲突』的机械解法（如荐票须附『明日落闸门概率』估计）。", "理由": "本日最严重的可核事实错误：把已有的八日轨迹判成数据缺口，导致 MA-20261016-02 第2项被误结，且当日两只荐票完全未做末段位移检查；不纠正则该项能力永久停在 null。", "截止": "20261020", "状态": "pending"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261019-02", "d": "20261019", "due_d": "20261020", "source": "总审_20261019.json#指派清单/1", "original": {"指派ID": "MA-20261019-02", "指派给": "theme", "深挖任务": "把负面过滤接进『观察→荐票』的升格条件：①003029 吉大正元已被 logic 的减持维度命中（上海云鑫 -31.8万股@09-29、-193.62万股@09-21~24），但其升执行判据（封4板且非一字→荐票2%）未挂任何负面过滤，请为该判据加硬门禁并回标该票；②对本日全部观察票（603197/603278/003029）逐票复检 风险事件_20261019.json 的减持/解禁/分红三维命中数，输出『负面过滤』字段；③给出规则：观察票升荐票前必须三维零命中，或命中时降为『仅标尺』。", "理由": "负面过滤已在生产链路接通（696条/4维/pass），但只在 logic 一路生效；theme 的升执行判据是唯一会把踩窗票送进执行通道的口子，属跨路门禁未广播的漏洞。", "截止": "20261020", "状态": "pending"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261019-03", "d": "20261019", "due_d": "20261020", "source": "总审_20261019.json#指派清单/2", "original": {"指派ID": "MA-20261019-03", "指派给": "lhb", "深挖任务": "打通『正式荐票』结算缺口：① 席位荐票结算.py 源文件缺失（仅剩 .pyc 与 tests/test_席位荐票结算链路.py），请给出二选一交付——恢复源文件，或以 交易计划_lhb_{d}.json#buys 为主键新写独立结算脚本（输出 代码/名称/权重/买入闸门/执1收益/判定，并列 发出版对照段）；②用该口径补 20261016 正式荐票（600802 +1.02%、001696 -0.56%，本审已复算）与 20261019（本日空仓，输出空段）两日结算；③给出该脚本的回归测试断言（buys 条数 == 结算段条数）。", "理由": "MA-20261016-03 第2条因脚本缺失卡死已两日，导致『正式荐票≠发出版Top5』的漏项无法量化、五路战绩口径长期只覆盖发版Top5；这是战绩验收链的根节点。", "截止": "20261020", "状态": "pending"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261020-01", "d": "20261020", "due_d": "20261021", "source": "总审_20261020.json#指派清单/0", "original": {"指派ID": "MA-20261020-01", "指派给": "limitup", "深挖任务": "分数卡『预测执1』校准对账（本日最高优先级）：①取近10个交易日（20261008~20261019）的每日预测执1均涨/胜率，与次日实际全池执1均涨/胜率逐日列表，给偏差均值、偏差符号一致率、MAE；②专答昨日符号反转：为何对自家5只全预测负（-0.45/-0.32/-0.24/-0.24/-0.40）而实测+2.16%（4/5正）；给出至少一条可机械检验的偏移来源假设（如冰点环境虚拟变量缺失、或预测值取的是『历史同桶均值』而非『当日调整后』）；③结论必须落为『预测值可用/需平移/不可用』三态之一，并给平移量。", "理由": "今日唯一被裁决不采纳的结论就是『全池-0.339%→零执行』，而该卡昨日符号反转是硬证据；若不平账，明天会以同一个未校准的数继续压掉可赚的票（昨日已实证：被否决三票+1.58%）。这是系统性过度空仓的唯一根因，优先级高于任何选股任务。", "截止": "20261021", "状态": "pending", "可结算判定条件": "输出『预测vs实际』逐日表（≥10行）＋偏差均值/MAE 两个数字＋三态结论；三态缺一即未完成。"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261020-02", "d": "20261020", "due_d": "20261021", "source": "总审_20261020.json#指派清单/1", "original": {"指派ID": "MA-20261020-02", "指派给": "theme", "深挖任务": "机器人线『纵深』口径重定义＋荐票挂闸门概率：①把『深度闸』里的『早封占比』升级为『早封且零开板占比』，并重算今日（预计2/18=0.11）与近12日序列，给出该指标与次日线内执1的相关方向；②输出『同一粗颗粒环节≥2家』的可执行清单（今日=0条），并给明日的判定脚本口径；③自20261021起，任何『今日已一字/秒板』的荐票必须附 auction 的落闸门概率 P（秒板|3板+ 47.6%、一字|3板+ 55.1%，或自算），无P不得出荐票。", "理由": "今日 603278 是唯一荐票却全天一字（执1=0.00），theme 只写『大概率不可成交』不给概率，等于把执行风险留给次日临场；同时『早封占比0.39』在开板0.56的线里是伪强度指标，会让深度闸长期虚真（连续5日只过集中度不过深度，今日首次『双真』可能正是该指标放水所致）。", "截止": "20261021", "状态": "pending", "可结算判定条件": "交付『早封且零开板占比』今日值+近12日序列+与次日执1的方向结论；603278荐票卡出现 P 字段；环节≥2家清单条数明确（含0）。"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261020-03", "d": "20261020", "due_d": "20261021", "source": "总审_20261020.json#指派清单/2", "original": {"指派ID": "MA-20261020-03", "指派给": "lhb", "深挖任务": "顺延 MA-20261019-03 落码：产出带『正式荐票』段的 席位荐票结算_{d}.json（口径/7条断言/两日复算已交付，本次只要求工程落地与自检）：①新增键『正式荐票』，条数==交易计划_lhb_{d-1}#buys；②逐票 buy_px==_bars_cache 执行日 open（±0.001），gap 落带外者判定『闸门未落』、收益null、不进分母；③修掉 append_dedup 主键冲突（同一天写正式/发版两行会互相覆盖，主键改 d|正式、d|发版）；④同日重跑两次反思行数不增（幂等）。", "理由": "该指派已跨两日：20261019 立项（前提误判为文件缺失）→ 20261020 纠错并交付口径与断言 → 今日落盘文件仍只有Top5段，闭环第三次断在同一点。若再顺延，『正式荐票』的跨日胜率将永久缺失，席位路的仓位权重无从校准。", "截止": "20261021", "状态": "pending", "可结算判定条件": "席位荐票结算_20261020.json 含『正式荐票』键且条数==20261020 buys条数（今日0==0 合法空段）；A1~A7 断言全绿或逐条说明未过原因；同日重跑幂等验证通过。"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261020-04", "d": "20261020", "due_d": "20261022", "source": "总审_20261020.json#指派清单/3", "original": {"指派ID": "MA-20261020-04", "指派给": "auction", "深挖任务": "002076 的结构冲突裁决＋新桶提案：①同一票上并存『封单比0.31%→落唯一正桶54.1%/+0.89%』与『炸板9次/末封13:35:30/换手18.34%』，请把『封单比<0.5%』桶按炸板次数二分（炸0-1 / 炸≥2），给各自 n/执1胜率/均收/次日封板率，回答『薄封+烂板』是否该从正桶里剔除；②003029 今日属『竞价封死→炸4次→回封』，请判断是否应单列『开板一字』桶（区别于『一字未开』55.1%），给 n 与该桶执1；③结论直接改写明日评分/滤网，不只给统计。", "理由": "002076 是本日采信的两只荐票之一，但它的入选依据（薄封正桶）与它的主要瑕疵（炸9次）出自同一张表的两端，本路未做交叉；若『薄封』的正期望实际由『薄封+不炸』贡献，则 002076 属误用正桶。这直接决定明日5%仓位是否该保留。", "截止": "20261022", "状态": "pending", "可结算判定条件": "两个子桶（薄封×炸板二分）n 均≥30 且给出执1胜率/均收/次日封板率三列；『开板一字』桶给出 n 与执1；明日的评分表出现对应字段或明确『不改』的理由。"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261020-05", "d": "20261020", "due_d": "20261022", "source": "总审_20261020.json#指派清单/4", "original": {"指派ID": "MA-20261020-05", "指派给": "logic", "深挖任务": "中报窗口错位的机械替代方案：①今日已证『中报池∩涨停』与三季报口径不同源（600267 三季报公告2026-10-17 不在中报池内），请用现有可得源（THS预告文本/公告日≥20261001 的预告）拼一个临时『三季报口径池』，给出池大小、∩今日涨停的只数、与中报池的差异只数；②若临时池不可建，给出『窗口不可比』的标准表述模板，替换现有『业绩腿为零』的措辞；③重估 600267：在『一字不可执行』与『唯一业绩原件载体』并存时，给出的不是荐票而是什么（观察票的升格条件必须含 gap 闸门）。", "理由": "本日 logic 的『业绩腿为零』结论是最容易被误读的一条（窗口污染被写成事实缺失），而 600267 又是唯一跨路共振票（资金×业绩）；若不把窗口问题机械解决，明日三季报窗口全面开启时，该路会同时面临『旧池失真』与『新池缺失』双重盲区。", "截止": "20261022", "状态": "pending", "可结算判定条件": "交付『三季报临时池』或『不可建的原因+模板』二选一；600267 的升格条件文本中必须出现 gap∈[-3,+3] 与 开板≤1 两个机械项；『窗口不可比』表述替换完成（可用grep自证）。"}, "status": "unverifiable", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261021-01", "d": "20261021", "due_d": "20261022", "source": "总审_20261021.json#指派清单/0", "original": {"指派ID": "MA-20261021-01", "指派给": "limitup", "深挖任务": "①『尾盘封 × 连板数』交叉桶：把今日最强的『首封>14:00』桶（n=37）按连板数拆成 首板/2板/3板+ 三档，各给 n/执1胜率/执1均收/次日封板率，直接回答『002242 这类 2 板尾盘封是否应停用』；②同表在 20cm 子集（今日 6 只）上单独分桶，回答『20cm 的尾盘封是否同向』；③把三张表（全池/可成交子集/20cm）在同一窗口重算，其中『可成交子集』须剔除一字与开盘即封（以 gap 与 open==high/low 判定），并明示剔除了多少只——这一步是验证『薄封正桶』是否只是不可成交样本污染的产物。", "理由": "本日 002242 的裁决（M-03）压在『尾盘封桶 n=37』与『2板桶 -1.708pp』的对撞上，而这两个桶从未交叉；同时 H-02 指出的桶污染若不检验，明日同样的裁决还会再赌一次。这是本日唯一同时决定『组合里 2% 仓位』与『未来所有封单类桶可信度』的任务，优先级最高。", "截止": "20261022", "状态": "pending", "可结算判定条件": "三张表齐全且每格 n≥20（不足须标 n 并说明）；每行四列（n/胜率/均收/次日封板率）；对『2 板尾盘封是否停用』给出是/否二值结论；『可成交子集』须写出剔除只数与判定脚本口径。"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261021-02", "d": "20261021", "due_d": "20261022", "source": "总审_20261021.json#指派清单/1", "original": {"指派ID": "MA-20261021-02", "指派给": "auction", "深挖任务": "顺延 MA-20261020-04 的两项未结交付：①『封单比<0.5%』桶按炸板次数二分（炸0-1 / 炸≥2），各给 n/执1胜率/均收/次日封板率；②『开板一字』桶单列（区别于『一字未开』），给 n 与执1（今日 002835/600178 即为开板一字，正可作样本）；③附带交付『S/A 转债 vs 股票 分项金额』（lhb 侧今日缺该分项，线索 T-20261020-04 因此无法结算）。", "理由": "该指派已顺延 1 次；002076 虽已迁出薄封桶使原命题失效，但『开板一字』桶的缺失直接导致 603278/600178 这类票在两路得到相反评级（auction 见『一字』判不可执行、limitup 见『4板+』判 +1.888pp）。转债分项则是 5 日线索的分子，缺一日即无法结算。", "截止": "20261022", "状态": "pending", "可结算判定条件": "两个子桶 n 均≥30 且四列齐全；『开板一字』桶给出 n 与执1；转债/股票分项金额各一个数字（无源则写『无源』并说明，不得留空）。"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261021-03", "d": "20261021", "due_d": "20261022", "source": "总审_20261021.json#指派清单/2", "original": {"指派ID": "MA-20261021-03", "指派给": "lhb", "深挖任务": "收盘口三件套：①A3 落地——append_dedup 主键改为 d|正式 / d|发版，使同日两行不互相覆盖；②在 席位荐票结算_{d}.json#汇总 里增加『无执行价剔除数』一栏（920157 这类样本必须可见，不许默默出分母）；③在 席位荐票结算.py 里把『封单比』字段输出为双值（封单/成交 与 封单/流通），并标注各自用于哪条门槛——这是 M-01 的工程解。", "理由": "A3 是 MA-20261020-03 连续第 3 次未闭环的那一环，今日键已落盘、只差主键；『无执行价』虚增胜率与『封单比单口径』是本日两条检查项的共同源头，都属工程可修。三项均可在不重跑全流程的前提下完成（脚本级改造＋文件级重算）。", "截止": "20261022", "状态": "pending", "可结算判定条件": "①grep 到新主键格式且同日双写不覆盖（附一行 diff 或 sha 对比）；②汇总含『无执行价剔除数』且数值可复算；③双口径字段在结算输出中同时出现，且 002639/002242 两票双值与我复算一致（16.30/1.95、1.28/0.229）。"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261021-04", "d": "20261021", "due_d": "20261022", "source": "总审_20261021.json#指派清单/3", "original": {"指派ID": "MA-20261021-04", "指派给": "theme", "深挖任务": "①把 002076 的『单日结构反转』做成 3 日序列（封单比流通口径、炸板、换手、首末封时间），回答『跃迁』是否可称；②给出可机械执行的『题材纯度 vs 量价强度』权重规则——今日它荐了四标签载体 002076（封单/成交 0.98）而弃正统环节 603138（0.37），必须给一条规则说明什么时候纯度优先、什么时候量价优先，并可在明日直接套用；③把 r=-0.684（N=11）的『删除指标』结论改为『暂缓使用』——11 个样本不足以删除一个指标，须补到 N≥20 或写明暂缓理由。", "理由": "002076 是本日唯一『隔日结构反转』型荐票，其后续是 theme 今后能否识别『分歧转一致』的样板；而路由身份漂移（M-05）若不立规则，题材路会慢慢变成第二个 limitup。r 的样本量问题属方法学自限，不能让一个 N=11 的负相关去删除指标。", "截止": "20261022", "状态": "pending", "可结算判定条件": "3 日序列 3 行齐全（含今日与前两日）；纯度/量价规则须写成 if-then 形式且变量可在 zt_pool 内取值；r 结论必须出现『暂缓/删除』二选一并带 N。"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261021-05", "d": "20261021", "due_d": "20261022", "source": "总审_20261021.json#指派清单/4", "original": {"指派ID": "MA-20261021-05", "指派给": "logic", "深挖任务": "①补 MA-20261020-05 第三项：600267 的升格条件文本必须含 gap∈[-3,+3] 与 开板≤1 两个机械项（今日该票 +5.12%、未涨停、未列入观察，属漏交付）；②三季报池扩容至公告≤20261022，并给出『池∩涨停』的日序列（至少 3 日），回答『新窗口是零承载还是尚未到点』；③在 600487 的出清线上补一条时间止损（若至 20261023 仍未出现第二只涨停，即便未破 47.74 也减半），使业绩孤点线索有明确终止日。", "理由": "三季报窗口正在打开（今日池 122 只∩涨停 0），若不作日序列，明日的『0 只』与后日的『0 只』无法区分是结构还是时点；600267 是唯一跨路共振票（资金×业绩）却被漏交付，属可结算性缺口。", "截止": "20261022", "状态": "pending", "可结算判定条件": "600267 文本含两个机械项（可 grep『gap∈[-3,+3]』与『开板≤1』）；三季报池日序列 ≥3 行；600487 出清条件含明确日期与减半比例。"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261022-01", "d": "20261022", "due_d": "20261023", "source": "总审_20261022.json#指派清单/0", "original": {"指派ID": "MA-20261022-01", "指派给": "limitup", "深挖任务": "补 M-04 的最后一个缺口：把『冰点（温度<25）』窗口内的复合桶做可成交剔除后重算，至少要三格——①封单比<0.5%×换手3-10%（现 n=100/+0.07%/+0.770pp）②封单比≥4%×炸0③首封>14:30×首板；每格给 n／剔除只数／剔除后超额pp／胜率，并明确回答『003021 这类薄封中换手票在可成交口径下还剩多少超额』。附带项：在页面/字段上标注一进二权威值14.7%，停用 _情绪先行指标#晋级 的0.042作极值叙事。", "理由": "今日 M-04 只做到『封单比单维』的可成交重算，冰点内复合桶仍是全池口径，而 003021/603370 的权重正建立在这些复合桶上；不补这一步，明日的权重仍是悬空的。", "截止": "20261023", "状态": "待承接"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261022-02", "d": "20261022", "due_d": "20261023", "source": "总审_20261022.json#指派清单/1", "original": {"指派ID": "MA-20261022-02", "指派给": "auction", "深挖任务": "①把『极寒|跌停≥30|高开0~5』子集（现 n=12/66.7%/+1.16%）扩样至 n≥25（至20261030），且必须再报一版『可成交剔除后』的均收与胜率（剔 open==high==low 与 gap≥9.5%∧open==high），给出两值差；②处置在持 002626 金达威（weight 2.0、buy_date 20261020）：卖或续持必须在交易计划里写明，并把结果落回 _模拟盘/auction/状态.json；③在交易计划模板里加一行『在持仓校验（读状态.json#持仓）』，禁止再出现『notes 只提 001239』式漏项。", "理由": "M-07 暴露的是账本与计划文本脱钩：不是判断错，是流程会持续低估总仓（2pp 级别），D档额度判断会被带偏。", "截止": "20261023", "状态": "待承接"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261022-03", "d": "20261022", "due_d": "20261023", "source": "总审_20261022.json#指派清单/2", "original": {"指派ID": "MA-20261022-03", "指派给": "theme", "深挖任务": "①机器人线『二板数/开板占比/封单中位』做至少5日序列（20261016~20261022），回答『宽度13是反抽还是扩散』需要的是斜率而不是单点；②回答『若603278明晨被gap闸门弃单，机器人线的旗帜换成谁』——给候选（603028 封单率1.90%/002249 1.57%/603370 0.201%）的 n/桶/可成交性对照，并写明换旗的机械条件；③把『质量跃迁须双日确认（T日≥1.5% ∧ T-1日≥1.0% ∧ T日换手≤T-1×1.5）』做成可调用判据，回测近20笔看误判率。", "理由": "603278 被我剔掉后，theme 的『只做旗帜』策略在明日无旗可做；若不预设换旗规则，会退化成『看谁涨得好就跟』。", "截止": "20261023", "状态": "待承接"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261022-04", "d": "20261022", "due_d": "20261023", "source": "总审_20261022.json#指派清单/3", "original": {"指派ID": "MA-20261022-04", "指派给": "logic", "深挖任务": "①把『13只机器人票逐只对F10主营的卡位纯度（真卡位3/13=23.1%，严格模板节点15.4%）』做成每日复算字段并落盘（含主营构成占比、毛利、对应链条节点），以后每天给纯度而不是给一次快照；②给『纯度≥50% ∧ 涨停』子集的历史 n/执1胜率/均收（本路已有链条纵深库，可直接 union）；③三季报池日序列补齐至5日（现4日：2/2/0/0）。", "理由": "23.1% 这个数字是今日逻辑路最有价值的发现，但它是手工一次性快照，明天就过期；不库化就无法进入权重。", "截止": "20261023", "状态": "待承接"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261022-05", "d": "20261022", "due_d": "20261023", "source": "总审_20261022.json#指派清单/4", "original": {"指派ID": "MA-20261022-05", "指派给": "lhb", "深挖任务": "①把『股票级净额』写成脚本字段并双值并列落盘：值A=剔区间榜后每码1行（现 -0.900亿／22-56为正）、值B=含区间榜行的同码全行（+1.295亿／29-65），字段名分别 lhb_net_stock_dedup / lhb_net_stock_with_interval，并在页面注明『区间榜是3日累计、不可与日榜相加』；②出『S/A 买额占全榜买额比』逐日序列（现9.5%）+『A档可用净额占比』（现21.3%），用于 T-20261022-02 结算；③把 56 只的每码重复上榜原因去重规则写进结算脚本注释与自检。", "理由": "同一个 -0.90亿 今天被三方算出三个数（-0.90／+1.295／-0.162），根因不是算错而是口径未落成字段；不落字段，明日还会第三次吵。", "截止": "20261023", "状态": "待承接"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261023-01", "d": "20261023", "due_d": "20261026", "source": "总审_20261023.json#指派清单/0", "original": {"指派ID": "MA-20261023-01", "指派给": "logic", "深挖任务": "①修正并解释 688836 价格口径P0（153.20 vs 双源624.00），把『先定权重再取整股数』改为『先算 min_lot×价/nav』；②对全部buys新增 min_lot_weight 字段；③参考价>150元的票若 min_lot_weight>单票上限，必须标『不可执行』而非用拟权重硬凑；④用新算式复算 002979 的2.13%确认无变化。", "理由": "M-06：688836 拟3.02%实12.30%，越档4倍且闸门/止损线整段失效，是本日唯一P0。", "截止": "20261026", "状态": "待承接"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261023-02", "d": "20261023", "due_d": "20261026", "source": "总审_20261023.json#指派清单/1", "original": {"指派ID": "MA-20261023-02", "指派给": "limitup", "深挖任务": "①封单比并列双分母（feng_ratio_amt=封单/成交、feng_ratio_float=封单/流通市值），任何『薄封/厚封』结论须标明分母；②撤掉『质量分预测执1 max<50%⇒C档』类档位依据，改用环境六腿＋可成交口径桶；③把『软件线7家』改为归位口径『金融科技4只』。", "理由": "M-08（双口径第三次复发）＋M-09（自证循环）＋检查四项.题材一致 的二级瑕疵。", "截止": "20261026", "状态": "待承接"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261023-03", "d": "20261023", "due_d": "20261026", "source": "总审_20261023.json#指派清单/2", "original": {"指派ID": "MA-20261023-03", "指派给": "lhb", "深挖任务": "把『封板质量门（炸≤3，判能否封住）』与『可成交正桶（炸≥5，判次日能否买到且正收益）』做成一张交互表：炸板次数 0/1/2/3/4/5/≥6 各档的执1胜率与均收（每档n≥200，另给一列可成交子集），用同一质量库口径回答『003021这类票该买还是该弃』；同时更正 applied effect 的 6+3+3 算式。", "理由": "M-05：两库同一因子符号相反，是今日最有价值的矛盾，需一次性用数据封掉；M-12 算式瑕疵。", "截止": "20261026", "状态": "待承接"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261023-04", "d": "20261023", "due_d": "20261026", "source": "总审_20261023.json#指派清单/3", "original": {"指派ID": "MA-20261023-04", "指派给": "auction", "深挖任务": "①写『门豁免规程』：任何交易日前不得临时豁免自己已发布的仓位门；若认为门失效，须先给出新门（含 n 与连续期数阈值）再开仓；②把 925 竞价分位从『软条件』升级为硬gate（≤5%）；③复验 002626/002639 清仓实际落地（成交价/股数/日期）并给『持仓只数==表态条数』的校验输出行。", "理由": "M-03 驳回自我豁免；002474 分位30.0% 是其26个执行日最弱档却只当软条件。", "截止": "20261026", "状态": "待承接"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261023-05", "d": "20261023", "due_d": "20261026", "source": "总审_20261023.json#指派清单/4", "original": {"指派ID": "MA-20261023-05", "指派给": "theme", "深挖任务": "①新增『档位→仓位换算』字段（线级档×阶段→兑现仓上限，本日 A×高潮=≤4%），并写明『线级档≠环境进攻档』；②把『PASS桶 n=22/40.9%/-1.61%』与『封单超强≥4% n=1027/-0.82%』写成选票的显式否决项；③换旗下界放宽（-3%→-5%）后须报代价：新增样本n与均收变化；④时间/封单读数改用 zt_pool 逐行复算口径并写明分母与时点。", "理由": "M-02（A档与2%脱钩的根因是缺换算层）＋M-10（301502负桶）＋M-13（读数与zt_pool不符）。", "截止": "20261026", "状态": "待承接"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261023-06", "d": "20261023", "due_d": "20261026", "source": "总审_20261023.json#指派清单/5", "original": {"指派ID": "MA-20261023-06", "指派给": "lhb", "深挖任务": "①建『线级额度』字段：同一大方向（归位口径）合计权重与其上限（本席定7%），并在计划notes显式登记（本日须写明300296属机器人线、603721属传媒线，两线分别合计）；②建立『零交集+同线』常态化登记（每交易日记录buys交集数与同线占比），连续5日后报是否定型。", "理由": "M-04：8只并集零交集但5只同线，风险在同线相关而非分散。", "截止": "20261026", "状态": "待承接"}, "status": "acknowledged", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261026-01", "d": "20261026", "due_d": "20261027", "source": "总审_20261026.json#指派清单/0", "original": {"指派ID": "MA-20261026-01", "指派给": "lhb", "深挖任务": "①把 min_lot_weight 纳入席位路荐票的前置硬校验：每只荐票必须输出『最小交易单位×参考价/nav = x%，可执行=布尔』，x>单票上限时标不可执行并写明理由（本日 688386 200股×46.56=9,312元/1,001,122=0.93% 可执行，但该字段此前从未输出）；②纠正线级额度归属：_题材归位_20261026.json#映射 是逐票字典（{代码:{大方向,环节,催化,...}}，55条），以 #映射.大方向 为键重算——688386 应记机器人线（今日机器人线合计 2.0%，非塑料线 2.0%/机器人线 0.0%），并复核 603138/002696/600558 的线归属；③把『北向(深股通)+机构专用合计净卖≥0.3亿 ⇒ 降为观察』写成席位路的硬规则并回溯 10 日验证。", "理由": "M-05（归位库有逐票字段，lhb 事实性错误导致线归属错）+ MA-20261023-06 承接瑕疵 + 昨日 MA-01③ 同类风险（min_lot 越档）在席位路尚未建立防线。", "可结算判定条件": "20261027 的 _交易计划_lhb_20261027.json#notes 是否同时含 ①每只票的 min_lot_weight 数值与可执行布尔（缺任一只即未完成）②线级额度表以『大方向』为键且给出 line_source=_题材归位_20261027.json#映射 路径 ③新规则条文全文。缺任一即判未完成。", "截止": "20261027", "状态": "待承接"}, "status": "pending", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261026-02", "d": "20261026", "due_d": "20261027", "source": "总审_20261026.json#指派清单/1", "original": {"指派ID": "MA-20261026-02", "指派给": "auction", "深挖任务": "①荐票前必须执行污染硬闸：对每只候选输出一行 [GATE 污染: 代码 清单名 源1净买亿 => 动作]，源1净买<0 即剔（今日 002535 分歧清单/源1 -0.398亿 未剔，是直接失败样本）；②把『925竞价成交额分位≤5%』的判定脚本、判定时点（09:25:00 后第几秒）、未判定时的默认动作（=不下单）写进计划正文，禁止只写条件不写判定方式；③对 002535 补一条自检：同一只票『T+1价格记忆』不得作为当日买入的唯一正证据（须同时有当日资金或封板证据）。", "理由": "M-01（同票反向，auction 一路买、lhb 一路剔）+ 检查四项④（污染过滤未机械执行）+ MA-20261023-04②升级后仍缺可执行判定行。", "可结算判定条件": "20261027 计划文件是否含 ①至少一行 [GATE 污染: ...] 结构化输出（候选票全覆盖，缺一票即未完成）②分位判定脚本名+判定时点+默认动作三要素 ③『T+1记忆不作唯一正证据』条文。缺任一即判未完成。", "截止": "20261027", "状态": "待承接"}, "status": "pending", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261026-03", "d": "20261026", "due_d": "20261027", "source": "总审_20261026.json#指派清单/2", "original": {"指派ID": "MA-20261026-03", "指派给": "limitup", "深挖任务": "①给出『2板×13:00后首封』的**合并桶**（把 13:00-14:00 与 ≥14:00 合并、炸≤1 与炸2-3 分列），每格必须 n≥30 并给胜率/均收/超额pp（今日用于荐 000700 的『2板×13:00-14:00×炸≤1 n=8/+3.471%』无统计效力，只能作描述）；②消费席位结构：对荐票输出『北向+机构专用合计净额』字段，合计净卖≥0.3亿即降观察（今日 002931 深股通-4235万+机构-648万=-0.488亿 仍被荐 0.43%）；③把『首封≥13:00 11只/20.0%』更正为逐行复算值 12只/21.8%（差1只为 002931 首封130012，边界需明确 >13:00 还是 ≥13:00）。", "理由": "M-06（纯度崩塌 vs n=8 荐票并存）+ M-03 边界口径 + 002931 席位结构未消费。", "可结算判定条件": "20261027 文件是否含 ①合并桶至少 4 格且每格 n≥30 的胜率/均收/超额三数 ②每只荐票的『北向+机构合计净额』数值 ③首封时点口径定义一句（含边界符号）。缺任一即判未完成。", "截止": "20261027", "状态": "待承接"}, "status": "pending", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261026-04", "d": "20261026", "due_d": "20261027", "source": "总审_20261026.json#指派清单/3", "original": {"指派ID": "MA-20261026-04", "指派给": "logic", "深挖任务": "①对 000700 给出票级『贴标』证据：THS 原文『人形机器人+汽车外饰件+毛利率提升』中机器人业务的收入占比/主营构成（数据源与报告期须写明），并给出贴标三档定义（真卡位≥50%／相邻／贴标=0）的可机械判定规则；②0 buys 的机会成本量化：以『温度<25 后次日升 31/34（n=34，中位+20.65）』为背景，算『若明日按 2% 参与且命中冷区历史均收（+0.28%~-1.63%）』的机会成本区间上限，写成一段可复算文字，避免『永远空仓』的隐性偏移。", "理由": "M-06（贴标判定缺票级证据，五路共用但无一路能复算）+ 检查四项②（真卡位1/27 是今日最关键的结构事实）+ 昨日 MA-01 已由本路高质量承接，能力可延伸。", "可结算判定条件": "20261027 文件是否含 ①000700 的机器人业务占比数值+数据源路径+报告期 ②贴标三档阈值定义（含量纲与判定字段）③0仓机会成本一段含 n、区间与算式。缺任一即判未完成。", "截止": "20261027", "状态": "待承接"}, "status": "pending", "evidence": [], "conclusion": null, "actual": null}, {"schema_version": 1, "id": "MA-20261026-05", "d": "20261026", "due_d": "20261027", "source": "总审_20261026.json#指派清单/4", "original": {"指派ID": "MA-20261026-05", "指派给": "theme", "深挖任务": "①字段拆分：顶层『档位』改名为『线级档』，新增『环境档』字段（取值域限{进攻,中性,防守}，今日应=防守），并在文件内保留两者换算关系——否则跨路机械比对必然误判（本日已发生：4C1B 假分歧）；②给出『卡位纯度=0 组（贴标25只）』的桶级统计：n/胜率/执1均收/超额pp，n≥30 才算证据，否则明写『仅纪律』；③『封单超强≥4%』与『PASS桶』两个否决项已列（昨日MA-05②），补一条『否决后剩余候选数』的月度序列（近10日：候选数→否决数→留存数），用于验证否决链是否过严。", "理由": "M-02（同名字段异义）+ M-06（贴标结构否决无桶级统计）+ 昨日 MA-20261023-05 已承接四项，本路承接能力已验证可靠。", "可结算判定条件": "20261027 文件是否含 ①『线级档』与『环境档』两字段且环境档∈{进攻,中性,防守} ②纯度=0 组的 n/胜率/均收三数（n<30 须明写不具统计效力）③近10日 候选→否决→留存 序列。缺任一即判未完成。", "截止": "20261027", "状态": "待承接"}, "status": "pending", "evidence": [], "conclusion": null, "actual": null}], "artifact": "D:\\hermes\\profiles\\a\\cache\\scratch\\panzhong_20261026\\master_9caaf7b3eb3c4aaf