def r_chart_lifeaxis(d):
    """图2 主流生命周期七段轴: 萌发→启动→发酵→高潮→退坡→退潮→消亡
    数据源: 题材生命周期_{d}.json 阶段表; 每段列该段的线(线名+陷阱+预判→概率)
    锚点 LIFECYCLE 成对; 零编造: 概率 None 显示 ?"""
    lc = load_json('题材生命周期_%s.json', d)
    if lc is None:
        return ''
    table = lc.get('阶段表') or []
    if not table:
        return ''
    seg_order = ['萌发', '启动', '发酵', '高潮', '退坡', '退潮', '消亡']
    by_seg = {}
    for r in table:
        by_seg.setdefault(r['阶段'], []).append(r)
    segs = ''
    for seg in seg_order:
        lines = by_seg.get(seg) or []
        has = bool(lines)
        if not lines:
            segs += '<div class="lseg"><div class="lt">%s</div><span class="ll mut">—</span></div>\n' % seg
            continue
        items = ''
        for r in lines:
            nm = _esc(r['线'])
            trap = r.get('陷阱') or ''
            preds = sorted(r.get('预判') or [], key=lambda p: -(p.get('概率') if p.get('概率') is not None else -1))
            p = preds[0] if preds else {}
            prob = ('%.0f%%' % (p['概率'] * 100)) if p.get('概率') is not None else '?'
            to = p.get('转移') or ''
            arrow = (' <span class="mut">→%s %s</span>' % (_esc(to), prob)) if to else ''
            trap_html = (' <span class="lwarn">⚠%s</span>' % _esc(trap)) if trap else ''
            items += '<span class="ll"><b>%s</b>%s%s</span>' % (nm, trap_html, arrow)
        segs += '<div class="lseg on"><div class="lt">%s</div>%s</div>\n' % (seg, items)
    head = ('<!--LIFECYCLE-->\n'
            '<div class="card"><h3 style="margin:0 0 8px">主流生命周期·七段轴 '
            '<span class="hint">萌发→启动→发酵→高潮→退坡→退潮→消亡 · 线落点=机器阶段 · 陷阱=标记不占段 · 概率=历史转移频率(N&lt;3标?)</span></h3>'
            '<div class="lifeaxis">%s</div>'
            '<p style="margin:8px 0 0" class="mut">机械底座(题材生命周期.py); 预判=方向+概率, 次日 --settle 机械化结算(兑现/证伪/待定); '
            '强度(一字/封单/炸板)四维不含, 判断修正见下折叠原文。</p></div>\n'
            '<!--/LIFECYCLE-->\n' % segs)
    return head


