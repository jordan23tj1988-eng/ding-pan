# -*- coding: utf-8 -*-
"""生成盯盘台.py —— 读 _学习/judgment_YYYYMMDD.json → 渲染6页+存档+自动历史。用法: python 生成盯盘台.py [YYYYMMDD]"""
import os,sys,json,glob,datetime
BASE=r"D:\股票数据\市场数据"
if not os.path.isdir(BASE):
    g=glob.glob("/sessions/*/mnt/股票数据/市场数据"); BASE=g[0] if g else BASE
SITE=os.path.join(BASE,"复盘","盯盘台"); ARC=os.path.join(SITE,"archive"); L=os.path.join(BASE,"_学习")
CSS='\n:root{color-scheme:light;--ink:#1c2530;--sub:#5b6672;--line:#e6e1d8;--paper:#f6f4ef;--card:#fffdf9;--up:#c0392b;--down:#1e8449;--hit:#0f766e;--half:#b45309;--miss:#b91c1c;--accent:#8a6d3b;}\n*{box-sizing:border-box;margin:0;padding:0}\nbody{background:var(--paper);color:var(--ink);font-family:-apple-system,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif;line-height:1.65;-webkit-font-smoothing:antialiased}\n.nav{position:sticky;top:0;z-index:9;background:rgba(28,37,48,.97);display:flex;gap:2px;align-items:center;padding:10px 18px;box-shadow:0 2px 12px rgba(0,0,0,.15);flex-wrap:wrap}\n.nav .brand{color:#c9b892;font-size:13px;letter-spacing:2px;font-weight:700;margin-right:12px}\n.nav a{color:#c3ccd3;text-decoration:none;font-size:13px;padding:6px 12px;border-radius:8px;transition:.15s}\n.nav a:hover{background:rgba(255,255,255,.08);color:#fff}\n.nav a.on{background:#c9b892;color:#1c2530;font-weight:600}\n.nav .upd{margin-left:auto;color:#8a94a0;font-size:11.5px}\n.wrap{max-width:940px;margin:0 auto;padding:24px 16px 60px}\n.hero{background:linear-gradient(135deg,#1c2530,#2f3a46 60%,#3a4b3f);color:#f4efe6;border-radius:18px;padding:26px 30px;box-shadow:0 12px 30px rgba(28,37,48,.2)}\n.hero .kick{font-size:12px;letter-spacing:3px;color:#c9b892;text-transform:uppercase}\n.hero h1{font-size:23px;margin:8px 0 6px;font-weight:700}\n.hero p{color:#c3ccd3;font-size:13.8px;max-width:670px}\n.stance{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px}\n.pill{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.18);padding:6px 14px;border-radius:22px;font-size:13px;color:#eadfca}\n.pill b{color:#fff}.pill.warn{background:rgba(192,57,43,.22);border-color:rgba(192,57,43,.4);color:#f3c8c2}\nh2{font-size:16px;margin:30px 0 4px;padding-left:12px;border-left:4px solid var(--accent)}\nh2.hot{border-left-color:var(--up)}\n.hint{color:var(--sub);font-size:12.5px;margin:4px 0 14px;padding-left:14px}\n.strip{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px}\n.kv{flex:1;min-width:120px;background:var(--card);border:1px solid var(--line);border-radius:12px;padding:13px 15px}\n.kv .l{font-size:12px;color:var(--sub)}.kv .v{font-size:19px;font-weight:800;margin-top:3px}\n.dn{color:var(--down)}.up{color:var(--up)}.mut{color:var(--sub)}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px 20px;margin-top:14px;box-shadow:0 3px 9px rgba(0,0,0,.03)}\n.card p{font-size:13.7px;color:#3f4854}\n.card.hotcard{border:1px solid #e3c7bf;background:linear-gradient(135deg,#fffaf7,#fbf0ec)}\n.gate{display:flex;gap:10px;flex-wrap:wrap}\n.gate .g{flex:1;min-width:110px;text-align:center;border:1px solid var(--line);border-radius:10px;padding:9px}\n.gate .g .t{font-size:12px;color:var(--sub)}.gate .g .s{font-weight:700;margin-top:2px}\n.s-weak{color:var(--miss)}.s-mid{color:var(--half)}.s-ok{color:var(--hit)}\n.two{display:flex;gap:14px;flex-wrap:wrap;margin-top:14px}\n.mith{flex:1;min-width:270px;background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px 20px;text-decoration:none;color:inherit;display:block;transition:.15s}\n.mith:hover{transform:translateY(-2px);box-shadow:0 10px 24px rgba(0,0,0,.09)}\n.mith h3{font-size:15px;margin-bottom:8px;display:flex;justify-content:space-between}.mith h3 .arw{color:var(--accent)}\n.mith p{font-size:13px;color:#4a4c50}\ntable{width:100%;border-collapse:collapse;margin-top:6px;font-size:13px}\nth,td{text-align:left;padding:8px 10px;border-bottom:1px solid var(--line);vertical-align:top}\nth{color:var(--sub);font-weight:600;font-size:12px}\n.dS{color:#8a1c8a;font-weight:700}.dA{color:var(--hit);font-weight:700}.dB{color:var(--sub)}.dC{color:var(--miss)}\n.tag2{display:inline-block;font-size:11px;padding:1px 7px;border-radius:9px}\n.t-attack{background:#e2f1ef;color:var(--hit)}.t-watch{background:#fbeed8;color:var(--half)}.t-avoid{background:#f7e0e0;color:var(--miss)}\n.tl{position:relative;margin-top:10px;padding-left:22px}\n.tl:before{content:"";position:absolute;left:6px;top:4px;bottom:4px;width:2px;background:var(--line)}\n.tli{position:relative;padding:0 0 18px 8px}\n.tli:before{content:"";position:absolute;left:-19px;top:4px;width:11px;height:11px;border-radius:50%;background:var(--accent);border:2px solid var(--paper)}\n.tli .d{font-size:12px;color:var(--accent);font-weight:700}\n.tli .h{font-size:14px;font-weight:600;margin:2px 0 4px}.tli .b{font-size:13px;color:#3f4854}\n.tli .sup{font-size:12px;color:var(--sub);margin-top:5px;background:#efeae0;border-radius:8px;padding:7px 10px}.tli .sup b{color:var(--ink)}\n.qbar{margin:9px 0}.qbar .lab{display:flex;justify-content:space-between;font-size:12.5px;margin-bottom:3px}\n.track{height:9px;background:#ece7dc;border-radius:5px;overflow:hidden}.track>i{display:block;height:100%;border-radius:5px;background:linear-gradient(90deg,#8a6d3b,#c0392b)}\n.track.teal>i{background:linear-gradient(90deg,#0f766e,#3a9d8f)}\n.base{font-size:11.5px;color:var(--sub);margin-top:4px}\n.ladder{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px;align-items:stretch}\n.rung{background:var(--card);border:1px solid var(--line);border-radius:8px;padding:8px 10px;text-align:center;min-width:80px}\n.rung .lv{font-size:12px;color:var(--sub)}.rung .nm{font-size:12.5px;font-weight:600;margin-top:2px}\n.rung.gap{background:#f7e0e0;border-style:dashed;border-color:#e0b4b4;color:var(--miss)}\n.rung.high{border-color:#c0392b}\n.foot{margin-top:32px;padding:15px 18px;background:#efeae0;border-radius:12px;font-size:12.2px;color:var(--sub)}.foot b{color:var(--ink)}\n.badge{display:inline-block;font-size:11px;padding:1px 8px;border-radius:10px;font-weight:600}\n.bA{background:#e6f0ee;color:#0f766e}.bC{background:#faf0df;color:#b45309}.bMix{background:#eee9f5;color:#6b4fa0}\n.hlist{list-style:none}.hlist li{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:14px 16px;margin-top:10px;display:flex;gap:14px;align-items:center;flex-wrap:wrap}\n.hlist .dt{font-weight:800;font-size:15px;flex:0 0 96px}.hlist .st{flex:1;font-size:13.3px;color:#3f4854;min-width:200px}\n.hlist a.go{color:var(--accent);text-decoration:none;font-size:13px;font-weight:600;white-space:nowrap}\n'

NAV=[("index.html","概览"),("cycle.html","周期情绪"),("theme.html","主线题材"),("lhb.html","龙虎榜"),("auction.html","竞价"),("history.html","历史")]
def nav(active,upd):
    s='<div class="nav"><span class="brand">情绪盯盘台</span>'
    for h,l in NAV:
        cls="on" if h==active else ""
        s+='<a class="'+cls+'" href="'+h+'">'+l+'</a>'
    return s+'<span class="upd">更新 '+upd+'</span></div>'
def shell(title,navbar,body):
    return ('<!DOCTYPE html><html lang="zh-CN"><head><meta charset="UTF-8">'
            '<meta name="viewport" content="width=device-width,initial-scale=1.0"><title>'+title+
            '</title><style>'+CSS+'</style></head><body>'+navbar+'<div class="wrap">'+body+'</div></body></html>')
def build(date):
    os.makedirs(ARC,exist_ok=True); os.makedirs(L,exist_ok=True)
    j=json.load(open(os.path.join(L,"judgment_"+date+".json"),encoding="utf-8"))
    upd=j.get("更新label",date); b=j["bodies"]
    titles=[("index","概览"),("cycle","周期情绪"),("theme","主线题材"),("lhb","龙虎榜"),("auction","竞价")]
    for k,t in titles:
        fn=k+".html"
        open(os.path.join(SITE,fn),"w",encoding="utf-8").write(shell("情绪盯盘台 · "+t,nav(fn,upd),b[k]))
    topbar=('<div class="nav"><span class="brand">情绪盯盘台 · 存档</span>'
            '<a href="../index.html">← 返回概览</a><a href="../history.html">历史列表</a>'
            '<span class="upd">冻结于 '+upd+'</span></div>')
    open(os.path.join(ARC,date+".html"),"w",encoding="utf-8").write(shell("复盘存档 "+date,topbar,j["archive_body"]))
    idxp=os.path.join(L,"history_index.json")
    idx=json.load(open(idxp,encoding="utf-8")) if os.path.exists(idxp) else {}
    idx[date]=j.get("一句话","")
    json.dump(idx,open(idxp,"w",encoding="utf-8"),ensure_ascii=False,indent=1)
    dates=sorted([os.path.splitext(os.path.basename(p))[0] for p in glob.glob(os.path.join(ARC,"*.html"))],reverse=True)
    lis=""
    for dt in dates:
        disp=dt[4:6]+"-"+dt[6:8]
        lis+=('<li><span class="dt">'+disp+'</span><span class="st">'+idx.get(dt,"")+
              '</span><a class="go" href="archive/'+dt+'.html">看完整存档 →</a></li>')
    hb=('<div class="hero"><div class="kick">Archive · 历史记录</div><h1>历史复盘存档</h1>'
        '<p>每天18:00收盘后当日完整复盘冻结存档,永久可回看;首页只显示最新一天。</p></div>'
        '<h2>存档列表</h2><ul class="hlist">'+lis+'</ul>'
        '<div class="foot">存档只加不删,对应每日18:00傍晚链路产物。</div>')
    open(os.path.join(SITE,"history.html"),"w",encoding="utf-8").write(shell("情绪盯盘台 · 历史",nav("history.html",upd),hb))
    print("盯盘台已生成:",date,"| 存档天数",len(dates))
if __name__=="__main__":
    build(sys.argv[1] if len(sys.argv)>1 else datetime.date.today().strftime("%Y%m%d"))
