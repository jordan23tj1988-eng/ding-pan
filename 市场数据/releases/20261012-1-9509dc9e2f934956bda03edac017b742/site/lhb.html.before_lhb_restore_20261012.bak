5.9,144.6" fill="none" stroke="#1f2430" stroke-width="2" stroke-dasharray="4 3"></polyline><text x="932" y="270" text-anchor="end" font-size="10" fill="#1f2430">0亿</text><text x="932" y="146" text-anchor="end" font-size="10" fill="#1f2430">60亿</text><text x="932" y="22" text-anchor="end" font-size="10" fill="#1f2430">120亿</text></svg></div><div class="card"><table style="table-layout:fixed;width:100%"><colgroup><col style="width:52px"><col><col><col><col><col style="width:70px"><col style="width:46px"></colgroup><tr><th>日</th><th>机构</th><th>量化</th><th>游资(活跃+知名)</th><th>北向</th><th>总额</th><th>温度</th></tr><tr><td style="white-space:nowrap">10-12</td><td>22<span class="mut">/4.0亿</span></td><td>9<span class="mut">/4.2亿</span></td><td>134<span class="mut">/30.5亿</span></td><td>21<span class="mut">/15.1亿</span></td><td><b>58.9亿</b></td><td><b>13</b></td></tr><tr><td style="white-space:nowrap">10-09</td><td>28<span class="mut">/7.4亿</span></td><td>13<span class="mut">/7.4亿</span></td><td>152<span class="mut">/28.5亿</span></td><td>26<span class="mut">/18.1亿</span></td><td><b>68.0亿</b></td><td><b>27</b></td></tr><tr><td style="white-space:nowrap">10-08</td><td>30<span class="mut">/11.4亿</span></td><td>12<span class="mut">/4.0亿</span></td><td>150<span class="mut">/39.4亿</span></td><td>26<span class="mut">/38.1亿</span></td><td><b>99.6亿</b></td><td><b>72</b></td></tr><tr><td style="white-space:nowrap">09-30</td><td>20<span class="mut">/6.3亿</span></td><td>5<span class="mut">/2.4亿</span></td><td>161<span class="mut">/33.1亿</span></td><td>18<span class="mut">/11.9亿</span></td><td><b>58.4亿</b></td><td><b>12</b></td></tr><tr><td style="white-space:nowrap">09-29</td><td>22<span class="mut">/6.8亿</span></td><td>11<span class="mut">/4.8亿</span></td><td>131<span class="mut">/31.6亿</span></td><td>22<span class="mut">/12.3亿</span></td><td><b>63.7亿</b></td><td><b>17</b></td></tr></table></div>
<!--/FUNDTEMP--></div><div class="card"><div class="" id="claim-lhb-d9c160e4953847ab"><div class="claim-head"><span class="claim-role role-verdict">结论</span><span class="claim-source">判断 · 结论</span></div><p class="mut">判断 · 结论</p><p>C档防守，正式荐票0只、观察4只。20261012龙虎榜83行(当日榜59行/区间累计榜24行)，双源可比53只中一致20、分歧19、强矛盾8、打折6、仅源2未上榜16。资金温度总分位13(冷)，较20261008的72、20261009的27三连降；机构席从30席11.4亿→28席7.4亿→22席4.0亿连续腰斩，量化13席7.4亿→9席4.2亿缩量，知名游资134席30.5亿占全场58.9亿的51.8%成为唯一主导但席次续降(152→134席)。当日榜59行中源1净买为正者23只，其中同时满足双源一致者仅11只；这11只中当日榜出现S/A档席位者只有4只(002264/300829/301052/002242)，且4只的S/A席全部为小样本(n=6~21，分档库小样本阈值n&lt;25)，全池当日榜未出现任何『两席S/A共振』标的，非小样本S/A出手仅2笔且均无效(920627力王股份对应东财拉萨团结路第二S档n=62但该席当日净额为-1万即净卖；920895花溪科技对应东财昌都两江大道A档n=82，按认知库该席位属拉萨散户通道买侧做T承接须降权)。按20260923沉淀的冰点门禁(温度≤25时正式荐票须同时满足源1净买为正、至少一席非小样本S/A或两席S/A共振、且次日接力风险未被涨停拥挤放大)，本日三条同时不成立，故不发出正式荐票。应用本路可复用能力『龙虎榜质量库·净买占比因子』后，源1净买最大的三只(300006莱美药业24.05%、002531天顺风能29.76%、600693东百集团28.74%)全部落入该因子最差桶&gt;20%(n=136，执1胜率36.0%/均涨-0.59%)，被独立降级为观察/剔除；四只观察票的净买占比分别落10-20%最优桶(002264/688004)、5-10%桶(301052)、0-5%桶(300829)。</p></div><div class="" id="claim-lhb-17f7b5b6ef631fe5"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">证据 · 来源</span></div><p class="mut">证据 · 来源</p><p>20261012/lhb.csv</p></div><div class="" id="claim-lhb-49d6b685c89f8c1f"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">证据 · 事实</span></div><p class="mut">证据 · 事实</p><p>原始83行，上榜日均为2026-10-12；按上榜原因剔除含『连续三个交易日』『累计』的区间榜后得当日榜59行、区间累计榜24行。股票级净买额只取源1当日榜口径，同票多原因不累加(如600127金健米业在源1表中重复出现，仅记当日榜净买+0.6479亿)。上榜后1/2/5/10日列全为空，未引用。</p></div><div class="" id="claim-lhb-4eab6fe101f6f72d"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">证据 · 来源</span></div><p class="mut">证据 · 来源</p><p>_学习/龙虎榜双源校验_20261012.json#/metrics</p></div><div class="" id="claim-lhb-3bc3f86aa2b5f372"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">证据 · 事实</span></div><p class="mut">证据 · 事实</p><p>源1代码68、源2代码54、可比53；一致20、分歧19、强矛盾8、打折6、仅源1无席位明细0、仅源2未上榜16。</p></div><div class="" id="claim-lhb-4b744750edecd09e"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">证据 · 来源</span></div><p class="mut">证据 · 来源</p><p>_学习/_席位动向/20261012.csv</p></div><div class="" id="claim-lhb-354a7217a8afb6aa"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">证据 · 事实</span></div><p class="mut">证据 · 事实</p><p>370行席位明细，其中当日榜口径265行、区间累计榜口径105行。当日榜逐票席位档位经_席位分档.json匹配后，全池仅2笔非小样本S/A出手(920627力王股份-东财拉萨团结路第二S档n=62，该席净额-1万；920895花溪科技-东财昌都两江大道A档n=82，认知库判定拉萨散户通道买侧承接降权)。</p></div><div class="" id="claim-lhb-a51598133f3c2c43"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">证据 · 来源</span></div><p class="mut">证据 · 来源</p><p>_学习/_资金温度.json#20261012 / #20261009 / #20261008</p></div><div class="" id="claim-lhb-dfa5153af5e0a7d1"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">证据 · 事实</span></div><p class="mut">证据 · 事实</p><p>20261012总金额58.9亿、温度分位13(冷)：机构22席4.0亿、量化9席4.2亿、知名游资134席30.5亿、北向21席15.1亿、营业部45席5.2亿。逐日对照：20261008=72分位/99.6亿(机构30席11.4亿、量化12席4.0亿、游资150席39.4亿、北向26席38.1亿)；20261009=27分位/68.0亿(机构28席7.4亿、量化13席7.4亿、游资152席28.5亿、北向26席18.1亿)。机构金额三日11.4→7.4→4.0亿；游资金额占全场比30.5/58.9=51.8%。</p></div><div class="" id="claim-lhb-3670c6addc84a901"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">证据 · 来源</span></div><p class="mut">证据 · 来源</p><p>20261012/summary.json</p></div><div class="" id="claim-lhb-4b0a7907dad80472"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">证据 · 事实</span></div><p class="mut">证据 · 事实</p><p>两市成交额15378亿、涨停46家、跌停19家、炸板25家(炸板率0.352)、最高连板10；连板梯队10:1、6:2、3:1、2:14、1:28；涨停扎堆出版6、影视院线4、电网设备4。仅作环境事实，不作为席位资金方向证据。</p></div><div class="" id="claim-lhb-192a81b74591550d"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">证据 · 来源</span></div><p class="mut">证据 · 来源</p><p>_学习/_席位分档.json</p></div><div class="" id="claim-lhb-b8fe14d7f0a5f984"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">证据 · 事实</span></div><p class="mut">证据 · 事实</p><p>更新日20261012，窗口20260401~20261009，笔数18040，席位442，档分布S19/A45/B131/C81/P166，基准全体执1胜率49.3%/均涨0.61%，收缩K=10，n&lt;25标小样本。目标日涉及的S/A席收盘：银河庄河世纪大街S(n=15，收缩63.7%/+2.49%)、中信建投福州东街S(n=17，收缩66.4%/+3.54%)、中国银河桂林中山中路A(n=6，收缩55.8%/+1.09%)、长江上海分公司A(n=21，收缩51.4%/+1.58%)、平安金华李渔路A(n=12，收缩54.2%/+1.61%)——全部为小样本。</p></div><div class="" id="claim-lhb-38fabcee53524b38"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">证据 · 来源</span></div><p class="mut">证据 · 来源</p><p>_学习/_龙虎榜质量库.json#/因子/净买占比</p></div><div class="" id="claim-lhb-6bdc00044bf2c818"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">证据 · 事实</span></div><p class="mut">证据 · 事实</p><p>状态=有效，区分度14.0，单调rho=-0.4，近窗rho=-0.5，权重0.1394，窗口20260401~20260708，样本4607，基准执1胜率48.0%/均涨0.37%。桶：10-20% n=454 执1胜率50.0%/均涨+0.26%(最优)；0-5% n=1300 48.2%/+0.54%；≤0净卖 n=1986 48.9%/+0.50%；5-10% n=731 46.0%/-0.00%；&gt;20% n=136 36.0%/-0.59%(最差)。</p></div><div class="" id="claim-lhb-d9b1c983a5d7eade"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">证据 · 来源</span></div><p class="mut">证据 · 来源</p><p>_学习/_龙虎榜质量库.json#/因子/位置60日 + _学习/_bars_cache</p></div><div class="" id="claim-lhb-c857da3f1744937c"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">证据 · 事实</span></div><p class="mut">证据 · 事实</p><p>位置60日因子状态=有效、区分度3.7、rho=0.5，高位&gt;70%桶 n=2704 执1胜率49.4%/均涨+0.57%(score27.2)为最优桶、中位30-70% n=1312 45.7%/+0.15%、低位&lt;30% n=591 46.4%/-0.01%。本地K线(末行2026-10-12，零后视镜)实测距60日高：002264新华都-3.44%(60日分位89.4%)、300829金丹科技-9.03%(84.4%)、301052果麦文化0.00%(100%，新高)、688004博汇科技-3.75%(93.5%)、300006莱美药业0.00%(新高)、002242九阳股份0.00%(新高，6连板)。</p></div><div class="" id="claim-lhb-ceb8bd288f8e9a5e"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">证据 · 来源</span></div><p class="mut">证据 · 来源</p><p>_学习/席位荐票_20261012.json(发出版，仅作对照)</p></div><div class="" id="claim-lhb-d704452709e40ce6"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">证据 · 事实</span></div><p class="mut">证据 · 事实</p><p>发出版Top5综合分：002264新华都3.42、002242九阳股份2.97、300829金丹科技2.92、605058澳弘电子2.90、301052果麦文化2.73；其口径为S/A席位净买≥1000万且席位净额取源2(EM买侧)口径。独立复核后：002242源1股票级净买为-1.5912亿(源2+0.6328亿)属强矛盾污染嫌疑，其『共振2』(福州东街S 26万+桂林中山中路A 2292万)建立在源2口径上，直接禁荐；605058源1=0.4379亿/源2=1.7158亿=3.92倍打折、当日仅+2.91%非涨停、买前五为中国/摩根大通/汇丰机构外资通道而非游资接力，剔除；余3只保留为观察。</p></div><div class="" id="claim-lhb-576580c25aba6f54"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">证据 · 来源</span></div><p class="mut">证据 · 来源</p><p>_学习/子agent增强/战绩画像_lhb_20261012.json</p></div><div class="" id="claim-lhb-cbf6ff6a5456fa90"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">证据 · 事实</span></div><p class="mut">证据 · 事实</p><p>本路聚合执行胜率32/76=42.1%、均收-0.1%、覆盖39个交易日；最近三日20261008 1/2 +5.32%、20261009 1/3 +0.36%、20260930 0/1 -0.70%。路级历史基准低于50%，冷档环境下不构成加仓理由。</p></div><div class="" id="claim-lhb-ef184fea35f3004e"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">证据 · 来源</span></div><p class="mut">证据 · 来源</p><p>_学习/总审_20261009.json#/指派清单 + #/线索跟踪</p></div><div class="" id="claim-lhb-5c06d5749fd6d8f6"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">证据 · 事实</span></div><p class="mut">证据 · 事实</p><p>MA-20261009-02指派给lhb、截止20261012，要求按现存_席位动向/20261009.csv与龙虎榜双源校验_20261009.json逐代码重审并更正『文件缺失』陈述——本次已承接并完成(见chaining字段)；配套线索M-20261009-LH-01(待指派)同步结清。</p></div><div class="" id="claim-lhb-2d5e0e755b381888"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">判断 · 档位</span></div><p class="mut">判断 · 档位</p><p>C</p></div><div class="" id="claim-lhb-33f81a6b36e986d4"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">判断 · 置信度</span></div><p class="mut">判断 · 置信度</p><p>62</p></div><div class="" id="claim-lhb-1a76c10a6cb54472"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">判断 · 置信度说明</span></div><p class="mut">判断 · 置信度说明</p><p>对『目标日无满足冰点门禁的正式荐票标的、发出版Top5中2只须剔除』这一保守结论置信度较高(负面过滤与档位匹配均在源文件层面可复算)；对目标日具体席位主控、游资接力意图与次日方向置信度低。偏低原因：本路历史执行胜率42.1%、冷档环境跟买预期中等(冷桶48.7%低于温和放量桶61.6%)、观察票仓位需等T+1开盘验证。</p></div><div class="" id="claim-lhb-ac56ba70b65acd35"><div class="claim-head"><span class="claim-role role-condition">条件</span><span class="claim-source">判断 · 可证伪条件</span></div><p class="mut">判断 · 可证伪条件</p><p>①若次日资金温度分位回升至45以上，且出现≥2只非高位标的同时满足源1当日榜净买为正、双源一致、两席以上S/A共振(或≥1席非小样本S/A)、位置可核验，则本日C档限制与该条冰点门禁需重审，可上修档位。②若本日4只观察票(002264/300829/301052/688004)次日T+1开盘买入后T+1收盘胜率&lt;25%且均收&lt;-2%，则『冰点日小样本S/A不值得轻仓』被再次坐实，且须复核是否存在过度保守导致miss。③若被剔除的002242九阳股份次日收盘继续收红&gt;+3%，则『源1净卖=污染嫌疑禁荐』在本案被证伪一次，须单独归因是否为源2口径口径差而非真实出货。</p></div><div class="" id="claim-lhb-1c47dae2aa11d717"><div class="claim-head"><span class="claim-role role-limitation">限制</span><span class="claim-source">判断 · 独立盲区声明</span></div><p class="mut">判断 · 独立盲区声明</p><p>本判断自出结论，未引用任何其他路的结论。无法核验的项已显式标注：①无官方『机构/北向/游资』席位性质标签字段，资金结构仅取_资金温度.json的席次与金额分项，未自行推断五性质归属；②无当日逐笔席位买卖时序，不能判断主控封板/撤单行为；③观察票的T+1可执行性未知(涨停票次日开盘竞价未知)，本判断不含任何T+1及以后信息；④本地K线缓存4187只，若个别代码缓存缺失则该票位置无法核验(本次12只候选全部命中，末行均为2026-10-12)；⑤_席位分档.json窗口截至20261009，席位档位为历史先验，非目标日实证；⑥龙虎榜质量库窗口截至20260708，净买占比/位置60日等因子桶均为历史统计，不构成单票预测。</p></div><span id="claim-lhb-d8cf93918182bba0"></span></div><div class="" id="claim-lhb-63edb95a18a42660"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">旧版原文补充</span></div><p>20261012资金温度总分位<b>13(冷)</b>，较20261008的72分位、20261009的27分位三连降；龙虎榜总金额58.9亿(20261008=99.6亿、20261009=68.0亿)。分项：机构22席4.0亿、量化9席4.2亿、知名游资134席30.5亿、北向21席15.1亿、营业部45席5.2亿。机构金额三日为11.4→7.4→4.0亿(连续腰斩)，量化13席7.4亿→9席4.2亿缩量，北向26席18.1亿→21席15.1亿；知名游资金额占全场30.5/58.9=<b>51.8%</b>为唯一主导，但席次152→134续降，属『机构撤退+量化缩量+游资缩席但握半数金额』的脆弱结构。</p></div><div class="" id="claim-lhb-643c4e60b0ed8fb2"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">旧版原文补充</span></div><p>能力门禁：能力预加载 <code>extension:cap-lhb-netbuy-valid</code>(龙虎榜质量库·净买占比因子)status=applied。回执影响字段 source_locator=<code>_学习/_龙虎榜质量库.json#/因子/净买占比</code> 与 <code>_学习/_席位动向/20261012.csv#/净额,买入金额</code>。</p></div><div class="" id="claim-lhb-ae09781571a84efc"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">旧版原文补充</span></div><div id="table-731fa5613b7926a8"><table><tr><th>净买占比桶</th><th>n</th><th>执1胜率</th><th>执1均涨</th></tr><tr><td>10-20%(最优)</td><td>454</td><td>50.0%</td><td>+0.26%</td></tr><tr><td>0-5%</td><td>1300</td><td>48.2%</td><td>+0.54%</td></tr><tr><td>≤0净卖</td><td>1986</td><td>48.9%</td><td>+0.50%</td></tr><tr><td>5-10%</td><td>731</td><td>46.0%</td><td>-0.00%</td></tr><tr><td>&gt;20%(最差)</td><td>136</td><td>36.0%</td><td>-0.59%</td></tr></table></div></div><div class="" id="claim-lhb-9f73727c5986d5e0"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">旧版原文补充</span></div><p>因子状态=有效、区分度14.0、单调rho=-0.4、权重0.1394，窗口20260401~20260708、样本4607、基准执1胜率48.0%/均涨+0.37%。若该因子状态后续转为淘汰，则本条回执失效。</p></div><div class="card"><span id="claim-lhb-0b8fa0fa764f06d8"></span><span id="claim-lhb-bd3af540de998752"></span><span id="claim-lhb-aff5b3611e2a10eb"></span><span id="claim-lhb-482aba48c4f2139d"></span><span id="claim-lhb-9be832f35aedd41f"></span><span id="claim-lhb-e295c2a44d8b448b"></span><span id="claim-lhb-a9591e71d59c672d"></span><span id="claim-lhb-e98e250e6cd1a5de"></span><span id="claim-lhb-87fd257704a290a5"></span><span id="claim-lhb-00a4cec4c9b13ed3"></span><span id="claim-lhb-65e22b21e9f3d82c"></span></div><div class="" id="claim-lhb-864efdf5adb79cd2"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">旧版原文补充</span></div><p><a href="#component-FUNDTEMP">回看本段权威组件中的原条目</a></p></div><div class="" id="claim-lhb-10160e9f0685b535"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">旧版原文补充</span></div><p><a href="#component-FUNDTEMP">回看本段权威组件中的原条目</a></p></div></section><section id="ledger"><h2>三 龙虎榜台账</h2><div id="component-LHBLEDGER"><!--LHBLEDGER--><details class="chain" open><summary><b>10-12</b> <span class="chip cold">最新</span> 上榜68 · 机构在场30只 · S/A出手8笔</summary><div class="inner"><div class="strip"><div class="kv"><div class="l">上榜(买侧明细)</div><div class="v">68</div></div><div class="kv"><div class="l">机构在场</div><div class="v">30</div></div><div class="kv"><div class="l">S/A出手</div><div class="v">8笔</div></div></div><p style="font-weight:700;margin:8px 0 4px;border-left:3px solid var(--accent);padding-left:8px">当日席位路Top5荐票(S/A席位动向v3·第2路)</p><div class="card"><p><a href="#component-SEATCARD">回看同一份数据表</a></p></div><div class="hint">候选=当日S/A席位净买≥1000万(64个S/A,候选7只);席位胜率=滚动执行口径历史值(窗口20260401~20261009),非个股预言;结构分仅辅助。结算列次日由结算脚本原位回填,同一张表不换结构。</div><p style="font-weight:700;margin:14px 0 4px;border-left:3px solid var(--accent);padding-left:8px">今日S/A席位动向全表(出手8笔)</p><div class="card"><div id="table-c99302b4ca7bebb9"><table style="table-layout:fixed;width:100%"><colgroup><col><col style="width:110px"><col style="width:96px"></colgroup><tr><th>S/A席位(滚动战绩)</th><th>买入标的</th><th>金额</th></tr><tr><td style="white-space:nowrap"><span id="shared-6499b50cc848323b"></span><b class="s-ok">[S]</b> 中国银河证券股份有限公司庄河世纪大街证券营业…<br><span class="mut">滚动执1 73.3%/3.74% · n=15 · 营业部</span></td><td style="white-space:nowrap"><b>新华都</b><br><span class="mut">002264</span></td><td style="white-space:n