<tr><td>医疗服务</td><td>3</td><td>4</td><td>+2.917 亿</td><td>164.9 亿</td><td>176.87</td></tr>
<tr><td>小家电</td><td>1</td><td>1</td><td>+0.519 亿</td><td>42.8 亿</td><td>121.21</td></tr>
<tr><td>医疗器械</td><td>2</td><td>2</td><td>+2.279 亿</td><td>265.9 亿</td><td>85.70</td></tr>
<tr><td>航运港口</td><td>1</td><td>1</td><td>+0.223 亿</td><td>27.0 亿</td><td>82.51</td></tr>
