# -*- coding: utf-8 -*-
"""涨停对链条.py [d] —— 每日铁例行:当日全部涨停股逐只对产业链快照。
它在哪个板块/环节?环节位置是洼地还是透支?→ 对个股形成更深判断:
低位环节出首板=扩散起点信号 / 透支环节涨停=情绪接力票 / 未入库=待建档(agent当日补模板)。
产出: _学习/涨停对链条_{d}.json"""
import os,sys,json,glob,datetime
import pandas as pd
BASE=os.path.dirname(os.path.abspath(__file__)); L=os.path.join(BASE,"_学习")
def main(d):
    zp=os.path.join(BASE,d,"zt_pool.csv")
    if os.path.isfile(zp): df=pd.read_csv(zp,dtype={"代码":str})
    else:
        import akshare as ak; df=ak.stock_zt_pool_em(date=d)
    df["代码"]=df["代码"].astype(str).str.zfill(6)
    tpl=json.load(open(os.path.join(BASE,"产业链模板.json"),encoding="utf-8"))
    # 代码→(板块,环节)
    code_map={}
    for bk,cfg in tpl.items():
        if bk=="说明": continue
        for seg,ss in cfg.get("环节",{}).items():
            for c,n in ss: code_map[c]=(bk,seg)
    # 载入各板块最新链条位置
    pos={}
    for bk in [k for k in tpl if k!="说明"]:
        fs=sorted(glob.glob(os.path.join(L,f"链条位置_{bk}_*.json")))
        if fs:
            j=json.load(open(sorted(fs)[-1],encoding="utf-8"))
            pos[bk]=j.get("环节",j)  # 兼容两种结构
    matched,unmatched=[],[]
    for _,r in df.iterrows():
        c=r["代码"]; nm=str(r["名称"]); lb=int(pd.to_numeric(r.get("连板数",1),errors="coerce") or 1)
        if c in code_map:
            bk,seg=code_map[c]
            segpos=pos.get(bk,{}).get(seg,{})
            weizhi=segpos.get("位置","无位置数据"); m60=segpos.get("均60日")
            if "洼地" in str(weizhi) or "未启动" in str(weizhi) or "中低位" in str(weizhi):
                pan="★低位环节涨停=扩散起点候选,重点盯环节内跟随"
            elif "透支" in str(weizhi) or "到位" in str(weizhi):
                pan="透支环节涨停=情绪/接力票,高度风险大于产业逻辑"
            else: pan="中高位环节,看环节内相对位置"
            matched.append(dict(代码=c,名称=nm,连板=lb,板块=bk,环节=seg,环节位置=weizhi,环节均60日=m60,快判=pan))
        else:
            unmatched.append(dict(代码=c,名称=nm,连板=lb,行业=str(r.get("所属行业",""))))
    out={"日期":d,"涨停总数":int(len(df)),"已入库":matched,"未入库待建档":unmatched,
         "口径":"环节位置来自最近一次链条位置.py产出;未入库股=agent当日研究后补进产业链模板.json(模板滚雪球)"}
    json.dump(out,open(os.path.join(L,f"涨停对链条_{d}.json"),"w",encoding="utf-8"),ensure_ascii=False,indent=1)
    print(f"{d} 涨停{len(df)}只: 已入库{len(matched)} / 待建档{len(unmatched)}")
    for m in matched: print(f'  ✓ {m["名称"]}({m["连板"]}板) → {m["板块"]}/{m["环节"]} [{m["环节位置"]}] {m["快判"]}')
    print("  待建档:"+", ".join(f'{u["名称"]}({u["行业"]})' for u in unmatched[:20]))
if __name__=="__main__":
    main(sys.argv[1] if len(sys.argv)>1 else datetime.date.today().strftime("%Y%m%d"))
