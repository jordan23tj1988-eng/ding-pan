" fill="#c0392b"></rect><text x="597" y="279" text-anchor="middle" font-size="9" fill="#8a8272">10/15</text><circle cx="597" cy="288" r="3" fill="#7f9db9"></circle><rect x="628.6" y="234.7" width="24.3" height="31.3" fill="#2e6f5e"></rect><rect x="628.6" y="220.9" width="24.3" height="13.8" fill="#7c5cbf"></rect><rect x="628.6" y="33.0" width="24.3" height="187.9" fill="#c0392b"></rect><text x="641" y="279" text-anchor="middle" font-size="9" fill="#8a8272">10/16</text><circle cx="641" cy="288" r="3" fill="#c0392b"></circle><rect x="672.8" y="234.7" width="24.3" height="31.3" fill="#2e6f5e"></rect><rect x="672.8" y="227.2" width="24.3" height="7.5" fill="#7c5cbf"></rect><rect x="672.8" y="39.3" width="24.3" height="187.9" fill="#c0392b"></rect><text x="685" y="279" text-anchor="middle" font-size="9" fill="#8a8272">10/19</text><circle cx="685" cy="288" r="3" fill="#7f9db9"></circle><rect x="717.0" y="230.9" width="24.3" height="35.1" fill="#2e6f5e"></rect><rect x="717.0" y="224.7" width="24.3" height="6.3" fill="#7c5cbf"></rect><rect x="717.0" y="53.1" width="24.3" height="171.6" fill="#c0392b"></rect><text x="729" y="279" text-anchor="middle" font-size="9" fill="#8a8272">10/20</text><circle cx="729" cy="288" r="3" fill="#7f9db9"></circle><rect x="761.2" y="239.7" width="24.3" height="26.3" fill="#2e6f5e"></rect><rect x="761.2" y="225.9" width="24.3" height="13.8" fill="#7c5cbf"></rect><rect x="761.2" y="80.6" width="24.3" height="145.3" fill="#c0392b"></rect><text x="773" y="279" text-anchor="middle" font-size="9" fill="#8a8272">10/21</text><circle cx="773" cy="288" r="3" fill="#7f9db9"></circle><rect x="805.4" y="235.9" width="24.3" height="30.1" fill="#2e6f5e"></rect><rect x="805.4" y="222.2" width="24.3" height="13.8" fill="#7c5cbf"></rect><rect x="805.4" y="18.0" width="24.3" height="204.2" fill="#c0392b"></rect><text x="818" y="279" text-anchor="middle" font-size="9" fill="#8a8272">10/22</text><circle cx="818" cy="288" r="3" fill="#7f9db9"></circle><rect x="849.6" y="229.7" width="24.3" height="36.3" fill="#2e6f5e"></rect><rect x="849.6" y="214.6" width="24.3" height="15.0" fill="#7c5cbf"></rect><rect x="849.6" y="18.0" width="24.3" height="196.6" fill="#c0392b"></rect><text x="862" y="279" text-anchor="middle" font-size="9" fill="#8a8272">10/23</text><circle cx="862" cy="288" r="3" fill="#c0392b"></circle><rect x="893.8" y="232.2" width="24.3" height="33.8" fill="#2e6f5e"></rect><rect x="893.8" y="222.2" width="24.3" height="10.0" fill="#7c5cbf"></rect><rect x="893.8" y="40.5" width="24.3" height="181.6" fill="#c0392b"></rect><text x="906" y="279" text-anchor="middle" font-size="9" fill="#8a8272">10/26</text><circle cx="906" cy="288" r="3" fill="#c8a24a"></circle><polyline points="66.1,73.8 110.3,90.9 154.5,108.7 198.7,101.6 242.9,111.2 287.1,110.7 331.3,123.6 375.5,23.1 419.7,100.2 463.9,122.4 508.1,115.5 552.3,132.9 596.5,114.8 640.7,18.0 684.9,142.1 729.1,106.8 773.3,132.1 817.5,145.3 861.7,50.7 905.9,87.3" fill="none" stroke="#1f2430" stroke-width="2" stroke-dasharray="4 3"></polyline><text x="932" y="270" text-anchor="end" font-size="10" fill="#1f2430">0亿</text><text x="932" y="146" text-anchor="end" font-size="10" fill="#1f2430">51亿</text><text x="932" y="22" text-anchor="end" font-size="10" fill="#1f2430">102亿</text></svg></div><div class="card"><table style="table-layout:fixed;width:100%"><colgroup><col style="width:52px"><col><col><col><col><col style="width:70px"><col style="width:46px"></colgroup><tr><th>日</th><th>机构</th><th>量化</th><th>游资(活跃+知名)</th><th>北向</th><th>总额</th><th>温度</th></tr><tr><td style="white-space:nowrap">10-26</td><td>27<span class="mut">/9.1亿</span></td><td>8<span class="mut">/3.9亿</span></td><td>145<span class="mut">/32.0亿</span></td><td>27<span class="mut">/19.9亿</span></td><td><b>73.3亿</b></td><td><b>47</b></td></tr><tr><td style="white-space:nowrap">10-23</td><td>29<span class="mut">/11.5亿</span></td><td>12<span class="mut">/9.0亿</span></td><td>157<span class="mut">/40.3亿</span></td><td>23<span class="mut">/18.6亿</span></td><td><b>88.3亿</b></td><td><b>67</b></td></tr><tr><td style="white-space:nowrap">10-22</td><td>24<span class="mut">/4.7亿</span></td><td>11<span class="mut">/4.3亿</span></td><td>163<span class="mut">/29.5亿</span></td><td>16<span class="mut">/7.8亿</span></td><td><b>49.5亿</b></td><td><b>3</b></td></tr><tr><td style="white-space:nowrap">10-21</td><td>21<span class="mut">/6.4亿</span></td><td>11<span class="mut">/4.0亿</span></td><td>116<span class="mut">/25.8亿</span></td><td>17<span class="mut">/15.4亿</span></td><td><b>54.9亿</b></td><td><b>7</b></td></tr><tr><td style="white-space:nowrap">10-20</td><td>28<span class="mut">/9.6亿</span></td><td>5<span class="mut">/3.5亿</span></td><td>137<span class="mut">/24.0亿</span></td><td>23<span class="mut">/24.4亿</span></td><td><b>65.3亿</b></td><td><b>30</b></td></tr></table></div>
<!--/FUNDTEMP--></div><div class="card"><div class="" id="claim-lhb-3b03c8260c9aff4f"><div class="claim-head"><span class="claim-role role-verdict">结论</span><span class="claim-source">判断 · 结论</span></div><p class="mut">判断 · 结论</p><p>C 档（冷区·席位买榜失真·S/A 稀疏），置信 58。当日榜 62 码（67 行，含 4 码同日多榜去重）股票级净买合计 -10.89 亿（正 25/负 37 码），而席位（买五）去重净额 +44.70 亿、真实率 -24.4%（昨 +24.2%）——买榜的『净买』与股票级净额方向相反且差 55.59 亿，本日任何基于席位买榜的看多读数都要先打折。S/A 端：去重后 22 席行（小样本 12/22）、净买 &gt;0 合计仅 2.81 亿、单笔最大 4061 万（002696 联储杭州环城北路）&lt;0.5 亿门槛、单笔≥5000 万 0 笔 ⇒ 『S/A 净额≥1 亿 ∧ 至少 1 笔≥0.5 亿』双条件只过一条，判 S/A 稀疏而非回流；更关键的是 S/A 资金主体在转债端（S/A 转债净 20.48 亿 ÷ S/A 总净 23.30 亿 = 87.9%）。漏斗：55 涨停 → 19 上当日榜（34.5%）→ 13 源1净买&gt;0（6 只净卖剔除）→ 10 过封板三项 → 4 有 S/A 席（600558/603138/002696/688386）→ 3 过净买占比≤20%（剔除 600558 27.61%）→ 3 只终选。最终只给 1 只 2% 试探仓 688386（净买占比 12.55% 落唯一 ≥50% 正桶 + 机构/北向同向 + 封板三项全过），另 3 只观察不下单；在持 002639 明日开盘清出。</p></div><div class="" id="claim-lhb-ef2f7773d447d2d9"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">判断 · 证据</span></div><p class="mut">判断 · 证据</p><p>①S/A 强度三个必读数（本路 2026-10-22 落地规则）：S/A 笔数 13 笔（库口径『净买&gt;0∧买额≥1000万』，占全榜 160 笔的 8.12%，为 13 日序列 3.50%~6.85% 的最高值）；S/A 净买额 2.81 亿（21 席行）；单笔最大 4061 万（002696 联储证券杭州环城北路）——『笔数创新高但单笔金额跌破门槛』＝笔数不是资金强度代理变量，与 2026-10-22 认知条目同构（当日 24 笔亦被证伪）。S 档笔仅 2 笔、A 档笔 11 笔。</p></div><div class="" id="claim-lhb-008d62f1047e30f7"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">判断 · 证据</span></div><p class="mut">判断 · 证据</p><p>②买榜与股票级净额背离（本路第 4 道硬门）：去重后 277 笔/61 码/127 席，席位净额 +44.70 亿、买额 73.25 亿；当日榜 62 码（67 行，4 码同日多榜须按码去重，否则行级合计被虚增到 -10.27 亿）股票级净买合计 -10.89 亿、净买&gt;0 仅 25/62=40.3% ⇒ 真实率 -24.4%。分歧 23 码、强矛盾 11 码、打折 10 码、仅源2无源1 12 码。</p></div><div class="" id="claim-lhb-ea478c693e2c957c"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">判断 · 证据</span></div><p class="mut">判断 · 证据</p><p>③资金风格（去重后，万元）：营业部 169 行 买 271783/净 222981；总部+分公司 54 行 买 170308/净 145251；北向 27 行 买 199340/净 41519；机构专用 27 行 买 91073/净 37250。北向买额 19.93 亿为第二大买侧，但净额仅 4.15 亿（买卖双向对冲），不是单边增量。</p></div><div class="" id="claim-lhb-1cefe0247804bf36"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">判断 · 证据</span></div><p class="mut">判断 · 证据</p><p>④S/A 换场（转债）：_席位动向 中 11/12 开头转债 10 行，其中 S/A 档净额 20.48 亿，是股票端 S/A 净额（2.81 亿）的 7.3 倍，占 S/A 总净 87.9%。按 2026-10-20 落地规则『S/A 转债净额÷S/A 总净≥60% 且 股票端 S/A 独立标的&lt;3 只 ⇒ 当日默认空仓』，本日股票端 S/A 独立标的 7 只（002535/002696/301428/600558/603138/688218/688386）≥3 ⇒ 该默认空仓规则未触发，但换场事实必须计入仓位上限。</p></div><div class="" id="claim-lhb-09b7dbb8d490b487"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">判断 · 证据</span></div><p class="mut">判断 · 证据</p><p>⑤席位档与滚动胜率底座：_席位分档.json 窗口 20260401~20261023、19314 笔、458 席，档分布 S18/A47/B140/C85/P168；全体基准执1 48.9%/+0.67（收缩 K=10）。今日 S/A 席中唯一的非小样本是 中信建投福州东街（A 档 n=25、收缩 56.8%/+2.56%），它落在 301428（非涨停且双源打折）；涨停票的 5 只 S/A 覆盖（8 席行）全部为 n≤24 的小样本——包括 S 档 华泰深圳彩田路 n=24（61.5%/+2.22%，差 1 笔未达非小样本线）。</p></div><div class="" id="claim-lhb-1bfbe5c6208472c1"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">判断 · 证据</span></div><p class="mut">判断 · 证据</p><p>⑥涨停票 S/A 覆盖只有 5 只且席位高度重叠：国泰海通长宁区江苏路（A 档 n=9⚠、57.3%/+1.67%）单独出现在 688386/603138/600558 三只票上（占 5 只的 60%）⇒ 若按『席位出现次数』计共振，会得到虚假共振；按去重独立席位计，涨停票的 S/A 独立席仅 6 个（国泰海通江苏路/华泰深圳彩田路/中信海宁海昌南路/联储杭州环城北路/华鑫深圳分公司/银河桂林中山中路）。</p></div><div class="" id="claim-lhb-08dac40a554f643a"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">判断 · 证据</span></div><p class="mut">判断 · 证据</p><p>⑦环境底色（作战包_全路_20261026）：温度 24.2（昨 53.2）、涨停 55（昨 82）、跌停 25（昨 6）、炸板率 29.5%（昨 12.8%）、最高板 4（昨 6）、梯队 4/1、3/6、2/8、首 40、成交 16088 亿（昨 19563 亿）。本路按温度分档复核 _席位荐票反思 画像（29 个可结算日）：冷区&lt;40 共 19 日、27/66 笔 = 40.9%、加权均收 -0.16%；中性区 10 日、16/39 = 41.0%、-0.59% ⇒ 冷区对本路不是优势区，只是不比中性区更差，故档位取 C、仓位取 2% 试探，不加仓。</p></div><div class="" id="claim-lhb-413637f3aa9190a3"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">判断 · 证据</span></div><p class="mut">判断 · 证据</p><p>⑧引擎机械榜与本路门槛的脱钩率：席位荐票_20261026 Top5 = 002696(3.61)/301428(4.41)/000810(3.63)/600558(3.48)/600178(3.33)。逐票过门槛：301428 双源=打折（源1 0.3176 亿 vs 源2 1.0981 亿）且当日非涨停（涨 17.74%）；000810 仅『连续三日累计』区间榜、无当日榜行 ⇒ 源1 净买不可判；600178 仅区间榜且当日 -9.97%；600558 净买占比 27.61% 落 &gt;20% 负桶；仅 002696 一只全过。5 只中 4 只不可直接用 ⇒ 机械榜只能当候选池。</p></div><div class="" id="claim-lhb-4196400e7f342b0b"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">判断 · 证据</span></div><p class="mut">判断 · 证据</p><p>⑨【MA-03 复算口径自证】本轮用 _ths_zt_pool.json（303 日、19807 条）＋ _bars_cache 重建执1，全样本 n=19371（覆盖 97.8%）、执1 基准 43.0%/-0.32%，与 _涨停质量库.json 基准（n=19404、43.0%/-0.33）一致 ⇒ 复算口径与库同源，可作为本次裁决依据。</p></div><div class="" id="claim-lhb-96fccdfbb4a5615d"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">判断 · 证据</span></div><p class="mut">判断 · 证据</p><p>⑩污染过滤（双源校验 强矛盾 11 码：002343/002354/300990/301313/301660/603466/603901/603933/688071/688218/688836）：与本路候选池（7 只）相交 1 只 688218 江苏北人，席位买五净 +1.31 亿（东财拉萨东环路第一 n=86）但源1 股票级 -0.0088 亿、净买占比 -0.42% ⇒ 判污染嫌疑，已剔出荐票与观察；另 002535 林州重机判分歧且源1 -0.398 亿，一并出局。候选池 7 只 → 双源砍 2 只（28.6%）→ 5 只可用（002696/301428/600558/603138/688386）。</p></div><div class="" id="claim-lhb-6bb47bd96adfc4a4"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">判断 · 档位</span></div><p class="mut">判断 · 档位</p><p>C档（冷区·S/A稀疏·试探仓，单票上限 2%、线级合计上限 7%）</p></div><div class="" id="claim-lhb-762ddf54c4397e61"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">判断 · 置信度</span></div><p class="mut">判断 · 置信度</p><p>58</p></div><div class="" id="claim-lhb-3103c119c0be7c85"><div class="claim-head"><span class="claim-role role-condition">条件</span><span class="claim-source">判断 · 可证伪条件</span></div><p class="mut">判断 · 可证伪条件</p><p>20261027 若 688386 执1（T+1 开→收）≤0 且 观察票 603138 执1 &gt;0 达 2pp 以上 ⇒ 『净买占比优先于席位档』排序键记 0.5 错，下次改以换手 15-30% 桶（n=1320/49.4%/+0.71%）为首要加分项。</p></div><div class="" id="claim-lhb-81fd951efcb20adb"><div class="claim-head"><span class="claim-role role-condition">条件</span><span class="claim-source">判断 · 可证伪条件</span></div><p class="mut">判断 · 可证伪条件</p><p>20261027 若 涨停票中炸板≥4 的票（今日 4 只：301502 炸5、002708 炸5、000678 炸5、603331 炸9）平均执1 - 炸≤1 的 41 只平均执1 ≥ +3pp（方向与新表相反）⇒ MA-03 新表『炸多更优』判当日 regime 失效，降权 50% 并回退到旧封板质量门。</p></div><div class="" id="claim-lhb-66f4e7d0185b241e"><div class="claim-head"><span class="claim-role role-condition">条件</span><span class="claim-source">判断 · 可证伪条件</span></div><p class="mut">判断 · 可证伪条件</p><p>20261027 若温度回升至 ≥40（中性区）而本路仍只给 ≤2% 上限 ⇒ 判档位过严（重复 20261023 的『把档位当 0 仓』错误），须把 C 档改为『条件档』并给出可豁免规程。</p></div><div class="" id="claim-lhb-c0ab5d8ffd91f0ac"><div class="claim-head"><span class="claim-role role-condition">条件</span><span class="claim-source">判断 · 可证伪条件</span></div><p class="mut">判断 · 可证伪条件</p><p>20261027 若 688386 开盘 gap &lt; -3% 或 &gt; +5% 或一字（open==high==low）⇒ 闸门未落，2% 留现金、不换票不递补；该情形不计入荐票战绩（未成交）。</p></div><div class="" id="claim-lhb-9ca1d4a701e96360"><div class="claim-head"><span class="claim-role role-limitation">限制</span><span class="claim-source">判断 · 独立盲区声明</span></div><p class="mut">判断 · 独立盲区声明</p><p>①按指令禁读其他四路判断（auction/theme/logic/limitup判断_20261026.json），故不知 688386/603138 是否与 theme 主线（机器人 27 只）或 limitup 票重叠，跨路交叉验证与会话零交集统计本日缺失。</p></div><div class="" id="claim-lhb-2c87b7d7efe40202"><div class="claim-head"><span class="claim-role role-limitation">限制</span><span class="claim-source">判断 · 独立盲区声明</span></div><p class="mut">判断 · 独立盲区声明</p><p>②昨日复盘_lhb_20261026.json 本机不存在（机制未落地），只能用 _战绩画像_lhb_20261026（49 日按日序列）＋ 状态.json 结算记录替代，故『昨日判断→今日结果』的逐条归因无法闭环。</p></div><div class="" id="claim-lhb-bd85e8e085ba5775"><div class="claim-head"><span class="claim-role role-limitation">限制</span><span class="claim-source">判断 · 独立盲区声明</span></div><p class="mut">判断 · 独立盲区声明</p><p>③主动查证工具 因子快检.py / ifind查.py 本机不存在（已 find 全盘确认），本轮 0 次调用外部查证，全部读数来自自建复算脚本 _ma03_v2.py / _lhb_seat_scan2.py / _lhb_strength.py / _lhb_funnel.py / _ma03_joint.py。</p></div><div class="" id="claim-lhb-39b5394f1b3e32c0"><div class="claim-head"><span class="claim-role role-limitation">限制</span><span class="claim-source">判断 · 独立盲区声明</span></div><p class="mut">判断 · 独立盲区声明</p><p>④002639 雪人集团 20261026 收盘价缺口（_bars_cache 止于 2026-10-23；作战包 缺口 明确：东财 spot 接口 2026-10-26 17:58 实测 RemoteDisconnected）→ 清仓决策不以今日价为依据，只以环境档降级＋席位无续买为依据；若今日大涨则本笔为机会成本，落账时按开盘价结算。</p></div><div class="" id="claim-lhb-291d1110bbcd1dbf"><div class="claim-head"><span class="claim-role role-limitation">限制</span><span class="claim-source">判断 · 独立盲区声明</span></div><p class="mut">判断 · 独立盲区声明</p><p>⑤_席位分档.json 窗口止于 20261023、_龙虎榜质量库.json 更新日 20260710（108 天未重算），所有『收缩执1胜率』是静态估计；_涨停质量库.json 更新至 20261026（本日可用）。</p></div><div class="" id="claim-lhb-e5c2d35df1a65146"><div class="claim-head"><span class="claim-role role-limitation">限制</span><span class="claim-source">判断 · 独立盲区声明</span></div><p class="mut">判断 · 独立盲区声明</p><p>⑥『线』的口径：_题材归位_20261026.json 只给方向聚合计数（机器人 27/消费 8/AI应用 7…）与 B 档 55 只名单，无逐票方向字段，故 688386 的线只能以行业『塑料』代理并已标注（非归位口径），线级额度因此按行业线计。</p></div><div class="" id="claim-lhb-534880afaf51adfe"><div class="claim-head"><span class="claim-role role-limitation">限制</span><span class="claim-source">判断 · 独立盲区声明</span></div><p class="mut">判断 · 独立盲区声明</p><p>⑦席位买五明细天然偏买（卖榜不披露前五），本日真实率 -24.4% 说明偏置极大；荐票理由中凡涉『净买』均已在票级用当日榜源1 复核，但票级源1 本身仍是『买五-卖五』口径，无法穿透未披露卖方。</p></div><div class="" id="claim-lhb-c4d9d82c3114bf6a"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">Master指派承接 · 指派ID</span></div><p class="mut">Master指派承接 · 指派ID</p><p>MA-20261023-03</p></div><div class="" id="claim-lhb-d2b1e9c5334ba3ac"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">Master指派承接 · 响应</span></div><p class="mut">Master指派承接 · 响应</p><p>承接MA-20261023-03: 完成交互表（炸板 0/1/2/3/4/5/≥6 七档，各档 n=10322/3051/1631/1008/711/499/2149 全部 ≥200，另给可成交子集一列 n=9083/2863/1558/971/682/480/2111）→ 深挖结果:{结论(含量化数据): 执1 随炸板次数单调上升（0 档 39.5%/-0.68 → 5 档 52.7%/+0.53），合并后 炸≤3 = 41.7%/-0.47（n=16012）vs 炸≥4 = 49.3%/+0.37（n=3359）；机制是次日均 gap 从 2.61% 单调降到 0.90%，即『封板质量门』判的是明天封不封得住、『可成交正桶』判的是明天开盘接盘能否赚钱，两库符号相反源于买入点不同而非数据冲突。003021 这类（3板+炸5）落 n=499/52.7%/+0.53（可成交 54.8%/+0.64），判『该买』，并以今日真实结果单点校验：20261023 收 91.73 → 20261026 开 93.00 收 96.26，执1 +3.51%（非一字、可成交）。, 可结算判定条件: 20261027 比较涨停票 炸≥4（今日 4 只）与 炸≤1（今日 41 只）的执1 均值差，≥+3pp 则新表获独立验证，≤-3pp 则本表降权 50% 并回退旧门；同时 003021 次日执1 若 ≤-3% 则追加『连板≥3 时炸5 正桶失效』一层限制。}; 并更正 M-12 算式：昨日 applied effect 应写成『若该能力不可用 ⇒ 3 只、权重 6%+3%+3%=12%（其中 002354 按 3% 计入），此时总仓 12%；若 002354 不进 buys（即『误入』不成立）⇒ 2 只、6%+3%=9%；实际发版 = 2 只、4%+2%=6%』——原句『3 只/9%』与分项 6+3+3 不能并存，已按『列出不可用情形的每只权重并求和、并显式说明 002354 是否计入总仓』的可复算写法重写。</p></div><div class="" id="claim-lhb-3d63f0d480c28979"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">Master指派承接 · 指派ID</span></div><p class="mut">Master指派承接 · 指派ID</p><p>MA-20261023-06</p></div><div class="" id="claim-lhb-10badd822d4e14f7"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">Master指派承接 · 响应</span></div><p class="mut">Master指派承接 · 响应</p><p>承接MA-20261023-06: ①『线级额度』字段已建并在 交易计划_lhb_20261026.json#notes 显式登记：本日只有 1 只票 688386 泛亚微透，归位库无逐票方向字段（_题材归位_20261026.json 只给方向聚合计数与 B 档名单），故以行业『塑料』作线代理并标注 → 塑料线合计 2.0%（上限 7%，使用率 28.6%）；机器人线 0.0%（本日无票，上限 7%）；传媒线 0.0%（本日无票，上限 7%）。对照昨日：300296 属机器人线（4.0%）、603721 属传媒线（2.0%），两线分别合计 4.0% / 2.0%，均未触及 7% 上限。另新增『单席额度 institution_cap=3%』：本日 603138 与 688386 同由 国泰海通长宁区江苏路 主导，两票合计会到 4% &gt; 3% 上限，故 603138 只观察、不下单。②『零交集+同线』常态化登记已建立：写入 _学习/_线级额度登记.jsonl（每交易日一行：buys 只数、distinct 席位数、各线合计权重、线内最大单线占比、跨路交集字段），本日为第 1 日，连续 5 日（20261026~20261030）后报是否定型。本日读数：buys 1 只、线 1 条、同线占比 100%（单票）。跨路交集本日无法填写——按指令禁读其他四路判断，交集须由总裁决写入；已在登记行标 cross_route_intersection=null 与原因。→ 深挖结果:{结论(量化): 昨日的『零交集但 5 只同线』风险本日变形为『同一票内部单席独食』：今日涨停票 S/A 覆盖 5 只/8 席行，独立席仅 6 个，其中 国泰海通长宁区江苏路 独占 3 只（60%）；线级看是 3 条不同行业线互不相关，席级看却是 1 个席位 60% 覆盖——线级额度不能替代席位级额度，两者必须同时设上限（线 7% / 单席 3%）。, 可结算判定条件: 连续 5 个交易日（20261026~20261030）每行登记 buys 只数、distinct 席位数、各线合计权重与线内占比；若 5 日内 ≥3 日出现『单席覆盖 ≥2 只荐票』或『单线合计 ≥5%』，则定型为常态规则（线≤7%、单席≤3% 写死）；若 5 日内均未触发，则说明本路荐票天然分散，额度上限降为提示性字段。</p></div><div class="" id="claim-lhb-e884ce7821e89c56"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">能力回执 · schema_version</span></div><p class="mut">能力回执 · schema_version</p><p><a href="#component-FUNDTEMP">回看本段权威组件中的原条目</a></p></div><div class="" id="claim-lhb-77207645fbc34ac4"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">能力回执 · as_of</span></div><p class="mut">能力回执 · as_of</p><p>20261026</p></div><div class="" id="claim-lhb-b7e22875d55999bc"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">能力回执 · route</span></div><p class="mut">能力回执 · route</p><p>lhb</p></div><div class="" id="claim-lhb-88aeba69e116fbd2"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">能力回执 · status</span></div><p class="mut">能力回执 · status</p><p>applied</p></div><div class="" id="claim-lhb-fbf9ff0a92619d03"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">能力回执 · considered_ids</span></div><p class="mut">能力回执 · considered_ids</p><p>extension:cap-lhb-netbuy-valid</p></div><div class="" id="claim-lhb-66c2acc76c73970a"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">applied · id</span></div><p class="mut">applied · id</p><p>extension:cap-lhb-netbuy-valid</p></div><div class="" id="claim-lhb-bcb829dbd96174eb"><div class="claim-head"><span class="claim-role role-evidence">证据</span><span class="claim-source">applied · effect</span></div><p class="mut">applied · effect</p><p>采纳『净买占比』维度后本日名单与总仓各发生一处可复算变化：①600558 大西洋 净买占比 27.61% 落 &gt;20% 负桶（n=136/执1 36.