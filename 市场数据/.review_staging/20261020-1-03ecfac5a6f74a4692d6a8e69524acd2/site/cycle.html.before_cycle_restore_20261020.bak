e><circle cx="722.5" cy="163.3" r="3" fill="#d9a441"></circle><circle cx="763.5" cy="136.9" r="3" fill="#d9a441"></circle><circle cx="804.5" cy="117.4" r="3" fill="#d9a441"></circle><circle cx="845.5" cy="123.5" r="3" fill="#d9a441"></circle><text x="845.5" y="116.5" font-size="10" fill="#d9a441" text-anchor="end">16.7%</text><text x="107.5" y="185" font-size="8.5" fill="#6b7683" text-anchor="middle">09-09</text><text x="189.5" y="185" font-size="8.5" fill="#6b7683" text-anchor="middle">09-11</text><text x="271.5" y="185" font-size="8.5" fill="#6b7683" text-anchor="middle">09-22</text><text x="353.5" y="185" font-size="8.5" fill="#6b7683" text-anchor="middle">09-24</text><text x="435.5" y="185" font-size="8.5" fill="#6b7683" text-anchor="middle">09-28</text><text x="517.5" y="185" font-size="8.5" fill="#6b7683" text-anchor="middle">09-30</text><text x="599.5" y="185" font-size="8.5" fill="#6b7683" text-anchor="middle">10-12</text><text x="681.5" y="185" font-size="8.5" fill="#6b7683" text-anchor="middle">10-14</text><text x="763.5" y="185" font-size="8.5" fill="#6b7683" text-anchor="middle">10-16</text><text x="845.5" y="185" font-size="8.5" fill="#6b7683" text-anchor="middle">10-20</text><text x="46" y="12" font-size="9" fill="#98a0ab">灰柱=净涨停数(剔ST,峰103) · 金线=1进2率(右满刻度52%)</text></svg><svg viewBox="0 0 880 182" style="width:100%;height:auto;display:block"><line x1="46" y1="88" x2="866" y2="88" stroke="#3a3f46"></line><rect x="55.8" y="88.0" width="21.3" height="3.8" rx="1.5" fill="#2f9e6e"></rect><rect x="96.8" y="88.0" width="21.3" height="10.8" rx="1.5" fill="#2f9e6e"></rect><rect x="137.8" y="88.0" width="21.3" height="42.6" rx="1.5" fill="#2f9e6e"></rect><rect x="178.8" y="88.0" width="21.3" height="8.4" rx="1.5" fill="#2f9e6e"></rect><text x="230.5" y="84" font-size="8" fill="#4a5666" text-anchor="middle">∅</text><rect x="260.8" y="85.4" width="21.3" height="2.6" rx="1.5" fill="#d64541"></rect><rect x="301.8" y="88.0" width="21.3" height="25.1" rx="1.5" fill="#