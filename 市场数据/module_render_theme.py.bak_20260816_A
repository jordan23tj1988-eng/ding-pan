# ============ 数据契约加载 ============
def load_body(d):
    """LLM 组件提取源: judgment_{d}.json bodies['theme']"""
    p = os.path.join(L, 'judgment_%s.json' % d)
    if not os.path.exists(p): return ''
    try:
        return json.load(open(p, encoding='utf-8'))['bodies']['theme']
    except Exception:
        return ''

def load_json(name, d=None):
    """按文件名+日期加载 JSON, 缺=返回 None(零编造: 渲染侧显示 —)"""
    fn = name if d is None else name % d
    p = os.path.join(L, fn)
    if not os.path.exists(p): return None
    try:
        return json.load(open(p, encoding='utf-8'))
    except Exception:
        return None

# ============ 通用 HTML 工具 ============
def _esc(s):
    return str(s).replace('&', '&amp;').replace('<', '&lt;').replace('>', '&gt;')

def _match_div(s, start):
    """返回从 start 处 <div 开始的配平 </div> 结束位置(容错)"""
    depth = 0
    for m in re.finditer(r'<div\b|</div>', s[start:]):
        if m.group() == '</div>':
            depth -= 1
            if depth == 0: return start + m.end()
        else:
            depth += 1
    return len(s)

def _h2_seg(body, start_kw, end_kw=None):
    """提取 h2 板块原文(含 h2 标题行), 逐字节保真; end_kw 缺=取到尾部"""
    i = body.find(start_kw)
    if i < 0: return ''
    j = body.find(end_kw, i) if end_kw else -1
    return body[i:j if j > 0 else len(body)]

def _pct(x, digits=0):
    """小数→百分数字符串; None→'—'"""
    if x is None: return '—'
    return ('%+.' + str(digits) + 'f%%') % (x * 100)

def _yn(b):
    """bool → ✓/✗ 徽章"""
    if b is None: return '<span class="mut">—</span>'
    return ('<b style="color:#e8c86a">✓</b>' if b else '<span class="mut">✗</span>')

def _tli_date(tli):
    m = re.search(r'<b>(\d\d-\d\d)</b>', tli)
    if m: return m.group(1)
    m = re.search(r'<b>(\d{4})(\d{2})(\d{2})</b>', tli)
    return ('%s-%s' % (m.group(2), m.group(3))) if m else ''

# ============ 机器区: 题材战场全貌(归位分布 + 对链条强度) ============
def r_mach_battle(d):
    """THEMEBATTLE 卡: 归位大方向分布(家数/最高连板/来源档) + 对链条强度画像 Top6
    唯一真源互证: 归位 Counter 家数 == 对链条题材线家数(哨兵核对项)"""
    gui = load_json('题材归位_%s.json', d)
    chain = load_json('涨停对链条_%s.json', d)
    if gui is None and chain is None:
        return ''
    rows = ''
    # --- 归位分布 ---
    mp = (gui or {}).get('映射') or {}
    cnt = Counter((v or {}).get('大方向', '未归位') for v in mp.values())
    src = Counter((v or {}).get('来源档', '?') for v in mp.values())
    # 对链条: 线→最高连板/早封占比/开板占比/强度画像
    lines = {}
    for ln in (chain or {}).get('题材线') or []:
        lines[ln.get('大方向')] = ln
    gui_rows = ''
    for name, n in cnt.most_common():
        ln = lines.get(name) or {}
        hi = ln.get('最高连板')
        hi_txt = ('%d板' % hi) if hi else '—'
        ratio_txt = ('早封%.0f%%' % (ln.get('早封占比', 0) * 100)) if ln.get('早封占比') is not None else ''
        gui_rows += ('<div class="trow"><div class="tr1"><span class="tnm">%s</span>'
                     '<span class="tct">%d只</span><span class="mut">最高%s</span>'
                     '<span class="mut">%s</span><div class="tbar"><i style="width:%d%%"></i></div>'
                     '</div></div>\n'
                     % (_esc(name), n, hi_txt, ratio_txt,
                        int(100.0 * n / max(max(cnt.values()), 1))))
    # --- 对链条强度画像 Top6 ---
    top = sorted((chain or {}).get('题材线') or [], key=lambda x: -(x.get('家数') or 0))[:6]
    img_rows = ''
    for ln in top:
        nm = ln.get('大方向', '—')
        zb = ln.get('开板占比')
        zb_txt = ('开板%.0f%%' % (zb * 100)) if zb is not None else '—'
        img = ln.get('强度画像') or ''
        img_txt = img[:120] + ('…' if len(img) > 120 else '')
        img_rows += ('<div class="trow"><div class="tr1"><span class="tnm">%s</span>'
                     '<span class="tct">%d只</span><span class="mut">高%s</span>'
                     '<span class="mut">%s</span><div class="tbar"><i style="width:%d%%"></i></div>'
                     '</div><div class="tds"><span class="mut">%s</span></div></div>\n'
                     % (_esc(nm), ln.get('家数') or 0, ('%d板' % (ln.get('最高连板') or 0)),
                        zb_txt, int(100.0 * (ln.get('家数') or 0) / max(top[0].get('家数') or 1, 1)),
                        _esc(img_txt)))
    ttl = (chain or {}).get('涨停总数')
    nline = (chain or {}).get('题材线数')
    head = ('<div class="card"><h3 style="margin:0 0 8px">题材战场全貌 <span class="hint">机器核对 · 归位唯一真源 vs 对链条互证</span></h3>'
            '<p style="margin:4px 0 8px" class="mut">归位映射 %d 只 · 来源档 A公告/B THS/C搭车: %s · 对链条: 涨停%d / 题材线%d</p>'
            '<div class="tl">%s</div>'
            '<p style="margin:8px 0 4px"><b>对链条强度画像 Top6</b> <span class="hint">强度画像原文=子agent可引证据</span></p>'
            '<div class="tl">%s</div></div>\n'
            % (len(mp), '/'.join('%s%d' % (k, v) for k, v in sorted(src.items())),
               ttl or 0, nline or 0, gui_rows, img_rows))
    return '<!--THEMEBATTLE-->\n%s<!--/THEMEBATTLE-->\n' % head

